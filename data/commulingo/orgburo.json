 "eras": [
  {
   "id": "founding",
   "title": {
    "ko": "창설기",
    "en": "The founding years"
   },
   "period": "1919–1922",
   "intro": {
    "ko": "1919년 3월 제8차 당대회는 중앙위원회 안에 정치국·조직국·서기국을 두기로 하고, 조직국에 당의 조직 사업 전반을 맡겼다. 조직국은 위원 다섯 명으로 출발했고 위원 상당수가 정치국이나 서기국을 겸했다. 1921년 제10차 당대회 뒤에는 크레스틴스키·프레오브라젠스키·세레브랴코프가 물러나고 몰로토프가 들어왔다.",
    "en": "In March 1919 the 8th Congress set up a Politburo, an Orgburo and a Secretariat inside the Central Committee, and gave the Orgburo charge of the party’s organisational work as a whole. It started with five full members, many of whom also sat on the Politburo or the Secretariat. After the 10th Congress of 1921 Krestinsky, Preobrazhensky and Serebryakov left and Molotov came in."
   },
   "list": [
    "krestinsky",
    "mikhail-vladimirsky",
    "sverdlov",
    "alexander-beloborodov",
    "leonid-serebryakov",
    "matvei-muranov",
    "stalin",
    "stasova",
    "dzerzhinsky",
    "kamenev",
    "christian-rakovsky",
    "kalinin",
    "trotsky",
    "preobrazhensky",
    "rykov",
    "tomsky",
    "emelyan-yaroslavsky",
    "molotov",
    "nikolai-komarov",
    "rudzutak",
    "vasily-mikhailov",
    "ivan-kutuzov",
    "pyotr-zalutsky",
    "vasily-shmidt",
    "ivan-tuntul"
   ]
  },
  {
   "id": "twenties",
   "title": {
    "ko": "서기장 체제와 조직국의 확대",
    "en": "The General Secretary and a larger Orgburo"
   },
   "period": "1922–1930",
   "intro": {
    "ko": "1922년 4월 스탈린이 서기장이 된 뒤 조직국은 서기국과 함께 당 간부 배치를 관장했다. 1924년부터 위원이 열 명을 넘었고, 반대파에 선 예브도키모프와 우글라노프는 임기 중에 해임되었다.",
    "en": "After Stalin became General Secretary in April 1922, the Orgburo ran the placement of party cadres together with the Secretariat. From 1924 it had more than ten full members, and Evdokimov and Uglanov, who sided with the oppositions, were removed in mid-term."
   },
   "list": [
    "andrei-andreyev",
    "isaak-zelensky",
    "kuibyshev",
    "bukharin",
    "ivan-korotkov",
    "zinoviev",
    "alexander-dogadov",
    "alexander-smirnov",
    "andrei-bubnov",
