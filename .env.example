NODE_ENV=production
PORT=3000
CHAT_API_URL=http://host.docker.internal:8000
SESSION_SECRET=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true
LENINBOT_ADMIN_KEY=

# Admin IP allowlist (Tailscale IPs). Comma-separated. Empty = allow all.
ADMIN_ALLOWED_IPS=

# WebAuthn / Passkey config. RP_ID must be the base domain (no scheme, no port).
# RP_ORIGIN may be a comma-separated list (e.g. prod + localhost for dev).
RP_ID=cyber-lenin.com
RP_ORIGIN=https://cyber-lenin.com
RP_NAME=Cyber-Lenin
