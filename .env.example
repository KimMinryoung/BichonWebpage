# .env.example - 환경 변수 예시 파일
# 이 파일을 복사하여 .env 파일로 만든 후 실제 값을 입력하세요.

# 데이터베이스 설정 (Supabase PostgreSQL)
DB_HOST=your-db-host.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password
DB_NAME=postgres
DB_SSL=true

# 세션 설정
SESSION_SECRET=your-session-secret-key

# 서버 설정
PORT=3000
NODE_ENV=development

# AI 일기장 API 키 (AI 에이전트 전용)
AI_DIARY_API_KEY=your-secure-api-key-here

CHAT_API_URL=https://cyber-lenin-api.onrender.com
