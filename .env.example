NODE_ENV=production
PORT=3000
ASSET_VERSION=
CHAT_API_URL=http://host.docker.internal:8000
SESSION_SECRET=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true
REDIS_URL=redis://127.0.0.1:6379
LENINBOT_ADMIN_KEY=
WEBCHAT_PROXY_SECRET=

# Admin IP allowlist (Tailscale IPs). Comma-separated. Empty = allow all.
ADMIN_ALLOWED_IPS=

# WebAuthn / Passkey config. RP_ID must be the base domain (no scheme, no port).
# RP_ORIGIN may be a comma-separated list (e.g. prod + localhost for dev).
RP_ID=cyber-lenin.com
RP_ORIGIN=https://cyber-lenin.com
RP_NAME=Cyber-Lenin

# Rate limits. Defaults are conservative and can be tuned without code changes.
RATE_LIMIT_WEBAUTHN_WINDOW_MS=900000
RATE_LIMIT_WEBAUTHN_MAX=30
RATE_LIMIT_SIGNUP_WINDOW_MS=3600000
RATE_LIMIT_SIGNUP_MAX=10
RATE_LIMIT_CHAT_WINDOW_MS=60000
RATE_LIMIT_CHAT_MAX=60
RATE_LIMIT_ADMIN_API_WINDOW_MS=60000
RATE_LIMIT_ADMIN_API_MAX=120

# Tuning knobs with code defaults (all optional).
# FINGERPRINT_CACHE_MS=60000          # passkey fingerprint cache per chat session
# FEED_CACHE_TTL_SECONDS=600          # sitemap/rss/atom XML Redis cache
# REPORT_MENTIONS_REFRESH_MS=600000   # report→CommuLingo mention index rebuild
# COMMULINGO_UPDATES_CACHE_MS=60000   # homepage recent-dictionary items memo
# COMMULINGO_PEOPLE_REFRESH_MS=60000  # dictionary snapshot stores (also *_TERMS_, *_HISTORY_EVENTS_,
# COMMULINGO_TERMS_CACHE_MS=60000     #   *_TERM_CATEGORIES_, *_LINK_BLOCKLIST_ CACHE_MS)
# COMMULINGO_PEOPLE_SNAPSHOT=data/commulingo/people-snapshot.json   # and the matching *_SNAPSHOT paths
# DB_POOL_MAX=15 DB_POOL_MIN=2 DB_IDLE_TIMEOUT_MS=300000 DB_CONNECT_TIMEOUT_MS=3000 DB_STATEMENT_TIMEOUT_MS=60000
# DB_APPLICATION_NAME=leninbot-frontend  DB_LOG_CONNECTIONS=false
# ADMIN_RP_ID / ADMIN_RP_ORIGIN / ADMIN_RP_NAME, USER_RP_ID / USER_RP_ORIGIN / USER_RP_NAME  # per-RP passkey config
# SITE_ORIGIN=https://cyber-lenin.com
# WRITER_API_URL / EMAIL_API_URL / A2A_API_URL  # backend proxies besides CHAT_API_URL
# DEV_MODE=1                          # disables view/static caching (scripts/dev-preview sets it)
