# Environment variables (.env.example is tracked; backups like .env.bak-* hold credentials)
.env
.env.bak*

# Database setup (contains credentials)
setup.sql

# Dependencies
node_modules/

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# LLM Assistant — skills are shared with the repo; settings.local.json stays local
.claude/*
!.claude/skills/
!.claude/settings.json

# temp files for dev
temp_dev/

# CommuLingo generated artifacts (regenerated from source; not tracked)
data/commulingo/generated/

# CommuLingo people snapshot (rebuilt from the DB at runtime; on-disk cache/backup)
data/commulingo/people-snapshot.json
data/commulingo/people-snapshot.json.tmp

# CommuLingo history-events snapshot (same pattern as the people snapshot)
data/commulingo/history-events-snapshot.json
data/commulingo/history-events-snapshot.json.tmp

# CommuLingo glossary snapshot (same pattern as the people snapshot)
data/commulingo/terms-snapshot.json
data/commulingo/terms-snapshot.json.tmp

# CommuLingo glossary category registry snapshot (same pattern)
data/commulingo/term-categories-snapshot.json
data/commulingo/term-categories-snapshot.json.tmp
data/commulingo/term-regions-snapshot.json
data/commulingo/term-regions-snapshot.json.tmp

# CommuLingo link blocklist snapshot (same pattern)
data/commulingo/link-blocklist-snapshot.json
data/commulingo/link-blocklist-snapshot.json.tmp

# 번역 원본 아카이브 (저장한 웹페이지 전문). 저작권이 살아 있는 도서가 대부분이라
# 리포에 넣지 않는다. leninbot 쪽 번역 스펙이 절대 경로로 참조하고 sha256으로
# 고정하므로, 파일은 디스크에만 있으면 된다.
docs/*.html

# Bulk-translation glossary dump (regenerated from the DB by extract_glossary.py)
scripts/bulk-translate/glossary-db.json
__pycache__/

# CommuLingo work products are records of DB writes, not code: data-only SQL
# (content edits, no DDL) and its backups, batch specs/build scripts and
# link-review files. They live in R2 (R2_BUCKET under work/, uploaded with
# scripts/archive-work-r2.js), not in git. Files already tracked here stay
# tracked (test fixtures, event-control sources); a new file a test or the app
# needs must be added with `git add -f`. Schema migrations stay tracked in
# scripts/migrations/.
scripts/migrations/data/
scripts/content/
scripts/reviews/

# Automatic-link review cache (PostgreSQL is authoritative)
data/commulingo/link-reviews-snapshot.json
data/commulingo/link-reviews-snapshot.json.tmp

# Persistent derived report render cache
data/cache/

# Raw fetched sources for the French translation drafts (PDF/HTML dumps, ~36MB)
dev_docs/commulingo-french-translations-20260913/sources/
data/commulingo/docs/.*.tmp
# CommuLingo reference documents live in the DB (commulingo_docs, migration
# 339); the server keeps a snapshot and a content-addressed body cache. The
# docs/ directory is now only a scratch area for exports and the archival
# translation assembler; its README (authoring rules) stays tracked.
data/commulingo/docs-snapshot.json
data/commulingo/docs-snapshot.json.tmp
data/commulingo/docs-cache/
data/commulingo/docs/*
!data/commulingo/docs/README.md
# CommuLingo data documents (activity catalog, rosters, event-control,
# genealogy) live in the DB (commulingo_data_documents, migration 341). The
# snapshot is the server's cache; activity-catalog.json is written from it
# for leninbot, which reads that path.
data/commulingo/data-documents-snapshot.json
data/commulingo/data-documents-snapshot.json.tmp
data/commulingo/activity-catalog.json
data/commulingo/activity-catalog.json.*.tmp
data/commulingo/politburo.json
data/commulingo/secretariat.json
data/commulingo/orgburo.json
data/commulingo/event-control/
data/commulingo/genealogy/

.css-releases/
.app-releases/
