# Environment variables (.env.example is tracked; backups like .env.bak-* hold credentials)
.env
.env.bak*

# Database setup (contains credentials)
setup.sql

# Dependencies
node_modules/

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# LLM Assistant — skills are shared with the repo; settings.local.json stays local
.claude/*
!.claude/skills/

# temp files for dev
temp_dev/

# CommuLingo generated artifacts (regenerated from source; not tracked)
data/commulingo/generated/

# CommuLingo people snapshot (rebuilt from the DB at runtime; on-disk cache/backup)
data/commulingo/people-snapshot.json
data/commulingo/people-snapshot.json.tmp

# CommuLingo history-events snapshot (same pattern as the people snapshot)
data/commulingo/history-events-snapshot.json
data/commulingo/history-events-snapshot.json.tmp

# CommuLingo glossary snapshot (same pattern as the people snapshot)
data/commulingo/terms-snapshot.json
data/commulingo/terms-snapshot.json.tmp

# CommuLingo glossary category registry snapshot (same pattern)
data/commulingo/term-categories-snapshot.json
data/commulingo/term-categories-snapshot.json.tmp

# CommuLingo link blocklist snapshot (same pattern)
data/commulingo/link-blocklist-snapshot.json
data/commulingo/link-blocklist-snapshot.json.tmp

# 번역 원본 아카이브 (저장한 웹페이지 전문). 저작권이 살아 있는 도서가 대부분이라
# 리포에 넣지 않는다. leninbot 쪽 번역 스펙이 절대 경로로 참조하고 sha256으로
# 고정하므로, 파일은 디스크에만 있으면 된다.
docs/*.html
