# Environment variables
.env

# Database setup (contains credentials)
setup.sql

# Dependencies
node_modules/

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# LLM Assistant
.claude/

# temp files for dev
temp_dev/

# CommuLingo generated artifacts (regenerated from source; not tracked)
data/commulingo/generated/

# CommuLingo people snapshot (rebuilt from the DB at runtime; on-disk cache/backup)
data/commulingo/people-snapshot.json
data/commulingo/people-snapshot.json.tmp

# CommuLingo history-events snapshot (same pattern as the people snapshot)
data/commulingo/history-events-snapshot.json
data/commulingo/history-events-snapshot.json.tmp

# CommuLingo glossary snapshot (same pattern as the people snapshot)
data/commulingo/terms-snapshot.json
data/commulingo/terms-snapshot.json.tmp
