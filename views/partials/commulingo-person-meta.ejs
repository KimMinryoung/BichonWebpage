<%
var fateIcons = {
    executed: '✕', assassinated: '✕', murdered: '✕', killed: '✕', suicide: '✕',
    deposed: '↓', exile: '→', natural: '○'
};
var badge = person.badgeActivity || person.primaryActivity;
%>
    <div class="commu-person-meta">
        <% if (badge && badge.affiliationLabel) { %>
        <% if (badge.affiliationId) { %><a class="commu-person-affiliation" href="<%= badge.href %>" onclick="event.stopPropagation()"><% } else { %><span class="commu-person-affiliation"><% } %>
            <% if (badge.affiliationIcon) { %><%- roleIconSvg(badge.affiliationIcon) %><% } %>
            <%= badge.affiliationLabel %>
        <% if (badge.affiliationId) { %></a><% } else { %></span><% } %>
        <% } %>
        <%- include('commulingo-person-position', { person: person, showOtherPositions: typeof showOtherPositions !== 'undefined' && showOtherPositions }) %>
        <span class="commu-person-years">
            <% if (typeof flagImg === 'function') { %>
            <% if (person.citizenship) { %><%- flagImg(person.citizenship.code, person.citizenship.label, strings.commuLingoViews.personCard.citizenship, personFlagHref('citizenship', person.citizenship.code)) %><% } %>
            <% if (person.origin) { %><%- flagImg(person.origin.code, person.origin.label, strings.commuLingoViews.personCard.nationalBackground, personFlagHref('nationalOrigin', person.origin.code)) %><% } %>
            <% } %>
            <%= person.years %>
        </span>
        <% if (person.fateLabel) { %>
        <span class="commu-fate is-<%= person.fateKind %>"><%= fateIcons[person.fateKind] || '' %> <%= person.fateLabel %></span>
        <% } %>
    </div>
