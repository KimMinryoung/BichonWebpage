<%
/* The integrated search box (routes/search.js): the shared search field and
   the green submit, inside a GET form that targets /search or
   /commulingo/search (partials/site-search-form). Args: value, placeholder,
   autofocus (optional). */
var boxValue = typeof value === 'string' ? value : '';
%>
<div class="site-search-box">
    <%- include('search-field', { field: {
        name: 'q', value: boxValue, placeholder: placeholder, label: strings.search.title,
        clearLabel: strings.search.clear, autofocus: typeof autofocus !== 'undefined' && autofocus } }) %>
    <button type="submit" class="site-search-submit"><%= strings.search.submit %></button>
</div>
