<%
/* The context bar that opens each game page, the games' cousin of
   commulingo-crumb.ejs: the same bordered row below the site menu, with the
   way back to the catalogue. It replaces the bare "← 게임 선택" text link that
   used to sit alone above the heading on a line it did not fill.

   Params:
     current — label of this game; closes the trail as text, not a link. */
var crumbCurrent = typeof current !== 'undefined' ? current : '';
%>
<nav class="ui-crumb games-crumb" aria-label="현재 위치">
  <ol class="ui-crumb-trail games-crumb-trail">
    <li class="ui-crumb-item games-crumb-item"><a class="ui-crumb-link games-crumb-link games-crumb-home" href="/games/"><%- include('menu-icon', { icon: 'game', iconClass: 'games-crumb-icon' }) %><span>게임</span></a></li>
    <li class="ui-crumb-item games-crumb-item"><span class="ui-crumb-sep games-crumb-sep" aria-hidden="true">›</span><span class="ui-crumb-current games-crumb-current" aria-current="page"><%= crumbCurrent %></span></li>
  </ol>
</nav>
