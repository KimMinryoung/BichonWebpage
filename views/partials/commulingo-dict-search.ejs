<div class="commu-dict-search" data-commu-dict-search data-target="<%= target %>"
    data-result-one="<%= resultOne %>" data-result-many="<%= resultMany %>"
    data-result-empty="<%= emptyLabel %>">
    <div class="commu-people-search">
        <span class="commu-people-search-icon" aria-hidden="true"><%- roleIconSvg('search') %></span>
        <input type="search" class="commu-people-search-input" data-commu-dict-search-input
            value="<%= typeof searchValue === 'string' ? searchValue : '' %>"
            placeholder="<%= placeholder %>" autocomplete="off" spellcheck="false"
            aria-label="<%= ariaLabel %>">
        <span class="commu-dict-search-count" data-commu-dict-search-count aria-hidden="true" hidden></span>
        <button type="button" class="commu-people-search-clear" data-commu-dict-search-clear
            aria-label="<%= clearLabel %>" hidden><%- roleIconSvg('x') %></button>
    </div>
    <p class="commu-dict-search-status<%= typeof periodStatus === 'string' && periodStatus ? ' is-period' : '' %>" data-commu-dict-search-status
        role="status" aria-live="polite"<%- typeof periodStatus === 'string' && periodStatus ? '' : ' hidden' %>><%= typeof periodStatus === 'string' ? periodStatus : '' %></p>
</div>
