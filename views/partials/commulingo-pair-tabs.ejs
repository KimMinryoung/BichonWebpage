<%
/* Switcher between the two halves of one subject — the glossary entry and the
   history entry — when both exist. Reuses the dictionary switcher's look, since
   it is the same gesture one level down. `activePanel` is 'term' or 'event';
   the labels carry the dictionary each panel comes from, so it is clear the tab
   is not a section of one entry but the other entry.

   Both panels are already in the page, so switching is a class change, not a
   navigation. The inactive tab is also a real link to the counterpart's URL, so
   the page works without JavaScript and each half keeps its own address. */
var pairTabs = [
    { key: 'term', href: '/commulingo/terms/' + encodeURIComponent(pairTermId),
      label: strings.commuLingoViews.pairTabs.glossary, sub: strings.commuLingoViews.pairTabs.concept,
      backHref: '/commulingo/terms', crumb: strings.commuLingoViews.pairTabs.glossary,
      leaf: pairTermLabel },
    { key: 'event', href: '/commulingo/events/' + encodeURIComponent(pairEventId),
      label: strings.commuLingoViews.pairTabs.historicalEvent, sub: strings.commuLingoViews.pairTabs.narrative,
      // The tab names one entry, the crumb names the shelf it came from.
      backHref: '/commulingo/events', crumb: strings.commuLingoViews.pairTabs.historicalEvents,
      leaf: pairEventLabel },
];
%>
<nav class="commu-dict-nav commu-pair-tabs" aria-label="<%= strings.commuLingoViews.pairTabs.twoEntriesOnThis %>" data-active="<%= activePanel %>">
    <% pairTabs.forEach(function(tab) { %>
    <a class="commu-dict-tab commu-pair-tab<%= activePanel === tab.key ? ' is-active' : '' %>"
       href="<%= tab.href %>" data-panel="<%= tab.key %>"
       data-back-href="<%= tab.backHref %>" data-back-label="<%= tab.label %>" data-back-crumb="<%= tab.crumb %>" data-back-leaf="<%= tab.leaf %>"<% if (activePanel === tab.key) { %> aria-current="page"<% } %>>
        <span><%= tab.sub %><small><%= tab.label %></small></span>
    </a>
    <% }) %>
</nav>
