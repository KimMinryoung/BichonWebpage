<%# Shared reference documents and reports for dictionary detail pages.
    A person's own writings (doc.authored, person pages only) come first under
    their own heading; the rest keep the plain heading unless writings precede
    them. %>
        <%
        var docs = relatedDocs || [];
        var ownDocs = docs.filter(function(doc) { return doc.authored; });
        var otherDocs = docs.filter(function(doc) { return !doc.authored; });
        var docGroups = [
            { id: 'authored-docs', heading: copy.authoredDocuments, docs: ownDocs },
            { id: 'related-docs', heading: ownDocs.length ? copy.relatedReferenceDocuments : copy.referenceDocuments, docs: otherDocs },
        ].filter(function(group) { return group.docs.length; });
        %>
        <% docGroups.forEach(function(group) { %>
        <section class="commu-person-detail-section commu-section-wide" aria-labelledby="<%= group.id %>">
            <h2 id="<%= group.id %>"><%= group.heading %></h2>
            <ul class="commu-link-list commu-related-doc-list" data-link-preview="button">
                <% group.docs.forEach(function(doc) { %>
                <li><a href="/commulingo/docs/<%= doc.id %>"><span><%= doc.kind %></span><strong><%= doc.title %></strong></a></li>
                <% }) %>
            </ul>
        </section>
        <% }) %>

        <% if (relatedReports && relatedReports.length) { %>
        <section class="commu-person-detail-section commu-section-wide" aria-labelledby="related-reports">
            <h2 id="related-reports"><%= copy.relatedReports %></h2>
            <ul class="commu-link-list">
                <% relatedReports.forEach(function(report) { %>
                <li><a href="<%= report.href %>"><span><%= report.dateLabel || (copy.report) %></span><strong><%= report.title %></strong></a></li>
                <% }) %>
            </ul>
        </section>
        <% } %>
