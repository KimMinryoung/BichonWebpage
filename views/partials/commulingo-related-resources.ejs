<%# Shared reference documents and reports for dictionary detail pages. %>
        <% if (relatedDocs && relatedDocs.length) { %>
        <section class="commu-person-detail-section commu-related-reports" aria-labelledby="related-docs">
            <h2 id="related-docs"><%= copy.referenceDocuments %></h2>
            <ul class="commu-related-report-list commu-related-doc-list">
                <% relatedDocs.forEach(function(doc) { %>
                <li><a href="/commulingo/docs/<%= doc.id %>"><span><%= doc.kind %></span><strong><%= doc.title %></strong></a></li>
                <% }) %>
            </ul>
        </section>
        <% } %>

        <% if (relatedReports && relatedReports.length) { %>
        <section class="commu-person-detail-section commu-related-reports" aria-labelledby="related-reports">
            <h2 id="related-reports"><%= copy.relatedReports %></h2>
            <ul class="commu-related-report-list">
                <% relatedReports.forEach(function(report) { %>
                <li><a href="<%= report.href %>"><span><%= report.dateLabel || (copy.report) %></span><strong><%= report.title %></strong></a></li>
                <% }) %>
            </ul>
        </section>
        <% } %>
