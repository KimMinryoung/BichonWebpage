<% const text = value => typeof value === 'string' ? value : (value && (value[lang] || value.ko || value.en)) || ''; const s = strings.commuLingo; %>
<% bookGroups.forEach(group => { %>
<section class="commu-book-group">
    <div class="commu-book-group-head"><h3 class="commu-book-group-title"><%= group.label %></h3></div>
    <div class="commulingo-books">
        <% group.books.forEach(book => {
            let meta = (book.chapterCount || 0) + ' ' + (lang === 'en' ? 'Chapters' : '챕터');
            let mode = '';
            if (book.format === 'decision-history') {
                meta = (s.decisionSimLabel || (lang === 'en' ? 'Decision simulation' : '결정 시뮬레이션')) + (lang === 'en' ? ' · ' + (book.episodeCount || 0) + ' turning points' : ' · 갈림길 ' + (book.episodeCount || 0) + '개');
                mode = s.decideMode || (lang === 'en' ? 'Decide & learn' : '선택하며 학습');
            } else if (book.format === 'concept-graph') {
                meta = (s.conceptMapLabel || (lang === 'en' ? 'Interactive concept map' : '인터랙티브 개념지도')) + (lang === 'en' ? ' · ' + (book.nodeCount || 0) + ' nodes' : ' · 노드 ' + (book.nodeCount || 0) + '개');
                mode = s.exploreMode || (lang === 'en' ? 'Tap to explore' : '클릭하며 탐색');
            }
        %>
        <a class="commu-book-card" data-book-id="<%= book.id %>" href="/commulingo/book/<%= encodeURIComponent(book.id) %>">
            <div class="commu-book-card-body">
                <% if (text(book.badge)) { %><span class="commu-book-badge"><%= text(book.badge) %></span><% } %>
                <h3><%= text(book.title) %></h3>
                <p class="commu-book-desc"><%= text(book.description) %></p>
                <p class="commu-book-meta"><%= meta %></p>
            </div>
            <div class="commu-book-progress">
                <span class="commu-book-progress-label"><%= mode || s.bookProgressEmpty || (lang === 'en' ? 'Not started yet' : '아직 시작하지 않음') %></span>
                <% if (!mode) { %><span class="commu-book-progress-track"><span></span></span><% } %>
            </div>
        </a>
        <% }) %>
    </div>
</section>
<% }) %>
