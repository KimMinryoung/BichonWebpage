<%# Detail page → the course scenes and drill decks that quiz this entry. %>
        <% var practiceScenes = typeof scenes !== 'undefined' && scenes ? scenes : []; %>
        <% if (practiceScenes.length || (decks && decks.length)) { %>
        <section class="commu-person-detail-section commu-section-wide commu-related-reports" aria-labelledby="practice-links">
            <h2 id="practice-links"><%= strings.commuLingoViews.practice.heading %></h2>
            <ul class="commu-related-report-list commu-practice-list">
                <% practiceScenes.forEach(function(scene) { %>
                <li><a href="/commulingo/book/<%= scene.bookId %>#<%= scene.episodeId %>"><span><%= strings.commuLingoViews.practice.course %> · <%= scene.bookTitle %></span><strong><%= scene.title %></strong></a></li>
                <% }) %>
                <% (decks || []).forEach(function(deck) { %>
                <li><a href="/commulingo/drill/<%= deck.id %>"><span><% if (deck.kind === 'quiz') { %><%= strings.commuLingoViews.practice.quiz %> · <% } %><%= deck.group %></span><strong><%= deck.title %></strong></a></li>
                <% }) %>
            </ul>
        </section>
        <% } %>
