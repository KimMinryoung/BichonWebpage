<%# Shared office/roster overview. Locals: title, range, description, peopleHref. %>
<header class="ui-card commu-office-head">
    <<%= peopleHref ? 'a' : 'div' %> class="commu-office-head-row"<% if (peopleHref) { %> href="<%= peopleHref %>"<% } %>>
        <div class="commu-office-head-title">
            <% if (range) { %><span class="commu-office-range"><%= range %></span><% } %>
            <h1><%= title %></h1>
        </div>
        <% if (peopleHref) { %><span class="commu-office-head-link"><%= lang === 'en' ? 'People →' : '인물 목록 →' %></span><% } %>
    </<%= peopleHref ? 'a' : 'div' %>>
    <% if (description) { %><p class="commu-office-head-description"><%= description %></p><% } %>
</header>
