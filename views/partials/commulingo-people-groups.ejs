<%
// Standalone groups sit outside the Soviet/Russian era sequence and
// render at the end under their own section heading.
//
// This fragment is ~8MB of markup built from 1200 cards x 3 linkify passes,
// so routes/commulingo.js renders it once per people-data refresh per
// language (peopleGroupsHtml memo) instead of per request.
var standaloneGroupIds = ['international-revolutionary'];
var orderedGroups = groups.filter(function(g) { return standaloneGroupIds.indexOf(g.id) === -1; })
    .concat(groups.filter(function(g) { return standaloneGroupIds.indexOf(g.id) !== -1; }));
var standaloneHeadPrinted = false;
%>
<% orderedGroups.forEach(function(group) { %>
<% if (!standaloneHeadPrinted && standaloneGroupIds.indexOf(group.id) !== -1) { standaloneHeadPrinted = true; %>
<h2 class="commu-people-standalone-head"><%= en ? 'Revolutionaries beyond the Soviet Union' : '소련 밖의 혁명가들' %></h2>
<% } %>
<details class="commu-people-group is-<%= group.id %>">
    <summary class="commu-people-group-head">
        <span class="commu-people-range"><%= group.range %></span>
        <h2><%= group.title %> <span class="commu-people-group-count"><%= group.people.length %><%= en ? '' : '명' %></span></h2>
        <p><%= group.blurb %></p>
    </summary>
    <div class="commu-people-grid">
        <% group.people.forEach(function(person) { %>
        <%- include('./commulingo-person-card', { person: person, groupId: group.id, en: en, roleIconSvg: roleIconSvg, roleHubHref: roleHubHref, flagImg: flagImg }) %>
        <% }) %>
    </div>
</details>
<% }) %>
