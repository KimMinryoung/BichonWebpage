<%
/* The result groups of the integrated search (services/site-search.js): the
   search page and the instant results (routes/search.js suggest: the toolbar
   dialog, the front pages' dropdowns, the search page as one types) draw the
   same markup. The words searched for are marked (utils/text-search.js
   highlightTerms). Args: result, anchors (optional; the server-drawn search
   page gives each group an id, the target of the courses "more" link). */
var s = strings.search;
var q = result.query;
var hl = function(text) { return highlightTerms(text, result.terms || []); };
%>
<% if (result.failed.length) { %>
<p class="site-search-status" role="status"><%= s.failed.replace('{sections}', result.failed.map(function(key) { return s.sections[key]; }).join(', ')) %></p>
<% } %>
<% if (!result.sections.length) { %>
<p class="site-search-status site-search-empty"><%= s.empty.replace('{q}', q) %></p>
<% } %>
<% result.sections.forEach(function(section) { %>
<section class="site-search-group"<% if (typeof anchors !== 'undefined' && anchors) { %> id="search-<%= section.key %>"<% } %> aria-label="<%= s.sections[section.key] %>">
    <% var head = s.sections[section.key]; %>
    <% if (section.moreHref) { %>
    <a class="site-search-head" href="<%= section.moreHref %>">
        <h2><%= head %></h2>
        <span class="site-search-more"><%= s.more.replace('{n}', section.total) %></span>
    </a>
    <% } else { %>
    <div class="site-search-head">
        <h2><%= head %></h2>
        <span class="site-search-count"><%= s.count.replace('{n}', section.total) %></span>
    </div>
    <% } %>
    <ul class="site-search-list">
        <% section.items.forEach(function(item) {
            var meta = item.chapterNumber
                ? [item.meta, s.chapter.replace('{n}', item.chapterNumber)].join(' · ')
                : item.meta; %>
        <li><a class="site-search-row" href="<%= item.href %>">
            <strong class="site-search-title"><%- hl(item.title) %></strong>
            <% if (meta || item.excerpt) { %><span class="site-search-sub">
                <% if (meta) { %><span class="site-search-meta"><%- hl(meta) %></span><% } %>
                <% if (item.excerpt) { %><span class="site-search-excerpt"><%- hl(item.excerpt) %></span><% } %>
            </span><% } %>
        </a></li>
        <% }) %>
    </ul>
</section>
<% }) %>
