<%
// One group's card grid, served by /commulingo/people/cards?group=<id> and
// injected by the people-page shell when the group is opened. Rendered once
// per data refresh per language (peopleGroupCardsHtml memo), not per request.
%>
<% people.forEach(function(person) { %>
<%- include('./commulingo-person-card', { person: person, en: en, roleIconSvg: roleIconSvg, roleHubHref: roleHubHref, flagImg: flagImg, searchAlias: typeof searchAliases !== 'undefined' ? searchAliases[person.id] : '' }) %>
<% }) %>
