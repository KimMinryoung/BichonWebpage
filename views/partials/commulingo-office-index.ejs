<%# The office index: the Central Committee rosters, then the lineage pages
    grouped by commulingo_offices.section in the order of `sections`.
    Locals: bodies (availableBodies), offices (standardized offices, in
    sort_order), sectionTitles (strings.commuLingoViews.office.sections).
    Without sectionTitles (an office page's own rosters) the grid stands alone. %>
<% var sectionTitles = locals.sectionTitles;
   var sections = ['party', 'state', 'economy', 'international'];
   function card(href, icon, title, range, text) { %>
        <a class="commu-office-card commu-role-category-link" href="<%= href %>">
            <span class="commu-office-icon" aria-hidden="true"><%- roleIconSvg(icon) %></span>
            <span class="commu-role-category-copy">
                <h3><%= title %> <small class="commu-office-range"><%= range %></small></h3>
                <p><%= text %></p>
            </span>
            <span class="commu-role-category-arrow" aria-hidden="true">→</span>
        </a>
<% } %>
<% if (!sectionTitles) { %>
<div class="commu-office-grid">
<% bodies.forEach(function(body) { card(body.href, 'hammer-sickle', body.title, body.range, body.description); }) %>
</div>
<% } else { %>
<% if (bodies.length) { %>
<section class="commu-office-section" aria-labelledby="office-section-rosters">
    <h2 id="office-section-rosters"><%= sectionTitles.rosters %></h2>
    <div class="commu-office-grid">
    <% bodies.forEach(function(body) { card(body.href, 'hammer-sickle', body.title, body.range, body.description); }) %>
    </div>
</section>
<% } %>
<% sections.concat(['other']).forEach(function(section) {
    var items = offices.filter(function(office) {
        return section === 'other' ? sections.indexOf(office.section) === -1 : office.section === section;
    });
    if (!items.length) return; %>
<section class="commu-office-section" aria-labelledby="office-section-<%= section %>">
    <h2 id="office-section-<%= section %>"><%= sectionTitles[section] || '' %></h2>
    <div class="commu-office-grid">
    <% items.forEach(function(office) {
        card('/commulingo/offices/' + office.id, office.icon, office.title, office.range,
            office.tracks.filter(function(track) { return track.title; }).map(function(track) { return track.title; }).join(' · ') || office.blurb);
    }) %>
    </div>
</section>
<% }) %>
<% } %>
