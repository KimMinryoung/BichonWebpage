<a class="skip-link" href="#main-content"><%= lang === 'en' ? 'Skip to content' : '본문으로 건너뛰기' %></a>
<div class="home-toolbar">
    <a href="/" class="toolbar-logo"><%= strings.siteName %></a>
    <div class="toolbar-center">
        <a href="<%= currentUser ? '/auth/account' : '/auth/login' %>" class="toolbar-account-btn"<% if (currentUser) { %> title="<%= strings.userAuth.accountMenu %>"<% } %>>
            <svg class="account-icon" xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 aria-hidden="true">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5" />
            </svg>
            <% if (currentUser) { %>
                <span class="toolbar-account-name"><%= currentUser.username %></span>
            <% } else { %>
                <%= strings.userAuth.login %>
            <% } %>
        </a>
    </div>
    <div class="toolbar-right">
        <button type="button" class="theme-toggle" id="themeToggle" aria-pressed="false" aria-label="<%= lang === 'en' ? 'Switch to light mode' : '라이트 모드로 전환' %>">
            <span class="theme-toggle-icon" aria-hidden="true">&#x263E;</span>
        </button>
        <div class="lang-dropdown">
            <button type="button" class="lang-btn" id="langBtn" aria-haspopup="true" aria-expanded="false" aria-controls="langMenu">
                <svg class="lang-icon" xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M4 5h7" />
                    <path d="M9 3v2c0 4.418-2.239 8-5 8" />
                    <path d="M5 9c0 2.144 2.952 3.908 6.7 4" />
                    <path d="M12 20l4-9l4 9" />
                    <path d="M19.1 18h-6.2" />
                </svg>
                <%= lang === 'en' ? 'English' : 'Korean' %>
            </button>
            <div class="lang-menu" id="langMenu" aria-label="<%= lang === 'en' ? 'Language' : '언어' %>">
                <a href="#" data-lang="ko" class="<%= lang === 'ko' ? 'active' : '' %>">Korean</a>
                <a href="#" data-lang="en" class="<%= lang === 'en' ? 'active' : '' %>">English</a>
            </div>
        </div>
    </div>
</div>
<%
// Mark the nav link matching the current page. Each top-level menu owns a
// set of path prefixes (e.g. 글 covers reports/hub/diary/posts and their
// detail pages), so section pages keep their parent menu highlighted.
const _navPath = ((typeof pagePath !== 'undefined' && pagePath) ? pagePath : '').split('?')[0];
const _navCur = (prefixes) => {
    const hit = prefixes.some((href) => {
        const base = href.replace(/\/$/, '');
        return _navPath === href || _navPath === base
            || (base && _navPath.indexOf(base + '/') === 0);
    });
    return hit ? ' aria-current="page"' : '';
};
const _libraryPaths = ['/reports', '/hub', '/ai-diary', '/posts', '/post', '/novels', '/p'];
// The game stays out of the primary nav on purpose — it lives as a footer icon.
const _navItems = [
    { key: 'chat', href: '/chat', label: strings.nav.chat, cur: _navCur(['/chat']) },
    { key: 'commulingo', href: '/commulingo', label: strings.nav.commuLingo, cur: _navCur(['/commulingo']) },
    { key: 'library', href: '/reports', label: strings.nav.library, cur: _navCur(_libraryPaths) },
];
%>
<nav aria-label="<%= lang === 'en' ? 'Primary' : '주 메뉴' %>">
    <div class="nav-content">
        <div class="nav-links">
            <% _navItems.forEach(item => { %>
            <a href="<%= item.href %>"<%- item.cur %>><%- include('menu-icon', { icon: item.key }) %><%= item.label %></a>
            <% }) %>
        </div>
    </div>
</nav>
<% if (isAuthenticated) { %>
<nav class="admin-bar" aria-label="<%= lang === 'en' ? 'Administration' : '관리자 메뉴' %>">
    <div class="nav-content">
        <div class="nav-links">
            <a href="/admin"><%= strings.nav.dashboard %></a>
            <a href="/admin/posts"><%= strings.nav.posts %></a>
            <a href="/admin/users"><%= strings.admin.users %></a>
            <a href="/admin/passkeys"><%= strings.admin.passkeys %></a>
            <a href="/nonogram/"><%= strings.nav.game %></a>
            <form action="/admin/logout" method="POST" class="ui-inline-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="nav-logout-btn"><%= strings.nav.logout %></button>
            </form>
        </div>
    </div>
</nav>
<% } %>
<span class="skip-target" id="main-content" tabindex="-1"></span>
<script src="/js/nav.js?v=<%= assetVersion %>"></script>
