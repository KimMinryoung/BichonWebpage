<div class="home-toolbar">
    <a href="/" class="toolbar-logo"><%= strings.siteName %></a>
    <div class="toolbar-center">
        <% if (currentUser) { %>
            <a href="/auth/account" class="toolbar-link"><%= currentUser.username %> <%= strings.userAuth.accountMenu %></a>
        <% } else { %>
            <a href="/auth/login" class="toolbar-link"><%= strings.userAuth.login %></a>
        <% } %>
    </div>
    <div class="toolbar-right">
        <button type="button" class="theme-toggle" id="themeToggle" title="Toggle theme">&#x263E;</button>
        <div class="lang-dropdown">
            <button type="button" class="lang-btn" id="langBtn">
                <svg class="lang-icon" xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M4 5h7" />
                    <path d="M9 3v2c0 4.418-2.239 8-5 8" />
                    <path d="M5 9c0 2.144 2.952 3.908 6.7 4" />
                    <path d="M12 20l4-9l4 9" />
                    <path d="M19.1 18h-6.2" />
                </svg>
                <%= lang === 'en' ? 'English' : 'Korean' %>
            </button>
            <div class="lang-menu" id="langMenu">
                <a href="#" data-lang="ko" class="<%= lang === 'ko' ? 'active' : '' %>">Korean</a>
                <a href="#" data-lang="en" class="<%= lang === 'en' ? 'active' : '' %>">English</a>
            </div>
        </div>
    </div>
</div>
<nav>
    <div class="nav-content">
        <div class="nav-links">
            <a href="/chat"><%= strings.nav.chat %></a>
            <a href="/posts"><%= strings.nav.bichonPosts %></a>
            <a href="/reports"><span class="nav-responsive-label" data-short="<%= strings.nav.reportsShort %>"><%= strings.nav.reports %></span></a>
            <a href="/hub"><%= strings.nav.hub %></a>
            <a href="/ai-diary"><span class="nav-responsive-label" data-short="<%= strings.nav.diaryShort %>"><%= strings.nav.diary %></span></a>
            <a href="/nonogram/"><%= strings.nav.game %></a>
        </div>
    </div>
</nav>
<% if (isAuthenticated) { %>
<nav class="admin-bar">
    <div class="nav-content">
        <div class="nav-links">
            <a href="/admin"><%= strings.nav.dashboard %></a>
            <a href="/admin/posts"><%= strings.nav.posts %></a>
            <a href="/admin/passkeys"><%= strings.admin.passkeys %></a>
            <a href="/nonogram/"><%= strings.nav.game %></a>
            <form action="/admin/logout" method="POST" style="display:inline;margin:0;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="nav-logout-btn"><%= strings.nav.logout %></button>
            </form>
        </div>
    </div>
</nav>
<% } %>
<script src="/js/nav.js?v=<%= assetVersion %>"></script>
