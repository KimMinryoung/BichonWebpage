<%
/* Shared glyphs for the site menus (top nav + home cards + footer).
   Top-level `icon` keys: 'chat' | 'commulingo' | 'library' | 'game'.
   Sub-menu keys: 'quiz' | 'people' | 'events' | 'terms' | 'docs' (CommuLingo,
   matching the dictionary switcher icons) and 'reports' | 'hub' | 'diary' | 'posts'.
   `iconClass` (optional): CSS class for the svg, defaults to 'nav-icon'.

   The drawings are NOT kept here. They come from data/icons.js, the one glyph
   table, via res.locals.iconPaths, because six of these used to be duplicated
   by hand under a second name (quiz/circle-help, people/user, events/flag,
   terms/book-open, reports/chart, docs/landmark) and nothing held the copies
   together. */
var _menuIconClass = typeof iconClass !== 'undefined' ? iconClass : 'nav-icon';
%><svg class="<%= _menuIconClass %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><%- iconPaths(icon) %></svg>
