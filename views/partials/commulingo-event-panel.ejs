<%
/* The narrative half of an entry. Rendered on its own for an ordinary event,
   and as one of two tab panels when a glossary term covers the same subject.
   Locals: p (the panel object from buildEventPanel), en. */
%>
        <header class="commu-event-head">
            <span class="commu-event-period"><%= p.event.period %></span>
            <h1><%= p.event.title %></h1>
            <p class="commu-event-question"><%- p.event.questionHtml %></p>
            <p><%- p.event.summaryHtml %></p>
        </header>
<%
/* Reading order depends on whether the event has a body yet. With one, the
   article leads and the timeline becomes the reference table it is; without
   one, the timeline IS the page and has to stay at the top. */
var sections = p.event.bodySections || [];
%>
        <% if (sections.length >= 3) { %>
        <nav class="commu-event-toc" aria-label="<%= en ? 'Contents' : '차례' %>">
            <h2 class="commu-event-toc-head"><%= en ? 'Contents' : '차례' %></h2>
            <ol>
                <% sections.forEach(function(section) { %>
                <li><a href="#<%= section.id %>"><%= section.label %></a></li>
                <% }) %>
                <li><a href="#event-outcome"><%= en ? 'Consequences' : '결과' %></a></li>
                <li><a href="#event-timeline"><%= p.event.mapSvg ? (en ? 'Timeline & Map' : '연표와 지도') : (en ? 'Timeline' : '연표') %></a></li>
                <li><a href="#event-people"><%= en ? 'Related people' : '관련 인물' %></a></li>
            </ol>
        </nav>
        <% } %>
        <% if (p.event.bodyHtml) { %>
        <section class="commu-person-detail-section commu-event-body" aria-label="<%= en ? 'In depth' : '상세' %>">
            <div class="commu-person-markdown"><%- p.event.bodyHtml %></div>
        </section>
        <section class="commu-person-detail-section commu-event-outcome" aria-labelledby="event-outcome"><h2 id="event-outcome"><%= en ? 'Consequences' : '결과' %></h2><p><%- p.event.outcomeHtml %></p></section>
        <% } %>
        <section class="commu-person-detail-section commu-event-timeline" aria-labelledby="event-timeline">
            <h2 id="event-timeline"><%= p.event.mapSvg ? (en ? 'Timeline & Map' : '연표와 지도') : (en ? 'Timeline' : '연표') %></h2>
            <% if (p.event.mapSvg) { %>
            <figure class="commu-event-map commu-event-timeline-map"><%- p.event.mapSvg %></figure>
            <% } %>
            <ol class="commu-event-timeline-list"><% p.event.timeline.forEach(function(item) { %><li<% if (item.geoNum) { %> data-geo-num="<%= item.geoNum %>"<% } %>><span><% if (item.geoNum) { %><i class="commu-tl-geo-badge"><%= item.geoNum %></i><% } %><%= item.date %></span><div><strong><%= item.title %></strong><p><%- item.bodyHtml %></p></div></li><% }) %></ol>
        </section>
        <% if (!p.event.bodyHtml) { %>
        <section class="commu-person-detail-section commu-event-outcome" aria-labelledby="event-outcome"><h2 id="event-outcome"><%= en ? 'Consequences' : '결과' %></h2><p><%- p.event.outcomeHtml %></p></section>
        <% } %>
        <section class="commu-person-detail-section commu-event-people" aria-labelledby="event-people">
            <h2 id="event-people"><%= en ? 'Related people' : '관련 인물' %> <span class="commu-event-people-count"><%= p.event.people.length %><%= en ? '' : '명' %></span></h2>
            <% p.event.peopleGroups.forEach(function(group) { %>
            <div class="commu-event-people-group is-<%= group.kind %>">
                <h3 class="commu-event-people-group-head"><%= group.label %><span class="commu-event-people-group-count"><%= group.people.length %></span></h3>
                <div class="commu-event-people-grid"><% group.people.forEach(function(person) { %><a class="is-<%= person.kind %>" href="/commulingo/people/<%= person.id %>"><span class="commu-event-person-relation"><%= person.relation %></span><strong><%= person.name %></strong><small><%= person.years %></small><p><%= person.note %></p></a><% }) %></div>
            </div>
            <% }) %>
        </section>
        <% if (p.relatedTerms && p.relatedTerms.length) { %>
        <section class="commu-person-detail-section" aria-labelledby="event-terms">
            <h2 id="event-terms"><%= en ? 'Related terms' : '관련 용어' %></h2>
            <div class="commu-term-chips">
                <% p.relatedTerms.forEach(function(entry) { %>
                <a class="commu-term-chip" href="/commulingo/terms/<%= encodeURIComponent(entry.id) %>"><%= entry.term %></a>
                <% entry.children.forEach(function(child) { %>
                <a class="commu-term-chip is-child" href="/commulingo/terms/<%= encodeURIComponent(child.id) %>">└ <%= child.term %></a>
                <% }) %>
                <% }) %>
            </div>
        </section>
        <% } %>
        <%- include('commulingo-genealogy-links', { en: en, charts: p.genealogies, headword: p.event.title }) %>
        <% if (p.relatedDocs && p.relatedDocs.length) { %>
        <section class="commu-person-detail-section commu-related-reports" aria-labelledby="related-docs">
            <h2 id="related-docs"><%= en ? 'Reference documents' : '참고 문헌' %></h2>
            <ul class="commu-related-report-list commu-related-doc-list">
                <% p.relatedDocs.forEach(function(doc) { %>
                <li><a href="/commulingo/docs/<%= doc.id %>"><span><%= doc.kind %></span><strong><%= doc.title %></strong></a></li>
                <% }) %>
            </ul>
        </section>
        <% } %>
        <% if (p.relatedReports && p.relatedReports.length) { %>
        <section class="commu-person-detail-section commu-related-reports" aria-labelledby="related-reports">
            <h2 id="related-reports"><%= en ? 'Related reports' : '관련 보고서' %></h2>
            <ul class="commu-related-report-list">
                <% p.relatedReports.forEach(function(report) { %>
                <li><a href="<%= report.href %>"><span><%= report.dateLabel || (en ? 'Report' : '보고서') %></span><strong><%= report.title %></strong></a></li>
                <% }) %>
            </ul>
        </section>
        <% } %>
        <% if (p.event.sources.length) { %><p class="commu-event-sources"><%= en ? 'Sources:' : '출처:' %> <% p.event.sources.forEach(function(source, index) { %><% if (/^https?:\/\//.test(source)) { %><a href="<%= source %>" target="_blank" rel="noopener noreferrer"><%= en ? 'reference ' + (index + 1) : '자료 ' + (index + 1) %></a><% } else { %><span class="commu-event-source-text"><%= source %></span><% } %><% }) %></p><% } %>
