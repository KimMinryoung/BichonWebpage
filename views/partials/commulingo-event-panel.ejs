<%
/* The narrative half of an entry. Rendered on its own for an ordinary event,
   and as one of two tab panels when a glossary term covers the same subject.
   Locals: p (the panel object from buildEventPanel), en. */
%>
        <header class="commu-event-head">
            <span class="commu-event-period"><%= p.event.period %></span>
            <h1><%= p.event.title %></h1>
            <p class="commu-event-question"><%- p.event.questionHtml %></p>
            <p><%- p.event.summaryHtml %></p>
        </header>
<%
/* Reading order depends on whether the event has a body yet. With one, the
   article leads and the timeline becomes the reference table it is; without
   one, the timeline IS the page and has to stay at the top. */
var sections = p.event.bodySections || [];
%>
        <% if (p.event.relatedEvents && p.event.relatedEvents.length) {
            var relParent = p.event.relatedEvents.filter(function(e) { return e.kind === 'parent'; })[0];
            var relRows = p.event.relatedEvents.filter(function(e) { return e.kind !== 'parent'; });
            var relLabel = en ? 'Documents from this period' : '이 시기의 문서';
        %>
        <nav class="commu-event-relations" aria-label="<%= relLabel %>">
            <h2 class="commu-event-relations-head"><%= relLabel %></h2>
            <div class="commu-event-relations-box">
                <% if (relParent) { %>
                <a class="commu-event-relations-parent" href="/commulingo/events/<%= encodeURIComponent(relParent.id) %>"><span class="commu-event-relations-tag"><%= en ? 'Overview' : '상위 문서' %></span><strong class="commu-event-relations-title"><%= relParent.title %></strong><span class="commu-event-relations-period"><%= relParent.period %></span></a>
                <% } %>
                <% if (relRows.length) { %>
                <ol class="commu-event-relations-list">
                    <% relRows.forEach(function(entry) { %>
                    <% if (entry.kind === 'self') { %>
                    <li class="is-current" aria-current="page"><span class="commu-event-relations-title"><%= entry.title %></span><span class="commu-event-relations-tag"><%= en ? 'This page' : '현재 문서' %></span><span class="commu-event-relations-period"><%= entry.period %></span></li>
                    <% } else { %>
                    <li><a href="/commulingo/events/<%= encodeURIComponent(entry.id) %>"><span class="commu-event-relations-title"><%= entry.title %></span><% if (entry.kind === 'related') { %><span class="commu-event-relations-tag"><%= en ? 'Related' : '관련 문서' %></span><% } %><span class="commu-event-relations-period"><%= entry.period %></span></a></li>
                    <% } %>
                    <% }) %>
                </ol>
                <% } %>
            </div>
        </nav>
        <% } %>
        <% if (sections.length >= 3) { %>
        <nav class="commu-event-toc" aria-label="<%= strings.commuLingoViews.eventPanel.contents %>">
            <h2 class="commu-event-toc-head"><%= strings.commuLingoViews.eventPanel.contents %></h2>
            <ol>
                <% sections.forEach(function(section) { %>
                <li><a href="#<%= section.id %>"><%- section.flagsHtml || '' %><%= section.label %></a></li>
                <% }) %>
                <li><a href="#event-outcome"><%= strings.commuLingoViews.eventPanel.consequences %></a></li>
                <li><a href="#event-timeline"><%= p.event.mapSvg ? (strings.commuLingoViews.eventPanel.timelineMap) : (strings.commuLingoViews.eventPanel.timeline) %></a></li>
                <li><a href="#event-people"><%= strings.commuLingoViews.eventPanel.relatedPeople %></a></li>
            </ol>
        </nav>
        <% } %>
        <% if (p.event.bodyHtml) { %>
        <section class="commu-person-detail-section commu-event-body" aria-label="<%= strings.commuLingoViews.eventPanel.inDepth %>">
            <div class="commu-person-markdown"><%- p.event.bodyHtml %></div>
        </section>
        <section class="commu-person-detail-section commu-event-outcome" aria-labelledby="event-outcome"><h2 id="event-outcome"><%= strings.commuLingoViews.eventPanel.consequences %></h2><p><%- p.event.outcomeHtml %></p></section>
        <% } %>
        <section class="commu-person-detail-section commu-event-timeline" aria-labelledby="event-timeline">
            <h2 id="event-timeline"><%= p.event.mapSvg ? (strings.commuLingoViews.eventPanel.timelineMap) : (strings.commuLingoViews.eventPanel.timeline) %></h2>
            <% if (p.event.mapSvg) { %>
            <figure class="commu-event-map commu-event-timeline-map"><%- p.event.mapSvg %></figure>
            <% } %>
            <% if (p.event.hasCountryFilter) { %>
            <div class="commu-tl-filter" role="group" aria-label="<%= strings.commuLingoViews.eventPanel.byCountry %>" data-tl-filter>
                <button type="button" class="commu-tl-chip is-active" data-country="" aria-pressed="true"><%= strings.commuLingoViews.eventPanel.allCountries %></button>
                <% p.event.countryFilter.forEach(function(c) { %><button type="button" class="commu-tl-chip" data-country="<%= c.code %>" aria-pressed="false"><%- c.flagHtml %><%= c.label %></button><% }) %>
            </div>
            <% } %>
            <ol class="commu-event-timeline-list"><% p.event.timeline.forEach(function(item) { %><li<% if (item.geoNum) { %> data-geo-num="<%= item.geoNum %>"<% } %><% if (item.countries && item.countries.length) { %> data-countries="<%= item.countries.join(' ') %>"<% } %>><span><% if (item.geoNum) { %><i class="commu-tl-geo-badge"><%= item.geoNum %></i><% } %><%= item.date %><% if (item.flagsHtml) { %><span class="commu-tl-flags"><%- item.flagsHtml %></span><% } %></span><div><strong><%= item.title %></strong><p><%- item.bodyHtml %></p></div></li><% }) %></ol>
        </section>
        <% if (!p.event.bodyHtml) { %>
        <section class="commu-person-detail-section commu-event-outcome" aria-labelledby="event-outcome"><h2 id="event-outcome"><%= strings.commuLingoViews.eventPanel.consequences %></h2><p><%- p.event.outcomeHtml %></p></section>
        <% } %>
        <section class="commu-person-detail-section commu-event-people" aria-labelledby="event-people">
            <h2 id="event-people"><%= strings.commuLingoViews.eventPanel.relatedPeople %> <span class="commu-event-people-count"><%= p.event.people.length %><%= strings.commuLingoViews.eventPanel.text %></span></h2>
            <% p.event.peopleGroups.forEach(function(group) { %>
            <div class="commu-event-people-group is-<%= group.kind %>">
                <h3 class="commu-event-people-group-head"><%= group.label %><span class="commu-event-people-group-count"><%= group.people.length %></span></h3>
                <div class="commu-event-people-grid"><% group.people.forEach(function(person) { %><a class="is-<%= person.kind %>" href="/commulingo/people/<%= person.id %>"><span class="commu-event-person-relation"><%= person.relation %></span><strong><%= person.name %></strong><small><%= person.years %></small><p><%= person.note %></p></a><% }) %></div>
            </div>
            <% }) %>
        </section>
        <% if (p.relatedTerms && p.relatedTerms.length) { %>
        <section class="commu-person-detail-section" aria-labelledby="event-terms">
            <h2 id="event-terms"><%= strings.commuLingoViews.eventPanel.relatedTerms %></h2>
            <div class="commu-term-chips">
                <% p.relatedTerms.forEach(function(entry) { %>
                <a class="commu-term-chip" href="/commulingo/terms/<%= encodeURIComponent(entry.id) %>"><%= entry.term %></a>
                <% entry.children.forEach(function(child) { %>
                <a class="commu-term-chip is-child" href="/commulingo/terms/<%= encodeURIComponent(child.id) %>">└ <%= child.term %></a>
                <% }) %>
                <% }) %>
            </div>
        </section>
        <% } %>
        <%- include('commulingo-genealogy-links', { en: en, charts: p.genealogies, headword: p.event.title }) %>
        <% if (p.relatedDocs && p.relatedDocs.length) { %>
        <section class="commu-person-detail-section commu-related-reports" aria-labelledby="related-docs">
            <h2 id="related-docs"><%= strings.commuLingoViews.eventPanel.referenceDocuments %></h2>
            <ul class="commu-related-report-list commu-related-doc-list">
                <% p.relatedDocs.forEach(function(doc) { %>
                <li><a href="/commulingo/docs/<%= doc.id %>"><span><%= doc.kind %></span><strong><%= doc.title %></strong></a></li>
                <% }) %>
            </ul>
        </section>
        <% } %>
        <% if (p.relatedReports && p.relatedReports.length) { %>
        <section class="commu-person-detail-section commu-related-reports" aria-labelledby="related-reports">
            <h2 id="related-reports"><%= strings.commuLingoViews.eventPanel.relatedReports %></h2>
            <ul class="commu-related-report-list">
                <% p.relatedReports.forEach(function(report) { %>
                <li><a href="<%= report.href %>"><span><%= report.dateLabel || (strings.commuLingoViews.eventPanel.report) %></span><strong><%= report.title %></strong></a></li>
                <% }) %>
            </ul>
        </section>
        <% } %>
        <% if (p.event.sources.length) { %><p class="commu-event-sources"><%= strings.commuLingoViews.eventPanel.sources %> <% p.event.sources.forEach(function(source, index) { %><% if (/^https?:\/\//.test(source)) { %><a href="<%= source %>" target="_blank" rel="noopener noreferrer"><%= en ? 'reference ' + (index + 1) : '자료 ' + (index + 1) %></a><% } else { %><span class="commu-event-source-text"><%= source %></span><% } %><% }) %></p><% } %>
