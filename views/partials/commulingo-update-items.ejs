<ul class="commu-updates-list">
    <% items.forEach(item => { %>
        <li>
            <time datetime="<%= new Date(item.modified).toISOString() %>"><%= new Date(item.modified).toISOString().slice(0, 10) %></time>
            <a href="<%= item.href %>"><%= item.title %></a>
            <% if (item.summary) { %>
                <div class="commu-updates-excerpt"><%- truncateHtml(sanitize(item.summary), 200) %></div>
            <% } %>
        </li>
    <% }) %>
</ul>
