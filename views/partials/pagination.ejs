<%
var pages = [];
var startPage, endPage;
if (totalPages <= 7) {
    startPage = 1;
    endPage = totalPages;
} else {
    startPage = Math.max(1, currentPage - 2);
    endPage = Math.min(totalPages, currentPage + 2);
    if (endPage - startPage < 4) {
        if (startPage === 1) {
            endPage = Math.min(totalPages, startPage + 4);
        } else if (endPage === totalPages) {
            startPage = Math.max(1, endPage - 4);
        }
    }
}
for (var i = startPage; i <= endPage; i++) {
    pages.push(i);
}
var pagination = {
    pages: pages,
    showFirst: startPage > 1,
    showLast: endPage < totalPages,
    showPrev: currentPage > 1,
    showNext: currentPage < totalPages,
    hasPrevEllipsis: startPage > 2,
    hasNextEllipsis: endPage < totalPages - 1
};
%>
<div class="pagination">
    <% if (pagination.showPrev) { %>
        <a href="<%= baseUrl %><%= currentPage - 1 %>" class="btn btn-small">이전</a>
    <% } %>

    <% if (pagination.showFirst) { %>
        <a href="<%= baseUrl %>1" class="btn btn-small">1</a>
        <% if (pagination.hasPrevEllipsis) { %>
            <span class="pagination-ellipsis">...</span>
        <% } %>
    <% } %>

    <% pagination.pages.forEach(function(page) { %>
        <a href="<%= baseUrl %><%= page %>" class="btn btn-small<%= page === currentPage ? ' active' : '' %>"><%= page %></a>
    <% }); %>

    <% if (pagination.showLast) { %>
        <% if (pagination.hasNextEllipsis) { %>
            <span class="pagination-ellipsis">...</span>
        <% } %>
        <a href="<%= baseUrl %><%= totalPages %>" class="btn btn-small"><%= totalPages %></a>
    <% } %>

    <% if (pagination.showNext) { %>
        <a href="<%= baseUrl %><%= currentPage + 1 %>" class="btn btn-small">다음</a>
    <% } %>
</div>
