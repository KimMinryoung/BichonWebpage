<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<% const _path = (typeof pagePath !== 'undefined' && pagePath) ? pagePath : '/'; %>
<% const _isHome = _path === '/'; %>
<% const _title = _isHome
    ? (strings.siteSeoTitle || strings.siteName)
    : ((typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle + ' | ' + strings.siteName : strings.siteName); %>
<% const _desc = (typeof pageDescription !== 'undefined' && pageDescription) ? pageDescription : strings.siteDescription; %>
<% const _urlLang = (typeof urlLanguage !== 'undefined' && urlLanguage === 'en') ? 'en' : 'ko'; %>
<% const _hasEnglish = typeof hasEnglishVersion === 'undefined' ? true : Boolean(hasEnglishVersion); %>
<% const _canonicalLang = _urlLang === 'en' && _hasEnglish ? 'en' : 'ko'; %>
<% const _koUrl = siteOrigin + languageUrl(_path, 'ko'); %>
<% const _enUrl = siteOrigin + languageUrl(_path, 'en'); %>
<% const _url = (typeof canonicalUrl !== 'undefined' && canonicalUrl)
    ? canonicalUrl
    : (_canonicalLang === 'en' ? _enUrl : _koUrl); %>
<% const _baseRobots = (typeof robotsMeta !== 'undefined' && robotsMeta) ? robotsMeta : 'index, follow'; %>
<% const _robots = (typeof robotsMeta !== 'undefined' && robotsMeta)
    ? _baseRobots
    : (_urlLang === 'en' && !_hasEnglish ? 'noindex, follow' : _baseRobots); %>
<% const _ogType = (typeof ogType !== 'undefined' && ogType) ? ogType : 'website'; %>
<% const _section = _isHome ? 'home'
    : (_path.indexOf('/commulingo') === 0 ? 'commulingo'
    : (_path.indexOf('/chat') === 0 ? 'chat'
    : (/^\/(reports|hub|ai-diary|posts|post|novels|p)(\/|\?|$)/.test(_path) ? 'library'
    : (_path.indexOf('/auth') === 0 ? 'account'
    : (_path.indexOf('/admin') === 0 ? 'admin'
    : ((_path.indexOf('/nonogram') === 0 || _path.indexOf('/games') === 0) ? 'game' : 'general')))))); %>
<title><%= _title %></title>
<meta name="description" content="<%= _desc %>">
<link rel="canonical" href="<%= _url %>">
<meta name="robots" content="<%= _robots %>">
<% if (_hasEnglish && _robots.indexOf('index') === 0) { %>
<link rel="alternate" hreflang="ko" href="<%= _koUrl %>">
<link rel="alternate" hreflang="en" href="<%= _enUrl %>">
<link rel="alternate" hreflang="x-default" href="<%= _koUrl %>">
<% } %>
<link rel="preconnect" href="https://assets.cyber-lenin.com">
<link rel="icon" href="https://assets.cyber-lenin.com/favicon.ico" type="image/x-icon">
<link rel="apple-touch-icon" href="https://assets.cyber-lenin.com/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title="Cyber-Lenin RSS Feed" href="<%= languageUrl('/rss.xml', _urlLang) %>">
<link rel="alternate" type="application/atom+xml" title="Cyber-Lenin Atom Feed" href="<%= languageUrl('/atom.xml', _urlLang) %>">
<meta property="og:type" content="<%= _ogType %>">
<meta property="og:title" content="<%= _title %>">
<meta property="og:description" content="<%= _desc %>">
<meta property="og:url" content="<%= _url %>">
<meta property="og:site_name" content="<%= strings.siteName %>">
<meta property="og:image" content="https://assets.cyber-lenin.com/og-image.jpg">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= _title %>">
<meta name="twitter:description" content="<%= _desc %>">
<%# Font preloads removed on purpose: Pretendard is unicode-range sliced (the
    browser only knows which slices a page needs after CSS+text are seen) and
    font-display: swap paints text immediately in the fallback. %>
<%# Page-to-page speed: fetch a link's HTML when the pointer rests on it (or it
    is pressed), so the click finds the response already there. Only links in
    the page's own language: an /en/ response or a ?lang= link would set the
    language cookie as a side effect. Admin/auth/API links are never fetched. %>
<script type="speculationrules">
{"prefetch":[{"where":{"and":[
<% if (_urlLang === 'en') { %>{"href_matches":"/en/*"},<% } else { %>{"href_matches":"/*"},{"not":{"href_matches":"/en/*"}},{"not":{"href_matches":"/en"}},<% } %>
{"not":{"selector_matches":"[href*='lang='],[href*='/admin'],[href*='/auth'],[href*='/api/'],[href$='.md'],[href$='.xml'],[download],[target=_blank],[data-no-prefetch]"}}
]},"eagerness":"moderate"}]}
</script>
<% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
<script type="application/ld+json"><%- jsonLdScript(jsonLd) %></script>
<% } %>
<script>
(function(){
    var t = 'dark';
    try {
        t = localStorage.getItem('theme') || t;
    } catch (e) {}
    if (t !== 'light' && t !== 'dark') t = 'dark';
    document.documentElement.setAttribute('data-theme', t);
    document.documentElement.setAttribute('data-section', <%- JSON.stringify(_section) %>);
})();
</script>
<%# The common Hangul font is one fixed file, so a Korean page can start it
    with the HTML instead of after the CSS; it then usually arrives before the
    first layout, which is not done twice (fallback, then Pretendard). %>
<% if (_urlLang === 'ko') { %><link rel="preload" href="/fonts/pretendard/PretendardVariable.common.woff2" as="font" type="font/woff2" crossorigin><% } %>
<link rel="stylesheet" href="/css/pretendard-subset.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/palette.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/ui.css?v=<%= assetVersion %>">
<% const _extraCss = (typeof extraCss === 'undefined' || !extraCss) ? [] : (Array.isArray(extraCss) ? extraCss : [extraCss]); %>
<% _extraCss.forEach(function(stylesheet) { %>
<link rel="stylesheet" href="<%= stylesheet %>">
<% }); %>
