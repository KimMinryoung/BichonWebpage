<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle + ' - ' + strings.siteName : strings.siteName %></title>
<% const _desc = (typeof pageDescription !== 'undefined' && pageDescription) ? pageDescription : strings.siteDescription; %>
<% const _title = (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle + ' - ' + strings.siteName : strings.siteName; %>
<% const _url = 'https://cyber-lenin.com' + (typeof pagePath !== 'undefined' && pagePath ? pagePath : '/'); %>
<meta name="description" content="<%= _desc %>">
<link rel="canonical" href="<%= _url %>">
<meta name="robots" content="index, follow">
<link rel="icon" href="/img/favicon.png" type="image/png">
<link rel="alternate" type="application/atom+xml" title="Cyber-Lenin Feed" href="/atom.xml">
<meta property="og:type" content="website">
<meta property="og:title" content="<%= _title %>">
<meta property="og:description" content="<%= _desc %>">
<meta property="og:url" content="<%= _url %>">
<meta property="og:site_name" content="<%= strings.siteName %>">
<meta property="og:image" content="https://cyber-lenin.com/img/og-image.jpg">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= _title %>">
<meta name="twitter:description" content="<%= _desc %>">
<script>
(function(){var t=localStorage.getItem('theme')||(matchMedia('(prefers-color-scheme:light)').matches?'light':'dark');document.documentElement.setAttribute('data-theme',t)})();
</script>
<link rel="stylesheet" href="/css/palette.css?v=<%= Date.now() %>">
<link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>">
<% if (typeof extraCss !== 'undefined' && extraCss) { %>
<link rel="stylesheet" href="<%= extraCss %>">
<% } %>
