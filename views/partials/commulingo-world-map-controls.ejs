<div class="commu-world-map-controls" data-world-map-controls>
    <button type="button" data-map-action="zoom-in" aria-label="<%= copy.zoomIn %>" title="<%= copy.zoomIn %>">+</button>
    <button type="button" data-map-action="zoom-out" aria-label="<%= copy.zoomOut %>" title="<%= copy.zoomOut %>">−</button>
    <button type="button" data-map-action="reset" aria-label="<%= copy.resetMap %>" title="<%= copy.resetMap %>">↺</button>
</div>
