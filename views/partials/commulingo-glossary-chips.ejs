<%# Glossary entries an office or roster page links to (office-term-links.js).
    Locals: links ([{ href, term }]), className. %>
<% if (links && links.length) { %>
<div class="commu-glossary-chips<%= locals.className ? ' ' + className : '' %>">
    <span class="commu-glossary-chips-label"><%= lang === 'en' ? 'Glossary' : '용어 사전' %></span>
    <div class="commu-term-chips">
        <% links.forEach(function(link) { %><a class="commu-term-chip" href="<%= link.href %>"><%= link.term %></a><% }) %>
    </div>
</div>
<% } %>
