<% if (person.positionTag) { %>
<% var positionIcon = person.positionTag.icon ? roleIconSvg(person.positionTag.icon) : ''; %>
<% if (person.positionTag.href) { %>
<a class="commu-person-position" href="<%= person.positionTag.href %>"<% if (person.positionTag.intro) { %> title="<%= person.positionTag.intro %>"<% } %> onclick="event.stopPropagation()"><%- positionIcon %><%= person.positionTag.label %></a>
<% } else { %>
<span class="commu-person-position"<% if (person.positionTag.intro) { %> title="<%= person.positionTag.intro %>"<% } %>><%- positionIcon %><%= person.positionTag.label %></span>
<% } %>
<% } %>
<%# The detail head also names the person's other position collections, as
    outlined chips after the filled one. Cards show only the filled chip. %>
<% if (showOtherPositions && person.otherPositions) { person.otherPositions.forEach(function(c) { %>
<a class="commu-person-position is-secondary<%= c.position ? ' pos-' + c.position : '' %>" href="<%= c.href %>"<% if (c.intro) { %> title="<%= c.intro %>"<% } %>><%- c.icon ? roleIconSvg(c.icon) : '' %><%= c.title %></a>
<% }) } %>
