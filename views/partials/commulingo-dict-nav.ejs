<%
/* Unified switcher between the three dictionaries. `active` marks the page
   currently open: 'people' | 'events' | 'terms'. roleIconSvg comes from the
   commulingo router middleware. */
var dictNavEn = lang === 'en';
var dictTabs = [
    { key: 'people', href: '/commulingo/people', icon: 'user', label: dictNavEn ? 'People' : '인물 사전' },
    { key: 'events', href: '/commulingo/events', icon: 'flag', label: dictNavEn ? 'Historical events' : '역사 사건' },
    { key: 'terms', href: '/commulingo/terms', icon: 'book-open', label: dictNavEn ? 'Glossary' : '용어 사전' },
];
%>
<nav class="commu-dict-nav" aria-label="<%= dictNavEn ? 'Dictionaries' : '사전' %>">
    <% dictTabs.forEach(function(tab) { %>
    <a class="commu-dict-tab<%= active === tab.key ? ' is-active' : '' %>" href="<%= tab.href %>"<% if (active === tab.key) { %> aria-current="page"<% } %>><%- roleIconSvg(tab.icon) %><span><%= tab.label %></span></a>
    <% }) %>
</nav>
