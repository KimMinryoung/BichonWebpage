<%
/* Unified switcher between the dictionaries, the genealogy charts and the
   reference library. `active` marks the page currently open: 'people' |
   'events' | 'terms' | 'genealogy' | 'docs'. roleIconSvg and dictTabs come
   from the commulingo router middleware. */
var dictNavEn = lang === 'en';
var dictNavActive = typeof active !== 'undefined' ? active : null;
%>
<nav class="commu-dict-nav" aria-label="<%= dictNavEn ? 'Dictionaries' : '사전' %>">
    <% dictTabs(dictNavEn).forEach(function(tab) { %>
    <a class="commu-dict-tab<%= dictNavActive === tab.key ? ' is-active' : '' %>" href="<%= tab.href %>"<% if (dictNavActive === tab.key) { %> aria-current="page"<% } %>><%- roleIconSvg(tab.icon) %><span data-short="<%= tab.short %>"><%= tab.label %></span></a>
    <% }) %>
</nav>
