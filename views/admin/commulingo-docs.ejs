<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head', { pageTitle: strings.admin.commulingoDocs }) %>
    <link rel="stylesheet" href="/css/admin-commulingo-docs.css?v=<%= assetVersion %>">
</head>
<body>
    <%- include('../partials/nav') %>
    <% var en = lang === 'en'; %>

    <div class="container cdocs-page">
        <div class="admin-header">
            <h1><%= strings.admin.commulingoDocs %></h1>
            <a href="/commulingo/docs" class="btn" target="_blank" rel="noopener"><%= strings.commuLingoViews.adminDocs.publicPage %> ↗</a>
        </div>

        <div class="box cdocs-upload">
            <h2><%= strings.commuLingoViews.adminDocs.uploadDocument %></h2>
            <p class="cdocs-hint"><%= en
                ? 'Any .html file works — head/style/script are stripped and the body becomes an <article> fragment. Preview first to check the table of contents and warnings.'
                : '아무 .html 파일이나 올리면 head/style/script를 제거하고 본문을 <article> fragment로 변환합니다. 미리보기로 목차와 경고를 먼저 확인하세요.' %></p>
            <div class="cdocs-upload-row">
                <input type="file" id="uploadFile" accept=".html,.htm,text/html">
                <input type="text" id="uploadId" placeholder="<%= strings.commuLingoViews.adminDocs.slugEGYezhov %>" autocomplete="off" spellcheck="false">
                <button class="btn" id="previewBtn"><%= strings.commuLingoViews.adminDocs.preview %></button>
                <button class="btn btn-primary" id="uploadBtn"><%= strings.commuLingoViews.adminDocs.upload %></button>
            </div>
            <div id="uploadStatus" class="cdocs-status"></div>
            <div id="uploadResult" class="cdocs-preview" hidden>
                <div id="uploadWarnings"></div>
                <div id="uploadToc"></div>
            </div>
        </div>

        <div class="box">
            <h2><%= strings.commuLingoViews.adminDocs.documents %></h2>
            <div id="docsStatus" class="cdocs-status"></div>
            <div id="docsList" class="cdocs-list"></div>
        </div>

        <div class="box cdocs-editor" id="editorBox" hidden>
            <h2><%= strings.commuLingoViews.adminDocs.edit %>: <span id="editorDocId"></span></h2>
            <form id="editorForm">
                <div class="cdocs-grid">
                    <label><%= strings.commuLingoViews.adminDocs.titleKo %><input type="text" name="titleKo"></label>
                    <label><%= strings.commuLingoViews.adminDocs.titleEn %><input type="text" name="titleEn"></label>
                    <label><%= strings.commuLingoViews.adminDocs.kindKo %><input type="text" name="kindKo" placeholder="저작·연설"></label>
                    <label><%= strings.commuLingoViews.adminDocs.kindEn %><input type="text" name="kindEn" placeholder="Writings &amp; speeches"></label>
                    <label class="cdocs-wide"><%= strings.commuLingoViews.adminDocs.descriptionKo %><textarea name="descKo" rows="3"></textarea></label>
                    <label class="cdocs-wide"><%= strings.commuLingoViews.adminDocs.descriptionEn %><textarea name="descEn" rows="3"></textarea></label>
                    <label class="cdocs-wide"><%= strings.commuLingoViews.adminDocs.sourceCitation %><input type="text" name="source"></label>
                    <label><%= strings.commuLingoViews.adminDocs.bodyLanguage %>
                        <select name="docLang"><option value="ko">ko</option><option value="en">en</option></select>
                    </label>
                    <label><%= strings.commuLingoViews.adminDocs.tocExcludeRegexesOne %><textarea name="tocExclude" rows="2" spellcheck="false"></textarea></label>
                </div>

                <% ['people', 'terms', 'events'].forEach(function(kind) { %>
                <fieldset class="cdocs-links" data-kind="<%= kind %>">
                    <legend><%= kind === 'people' ? (strings.commuLingoViews.adminDocs.linkedPeople) : kind === 'terms' ? (strings.commuLingoViews.adminDocs.linkedTerms) : (strings.commuLingoViews.adminDocs.linkedEvents) %></legend>
                    <div class="cdocs-chips" data-chips="<%= kind %>"></div>
                    <input type="text" list="options-<%= kind %>" data-picker="<%= kind %>"
                        placeholder="<%= strings.commuLingoViews.adminDocs.typeToSearchPick %>" autocomplete="off">
                    <datalist id="options-<%= kind %>"></datalist>
                </fieldset>
                <% }) %>

                <div class="cdocs-editor-actions">
                    <button type="submit" class="btn btn-primary" id="saveBtn"><%= strings.commuLingoViews.adminDocs.save %></button>
                    <button type="button" class="btn" id="closeEditorBtn"><%= strings.commuLingoViews.adminDocs.close %></button>
                    <span id="editorStatus" class="cdocs-status"></span>
                </div>
            </form>
        </div>

        <p class="cdocs-hint"><%= en
            ? 'Changes are written to data/commulingo/docs/ on the host — remember to commit & push afterwards (data-only, no deploy needed).'
            : '변경은 호스트의 data/commulingo/docs/에 기록됩니다 — 작업 후 커밋 & 푸시하세요 (data-only라 배포는 불필요).' %></p>
    </div>

    <script src="/js/admin-commulingo-docs.js?v=<%= assetVersion %>"></script>
    <%- include('../partials/footer') %>
</body>
</html>
