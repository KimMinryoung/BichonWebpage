<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <% pageTitle = strings.admin.dashboard %>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <div class="admin-header">
            <h1><%= strings.admin.dashboard %></h1>
            <a href="/admin/posts/new" class="btn btn-primary"><%= strings.admin.createPost %></a>
        </div>

        <div class="stats-grid">
            <div class="stat-box">
                <div class="stat-number">
                    <%= stats.totalPosts %>
                </div>
                <div class="stat-label"><%= strings.admin.totalPosts %></div>
            </div>
            <div class="stat-box">
                <div class="stat-number">
                    <%= stats.recentPosts %>
                </div>
                <div class="stat-label"><%= strings.admin.recentPosts %></div>
            </div>
        </div>

        <div class="box">
            <h2><%= strings.admin.quickActions %></h2>
            <div class="quick-actions-grid">
                    <a href="/admin/posts" class="btn"><%= strings.admin.managePosts %></a>
                    <a href="/admin/users" class="btn"><%= strings.admin.users %></a>
                    <a href="/writer" class="btn"><%= strings.admin.novelWriter %></a>
                    <a href="/admin/chat-logs" class="btn"><%= strings.admin.chatLogs %></a>
                    <a href="/admin/passkeys" class="btn"><%= strings.admin.passkeys %></a>
                    <button type="button" class="btn btn-danger" id="clear-cache-btn"><%= strings.admin.clearCache %></button>
            </div>
        </div>

        <% if (recentPosts && recentPosts.length > 0) { %>
            <div class="box">
                <h2><%= strings.admin.recentPostsTitle %></h2>
                <table class="posts-table" style="margin-top: 15px;">
                    <thead>
                        <tr>
                            <th style="width: 10%;"><%= strings.admin.postId %></th>
                            <th style="width: 50%;"><%= strings.admin.postTitle %></th>
                            <th style="width: 20%;"><%= strings.admin.postCreated %></th>
                            <th style="width: 20%;"><%= strings.admin.postActions %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentPosts.slice(0, 5).forEach(post => { %>
                            <tr>
                                <td><%= post.id %></td>
                                <td><a href="/post/<%= post.id %>"><%= post.title %></a></td>
                                <td><time class="local-date-short" datetime="<%= new Date(post.created_at).toISOString() %>"></time></td>
                                <td class="actions">
                                    <div class="action-group">
                                        <a href="/admin/posts/edit/<%= post.id %>" class="btn btn-small">
                                            <%= strings.admin.edit %>
                                        </a>
                                        <form action="/admin/posts/delete/<%= post.id %>" method="POST" style="margin: 0;" data-confirm="<%= strings.admin.deleteConfirm %>">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-small btn-danger">
                                                <%= strings.admin.delete %>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <script>
    document.getElementById('clear-cache-btn').addEventListener('click', async () => {
        const btn = document.getElementById('clear-cache-btn');
        btn.disabled = true;
        btn.textContent = '...';
        try {
            const res = await fetch('/admin/cache/clear', {
                method: 'POST',
                headers: { 'x-csrf-token': '<%= csrfToken %>' }
            });
            if (res.ok) btn.textContent = '<%= strings.admin.cacheCleared %>';
            else btn.textContent = 'Error';
        } catch { btn.textContent = 'Error'; }
        setTimeout(() => { btn.textContent = '<%= strings.admin.clearCache %>'; btn.disabled = false; }, 2000);
    });
    </script>
    <%- include('../partials/footer') %>
</body>
</html>
