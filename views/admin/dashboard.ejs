<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/admin-head', { pageTitle: strings.admin.dashboard }) %>
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container admin-page">
        <div class="admin-header">
            <h1><%= strings.admin.dashboard %></h1>
            <a href="/admin/posts/new" class="btn btn-primary"><%= strings.admin.createPost %></a>
        </div>

        <div class="stats-grid">
            <div class="ui-card stat-box">
                <div class="stat-number">
                    <%= stats.totalPosts %>
                </div>
                <div class="stat-label"><%= strings.admin.totalPosts %></div>
            </div>
            <div class="ui-card stat-box">
                <div class="stat-number">
                    <%= stats.recentPosts %>
                </div>
                <div class="stat-label"><%= strings.admin.recentPosts %></div>
            </div>
        </div>

        <div class="box">
            <h2><%= strings.admin.quickActions %></h2>
            <div class="quick-actions-grid">
                    <a href="/admin/posts" class="btn"><%= strings.admin.managePosts %></a>
                    <a href="/admin/users" class="btn"><%= strings.admin.users %></a>
                    <a href="/writer" class="btn"><%= strings.admin.novelWriter %></a>
                    <a href="/admin/chat-logs" class="btn"><%= strings.admin.chatLogs %></a>
                    <a href="/admin/passkeys" class="btn"><%= strings.admin.passkeys %></a>
            </div>
        </div>

        <% if (typeof menuViews !== 'undefined' && menuViews) { %>
            <div class="box">
                <h2><%= lang === 'en' ? 'Page views by menu' : '메뉴별 방문' %></h2>
                <p class="ui-muted"><%= lang === 'en' ? 'Pages opened in a browser, detail pages included; operators and bots excluded.' : '브라우저에서 연 페이지 수(상세 페이지 포함). 운영자·봇 제외.' %></p>
                <table class="posts-table">
                    <thead>
                        <tr>
                            <th><%= lang === 'en' ? 'Menu' : '메뉴' %></th>
                            <th><%= lang === 'en' ? 'Today' : '오늘' %></th>
                            <th><%= lang === 'en' ? '7 days' : '7일' %></th>
                            <th><%= lang === 'en' ? '30 days' : '30일' %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% menuViews.forEach(row => { %>
                            <tr><td><%= row.label %></td><td><%= row.today %></td><td><%= row.week %></td><td><%= row.month %></td></tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>

        <% if (typeof webVitals !== 'undefined' && webVitals) { %>
            <div class="box">
                <h2><%= lang === 'en' ? 'Real-user performance (7 days, p75)' : '실사용 성능 (7일, p75)' %></h2>
                <p class="ui-muted"><%= lang === 'en' ? 'LCP and INP in ms, CLS in thousandths; good LCP ≤2500, INP ≤200, CLS ≤100. Samples in brackets.' : 'LCP·INP는 ms, CLS는 1/1000. 좋음 기준 LCP ≤2500, INP ≤200, CLS ≤100. 괄호는 표본 수.' %></p>
                <% if (!webVitals.length) { %>
                <p class="ui-muted"><%= lang === 'en' ? 'No samples yet.' : '아직 표본이 없습니다.' %></p>
                <% } else { %>
                <div class="table-scroll">
                <table class="posts-table">
                    <thead>
                        <tr>
                            <th><%= lang === 'en' ? 'Menu' : '메뉴' %></th>
                            <% ['mobile', 'desktop'].forEach(function (device) { ['LCP', 'INP', 'CLS'].forEach(function (metric) { %>
                            <th><%= device === 'mobile' ? (lang === 'en' ? 'Mobile' : '모바일') : (lang === 'en' ? 'Desktop' : '데스크톱') %> <%= metric %></th>
                            <% }) }) %>
                        </tr>
                    </thead>
                    <tbody>
                        <% webVitals.forEach(function (row) { %>
                        <tr>
                            <td><%= row.label %></td>
                            <% ['mobile', 'desktop'].forEach(function (device) { ['lcp', 'inp', 'cls'].forEach(function (metric) { var v = row[device][metric]; %>
                            <td class="<%= v.rating ? 'vital-' + v.rating : '' %>"><%= v.samples ? v.p75 + ' (' + v.samples + ')' : '—' %></td>
                            <% }) }) %>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
                </div>
                <% } %>
            </div>
        <% } %>

        <% if (typeof clientErrors !== 'undefined' && clientErrors) { %>
            <div class="box">
                <h2><%= lang === 'en' ? 'Browser errors (7 days)' : '브라우저 오류 (7일)' %></h2>
                <p class="ui-muted"><%= lang === 'en' ? "Errors thrown by the site's own scripts in visitors' browsers." : '방문자 브라우저에서 사이트 스크립트가 낸 오류.' %></p>
                <% if (!clientErrors.length) { %>
                <p class="ui-muted"><%= lang === 'en' ? 'None.' : '없음.' %></p>
                <% } else { %>
                <table class="posts-table">
                    <thead>
                        <tr>
                            <th><%= lang === 'en' ? 'Count' : '횟수' %></th>
                            <th><%= lang === 'en' ? 'Where' : '위치' %></th>
                            <th><%= lang === 'en' ? 'Message' : '메시지' %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% clientErrors.forEach(function (row) { %>
                        <tr><td><%= row.hits %></td><td class="vital-source"><%= row.source %></td><td><%= row.message %></td></tr>
                        <% }) %>
                    </tbody>
                </table>
                <% } %>
            </div>
        <% } %>

        <% if (recentPosts && recentPosts.length > 0) { %>
            <div class="box">
                <h2><%= strings.admin.recentPostsTitle %></h2>
                <table class="posts-table posts-table-wide">
                    <thead>
                        <tr>
                            <th class="col-id"><%= strings.admin.postId %></th>
                            <th class="col-title"><%= strings.admin.postTitle %></th>
                            <th class="col-date"><%= strings.admin.postCreated %></th>
                            <th class="col-actions"><%= strings.admin.postActions %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentPosts.slice(0, 5).forEach(post => { %>
                            <tr>
                                <td><%= post.id %></td>
                                <td><a href="/post/<%= post.id %>"><%= post.title %></a></td>
                                <td><time class="local-date-short" datetime="<%= new Date(post.created_at).toISOString() %>"><%= localDateShort(new Date(post.created_at).toISOString(), lang) %></time></td>
                                <td class="actions">
                                    <div class="action-group">
                                        <a href="/admin/posts/edit/<%= post.id %>" class="btn btn-small">
                                            <%= strings.admin.edit %>
                                        </a>
                                        <form action="/admin/posts/delete/<%= post.id %>" method="POST" class="ui-inline-form" data-confirm="<%= strings.admin.deleteConfirm %>">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-small btn-danger">
                                                <%= strings.admin.delete %>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
