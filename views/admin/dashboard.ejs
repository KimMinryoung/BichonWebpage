<!DOCTYPE html>
<html lang="ko">
<head>
    <% pageTitle = strings.admin.dashboard %>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <div class="admin-header">
            <h1><%= strings.admin.dashboard %></h1>
            <a href="/admin/posts/new" class="btn btn-primary"><%= strings.admin.createPost %></a>
        </div>

        <div class="stats-grid">
            <div class="stat-box">
                <div class="stat-number">
                    <%= stats.totalPosts %>
                </div>
                <div class="stat-label"><%= strings.admin.totalPosts %></div>
            </div>
            <div class="stat-box">
                <div class="stat-number">
                    <%= stats.recentPosts %>
                </div>
                <div class="stat-label"><%= strings.admin.recentPosts %></div>
            </div>
        </div>

        <div class="box">
            <h2><%= strings.admin.quickActions %></h2>
            <p style="margin-top: 15px;">
                <a href="/admin/posts/new" class="btn"><%= strings.admin.createPost %></a>
                <a href="/admin/posts" class="btn"><%= strings.admin.managePosts %></a>
                <a href="/admin/story-editor" class="btn btn-primary"><%= strings.admin.storyEditor %></a>
                <a href="/admin/chat-logs" class="btn"><%= strings.admin.chatLogs %></a>
                <a href="/" class="btn"><%= strings.admin.viewSite %></a>
            </p>
        </div>

        <% if (recentPosts && recentPosts.length > 0) { %>
            <div class="box">
                <h2><%= strings.admin.recentPostsTitle %></h2>
                <table class="posts-table" style="margin-top: 15px;">
                    <thead>
                        <tr>
                            <th><%= strings.admin.postTitle %></th>
                            <th><%= strings.admin.postCreated %></th>
                            <th><%= strings.admin.postActions %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentPosts.forEach(post => { %>
                            <tr>
                                <td><a href="/post/<%= post.id %>"><%= post.title %></a></td>
                                <td><%= new Date(post.created_at).toLocaleDateString('ko-KR') %></td>
                                <td class="actions">
                                    <a href="/admin/posts/edit/<%= post.id %>" class="btn btn-small"><%= strings.admin.edit %></a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
