<!DOCTYPE html>
<html lang="ko">
<head>
    <% pageTitle = strings.admin.dashboard %>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <div class="admin-header">
            <h1><%= strings.admin.dashboard %></h1>
            <a href="/admin/posts/new" class="btn btn-primary"><%= strings.admin.createPost %></a>
        </div>

        <div class="stats-grid">
            <div class="stat-box">
                <div class="stat-number">
                    <%= stats.totalPosts %>
                </div>
                <div class="stat-label"><%= strings.admin.totalPosts %></div>
            </div>
            <div class="stat-box">
                <div class="stat-number">
                    <%= stats.recentPosts %>
                </div>
                <div class="stat-label"><%= strings.admin.recentPosts %></div>
            </div>
        </div>

        <div class="box">
            <h2><%= strings.admin.quickActions %></h2>
            <div class="quick-actions-grid">
                    <a href="/admin/posts" class="btn"><%= strings.admin.managePosts %></a>
                    <a href="/admin/story-editor" class="btn"><%= strings.admin.storyEditor %></a>
                    <a href="/admin/chat-logs" class="btn"><%= strings.admin.chatLogs %></a>
                    <a href="/" class="btn"><%= strings.admin.viewSite %></a>
            </div>
        </div>

        <% if (recentPosts && recentPosts.length > 0) { %>
            <div class="box">
                <h2><%= strings.admin.recentPostsTitle %></h2>
                <table class="posts-table" style="margin-top: 15px;">
                    <thead>
                        <tr>
                            <th style="width: 10%;"><%= strings.admin.postId %></th>
                            <th style="width: 50%;"><%= strings.admin.postTitle %></th>
                            <th style="width: 20%;"><%= strings.admin.postCreated %></th>
                            <th style="width: 20%;"><%= strings.admin.postActions %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentPosts.slice(0, 5).forEach(post => { %>
                            <tr>
                                <td><%= post.id %></td>
                                <td><a href="/post/<%= post.id %>"><%= post.title %></a></td>
                                <td><%= new Date(post.created_at).toLocaleDateString('ko-KR') %></td>
                                <td class="actions">
                                    <div class="action-group">
                                        <a href="/admin/posts/edit/<%= post.id %>" class="btn btn-small">
                                            <%= strings.admin.edit %>
                                        </a>
                                        <form action="/admin/posts/delete/<%= post.id %>" method="POST" style="margin: 0;" onsubmit="return confirm('<%= strings.admin.deleteConfirm %>');">
                                            <button type="submit" class="btn btn-small btn-danger">
                                                <%= strings.admin.delete %>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
