<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <% pageTitle = strings.admin.managePosts %>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <div class="admin-header">
            <h1><%= strings.admin.managePosts %></h1>
            <a href="/admin/posts/new" class="btn btn-primary"><%= strings.admin.createPost %></a>
        </div>

        <% if (typeof message !== 'undefined' && message) { %>
            <div class="message message-<%= messageType || 'success' %>">
                <%= message %>
            </div>
        <% } %>

        <% if (posts && posts.length > 0) { %>
            <div class="box">
                <table class="posts-table">
                    <thead>
                        <tr>
                            <th style="width: 10%;"><%= strings.admin.postId %></th>
                            <th style="width: 50%;"><%= strings.admin.postTitle %></th>
                            <th style="width: 20%;"><%= strings.admin.postCreated %></th>
                            <th style="width: 20%;"><%= strings.admin.postActions %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% posts.forEach(post => { %>
                            <tr>
                                <td><%= post.id %></td>
                                <td><a href="/post/<%= post.id %>"><%= post.title %></a></td>
                                <td><time class="local-date-short" datetime="<%= new Date(post.created_at).toISOString() %>"></time></td>
                                <td class="actions">
                                    <div class="action-group">
                                        <a href="/admin/posts/edit/<%= post.id %>" class="btn btn-small">
                                            <%= strings.admin.edit %>
                                        </a>
                                        <form action="/admin/posts/delete/<%= post.id %>" method="POST" style="margin: 0;" onsubmit="return confirm('<%= strings.admin.deleteConfirm %>');">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-small btn-danger">
                                                <%= strings.admin.delete %>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="box">
                <p><%= strings.admin.noPostsYet %> <a href="/admin/posts/new"><%= strings.admin.createFirst %></a>.</p>
            </div>
        <% } %>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
