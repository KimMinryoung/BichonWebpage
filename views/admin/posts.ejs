<!DOCTYPE html>
<html lang="ko">
<head>
    <% pageTitle = strings.admin.managePosts %>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <div class="admin-header">
            <h1><%= strings.admin.managePosts %></h1>
            <a href="/admin/posts/new" class="btn btn-primary"><%= strings.admin.createPost %></a>
        </div>

        <% if (typeof message !== 'undefined' && message) { %>
            <div class="message message-<%= messageType || 'success' %>">
                <%= message %>
            </div>
        <% } %>

        <% if (posts && posts.length > 0) { %>
            <div class="box">
                <table class="posts-table">
                    <thead>
                        <tr>
                            <th><%= strings.admin.postId %></th>
                            <th><%= strings.admin.postTitle %></th>
                            <th><%= strings.admin.postCreated %></th>
                            <th><%= strings.admin.postActions %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% posts.forEach(post => { %>
                            <tr>
                                <td><%= post.id %></td>
                                <td><a href="/post/<%= post.id %>"><%= post.title %></a></td>
                                <td><%= new Date(post.created_at).toLocaleDateString('ko-KR') %></td>
                                <td class="actions">
                                    <a href="/admin/posts/edit/<%= post.id %>" class="btn btn-small"><%= strings.admin.edit %></a>
                                    <form action="/admin/posts/delete/<%= post.id %>" method="POST" style="display: inline;" onsubmit="return confirm('<%= strings.admin.deleteConfirm %>');">
                                        <button type="submit" class="btn btn-small btn-danger"><%= strings.admin.delete %></button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="box">
                <p><%= strings.admin.noPostsYet %> <a href="/admin/posts/new"><%= strings.admin.createFirst %></a>.</p>
            </div>
        <% } %>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
