<!DOCTYPE html>
<html lang="ko">
<head>
    <% pageTitle = strings.login.title %>
    <%- include('../partials/head') %>
</head>
<body>
    <nav>
        <div class="nav-content">
            <a href="/" class="logo"><%= strings.siteName %></a>
            <div class="nav-links">
                <a href="/"><%= strings.nav.home %></a>
            </div>
        </div>
    </nav>

    <div class="login-container">
        <div class="login-box">
            <h1><%= strings.login.title %></h1>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="message message-error">
                    <%= error %>
                </div>
            <% } %>

            <form action="/admin/login" method="POST">
                <div class="form-group">
                    <label for="username"><%= strings.login.username %></label>
                    <input type="text" id="username" name="username" required autofocus>
                </div>
                <div class="form-group">
                    <label for="password"><%= strings.login.password %></label>
                    <input type="password" id="password" name="password" required>
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;"><%= strings.login.submit %></button>
            </form>

        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
