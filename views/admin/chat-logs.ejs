<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <% pageTitle = strings.admin.chatLogs %>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/chat-logs.css">
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <div class="admin-header">
            <h1><%= strings.admin.chatLogs %></h1>
        </div>

        <div class="logs-controls">
            <select id="routeFilter">
                <option value="all"><%= strings.admin.chatLogsFilterAll %></option>
                <option value="casual"><%= strings.admin.chatLogsFilterCasual %></option>
                <option value="vectorstore"><%= strings.admin.chatLogsFilterVectorstore %></option>
            </select>
            <select id="limitSelect">
                <option value="25">25</option>
                <option value="50" selected>50</option>
                <option value="100">100</option>
            </select>
            <button class="btn" id="refreshBtn"><%= strings.admin.chatLogsRefresh %></button>
        </div>

        <div id="logsContainer">
            <div class="loading-spinner"><%= strings.admin.chatLogsLoading %></div>
        </div>

        <div class="pagination" id="pagination"></div>
    </div>

    <%- include('../partials/footer') %>

    <script src="/js/chat-logs.js"></script>
</body>
</html>
