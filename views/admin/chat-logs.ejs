<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <% pageTitle = strings.admin.chatLogs %>
    <%- include('../partials/head') %>
    <style>
        .logs-controls {
            display: flex;
            gap: 12px;
            align-items: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .logs-controls select,
        .logs-controls input {
            background: #1a1a1a;
            color: #f0f0f0;
            border: 1px solid #333;
            padding: 8px 12px;
            border-radius: 4px;
        }
        .log-card {
            background: #121212;
            border: 1px solid #333;
            border-radius: 6px;
            padding: 16px;
            margin-bottom: 12px;
        }
        .log-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
            font-size: 0.85em;
            color: #888;
        }
        .log-card-header .route-badge {
            padding: 2px 8px;
            border-radius: 3px;
            font-size: 0.8em;
            font-weight: 600;
        }
        .route-casual { background: #2d4a2d; color: #8fdf8f; }
        .route-vectorstore { background: #2d3a5a; color: #8fb8df; }
        .log-query {
            background: #1a1a1a;
            border-left: 3px solid #4da6ff;
            padding: 10px 14px;
            margin-bottom: 8px;
            border-radius: 0 4px 4px 0;
            white-space: pre-wrap;
            word-break: break-word;
        }
        .log-answer {
            background: #1a1a1a;
            border-left: 3px solid #66bb6a;
            padding: 10px 14px;
            margin-bottom: 8px;
            border-radius: 0 4px 4px 0;
            white-space: pre-wrap;
            word-break: break-word;
        }
        .log-label {
            font-size: 0.8em;
            color: #888;
            margin-bottom: 4px;
            font-weight: 600;
        }
        .log-meta {
            display: flex;
            gap: 16px;
            font-size: 0.8em;
            color: #666;
            margin-top: 8px;
            flex-wrap: wrap;
        }
        .log-details-toggle {
            background: none;
            border: 1px solid #444;
            color: #aaa;
            padding: 4px 10px;
            border-radius: 3px;
            cursor: pointer;
            font-size: 0.8em;
        }
        .log-details-toggle:hover { border-color: #4da6ff; color: #4da6ff; }
        .log-details {
            display: none;
            margin-top: 10px;
            padding: 10px;
            background: #0a0a0a;
            border-radius: 4px;
            font-size: 0.82em;
            color: #aaa;
        }
        .log-details.open { display: block; }
        .log-details pre {
            white-space: pre-wrap;
            word-break: break-word;
            margin: 0;
        }
        .pagination {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 24px;
        }
        .loading-spinner {
            text-align: center;
            padding: 40px;
            color: #888;
        }
        .empty-state {
            text-align: center;
            padding: 40px;
            color: #666;
        }
    </style>
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <div class="admin-header">
            <h1><%= strings.admin.chatLogs %></h1>
        </div>

        <div class="logs-controls">
            <select id="routeFilter">
                <option value="all"><%= strings.admin.chatLogsFilterAll %></option>
                <option value="casual"><%= strings.admin.chatLogsFilterCasual %></option>
                <option value="vectorstore"><%= strings.admin.chatLogsFilterVectorstore %></option>
            </select>
            <select id="limitSelect">
                <option value="25">25</option>
                <option value="50" selected>50</option>
                <option value="100">100</option>
            </select>
            <button class="btn" id="refreshBtn"><%= strings.admin.chatLogsRefresh %></button>
        </div>

        <div id="logsContainer">
            <div class="loading-spinner"><%= strings.admin.chatLogsLoading %></div>
        </div>

        <div class="pagination" id="pagination"></div>
    </div>

    <%- include('../partials/footer') %>

    <script>
        var API_URL = '<%= chatApiUrl %>';
        var currentOffset = 0;

        function getLimit() {
            return parseInt(document.getElementById('limitSelect').value, 10);
        }

        function getRouteFilter() {
            return document.getElementById('routeFilter').value;
        }

        function escapeHtml(text) {
            var div = document.createElement('div');
            div.textContent = text || '';
            return div.innerHTML;
        }

        function formatDate(iso) {
            var d = new Date(iso);
            return d.toLocaleString('ko-KR', {
                year: 'numeric', month: '2-digit', day: '2-digit',
                hour: '2-digit', minute: '2-digit'
            });
        }

        async function fetchLogs(offset) {
            var limit = getLimit();
            var container = document.getElementById('logsContainer');
            container.innerHTML = '<div class="loading-spinner">불러오는 중...</div>';

            try {
                var res = await fetch(API_URL + '/logs?limit=' + limit + '&offset=' + offset);
                if (!res.ok) throw new Error('API error: ' + res.status);
                var data = await res.json();
                renderLogs(data.logs, offset, limit);
            } catch (err) {
                container.innerHTML = '<div class="empty-state">로그를 불러올 수 없습니다: ' + escapeHtml(err.message) + '</div>';
                document.getElementById('pagination').innerHTML = '';
            }
        }

        function renderLogs(logs, offset, limit) {
            var container = document.getElementById('logsContainer');
            var routeFilter = getRouteFilter();

            var filtered = logs;
            if (routeFilter !== 'all') {
                filtered = logs.filter(function(l) { return l.route === routeFilter; });
            }

            if (filtered.length === 0) {
                container.innerHTML = '<div class="empty-state">로그가 없습니다.</div>';
                document.getElementById('pagination').innerHTML = '';
                return;
            }

            var html = '';
            filtered.forEach(function(log, i) {
                var routeClass = log.route === 'casual' ? 'route-casual' : 'route-vectorstore';
                var routeLabel = log.route === 'casual' ? '일상대화' : '진지한 대화';

                html += '<div class="log-card">';
                html += '<div class="log-card-header">';
                html += '<span>#' + log.id + ' &mdash; ' + formatDate(log.created_at) + '</span>';
                html += '<span class="route-badge ' + routeClass + '">' + routeLabel + '</span>';
                html += '</div>';

                html += '<div class="log-label">질문</div>';
                html += '<div class="log-query">' + escapeHtml(log.user_query) + '</div>';

                html += '<div class="log-label">답변</div>';
                html += '<div class="log-answer">' + escapeHtml(log.bot_answer) + '</div>';

                html += '<div class="log-meta">';
                html += '<span>이용 문헌: ' + (log.documents_count || 0) + '개</span>';
                html += '<span>웹 검색: ' + (log.web_search_used ? '함' : '하지 않음') + '</span>';
                html += '</div>';

                if (log.strategy || (log.processing_logs && log.processing_logs.length > 0)) {
                    var detailId = 'detail-' + i;
                    html += '<button class="log-details-toggle" onclick="toggleDetails(\'' + detailId + '\')">생각 과정</button>';
                    html += '<div class="log-details" id="' + detailId + '">';
                    if (log.strategy) {
                        //processing_logs에도 strategy 값이 포함되어 나오기 때문에 출력 생략
                        //html += '<div class="log-label">Strategy</div>';
                        //html += '<pre>' + escapeHtml(log.strategy) + '</pre>';
                    }
                    if (log.processing_logs && log.processing_logs.length > 0) {
                        html += '<div class="log-label" style="margin-top:8px">Processing Logs</div>';
                        html += '<pre>' + escapeHtml(log.processing_logs.join('\n')) + '</pre>';
                    }
                    html += '</div>';
                }

                html += '</div>';
            });

            container.innerHTML = html;

            // Pagination
            var pag = document.getElementById('pagination');
            var pagHtml = '';
            if (offset > 0) {
                pagHtml += '<button class="btn btn-small" onclick="goPage(' + Math.max(0, offset - limit) + ')">&#9664; Prev</button>';
            }
            if (logs.length === limit) {
                pagHtml += '<button class="btn btn-small" onclick="goPage(' + (offset + limit) + ')">Next &#9654;</button>';
            }
            pag.innerHTML = pagHtml;
        }

        function goPage(offset) {
            currentOffset = offset;
            fetchLogs(offset);
        }

        function toggleDetails(id) {
            document.getElementById(id).classList.toggle('open');
        }

        document.getElementById('refreshBtn').addEventListener('click', function() {
            currentOffset = 0;
            fetchLogs(0);
        });

        document.getElementById('routeFilter').addEventListener('change', function() {
            fetchLogs(currentOffset);
        });

        document.getElementById('limitSelect').addEventListener('change', function() {
            currentOffset = 0;
            fetchLogs(0);
        });

        // Initial load
        fetchLogs(0);
    </script>
</body>
</html>
