<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <% if (typeof message !== 'undefined' && message) { %>
            <div class="message message-<%= messageType || 'success' %>">
                <%= message %>
            </div>
        <% } %>

        <%- typeof body !== 'undefined' ? body : '' %>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
