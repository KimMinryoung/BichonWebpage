<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>

    <%
    var en = lang === 'en';
    var fateIcons = {
        executed: '✕', assassinated: '✕', murdered: '✕', killed: '✕', suicide: '✕',
        deposed: '↓', exile: '→', natural: '○'
    };
    var medalHref = typeof roleHubHref === 'function' ? roleHubHref(person.role) : '';
    var medalTitle = person.role && person.role.label ? person.role.label : (en ? 'Context marker' : '맥락 표식');
    %>

    <main class="container commulingo-shell commu-person-page" data-lang="<%= lang %>">
        <a class="commu-back-link" href="/commulingo/people#p-<%= person.id %>">← <%= en ? 'People' : '인물 사전' %></a>

        <header class="commu-person-detail-head is-<%= person.groupId %>">
            <div class="commu-person-detail-top">
                <% if (medalHref) { %>
                <a class="commu-person-medal is-<%= person.groupId %>" href="<%= medalHref %>" title="<%= medalTitle %>" aria-label="<%= medalTitle %>"><%- roleIconSvg(person.role.icon) %></a>
                <% } else { %>
                <span class="commu-person-medal is-<%= person.groupId %>" title="<%= medalTitle %>" aria-hidden="true"><%- roleIconSvg(person.role ? person.role.icon : 'circle-help') %></span>
                <% } %>
                <div class="commu-person-detail-title">
                    <h1><%= person.displayName || person.name %></h1>
                    <span><%= person.cyrillic %></span>
                </div>
                <div class="commu-person-sidebox">
                    <span class="commu-person-years">
                        <% if (typeof flagImg === 'function') { %>
                        <% if (person.citizenship) { %><%- flagImg(person.citizenship.code, person.citizenship.label, en ? 'Citizenship' : '국적') %><% } %>
                        <% if (person.origin) { %><%- flagImg(person.origin.code, person.origin.label, en ? 'National background' : '민족·국가적 배경') %><% } %>
                        <% } %>
                        <%= person.years %>
                    </span>
                    <span class="commu-fate is-<%= person.fateKind %>"><%= fateIcons[person.fateKind] || '' %> <%= person.fateLabel %></span>
                </div>
            </div>
            <p class="commu-person-epithet"><%= person.epithet %></p>
            <% if (person.moment) { %>
            <p class="commu-person-moment"><%= person.moment %></p>
            <% } %>
            <p class="commu-person-bio"><%- typeof bioHtml !== 'undefined' ? bioHtml : person.bio %></p>
        </header>

        <% if (person.career.length) { %>
        <section class="commu-person-detail-section commu-person-detail-career" aria-labelledby="career">
            <h2 id="career"><%= en ? 'Career Timeline' : '경력 연표' %></h2>
            <ul class="commu-person-career">
                <% person.career.forEach(function(item) { %>
                <li><span class="commu-career-year"><%= item.y %></span><span class="commu-career-role"><%= item.r %></span></li>
                <% }) %>
            </ul>
        </section>
        <% } %>

        <% if (historyEvents && historyEvents.length) { %>
        <section class="commu-person-detail-section commu-person-history-events" aria-labelledby="history-events">
            <h2 id="history-events"><%= en ? "Related historical events" : "관련 역사 사건" %></h2>
            <ul class="commu-person-event-links"><% historyEvents.forEach(function(event) { %><li class="is-<%= event.kind %>"><a href="/commulingo/events/<%= event.id %>"><span><%= event.period %></span><strong><%= event.title %></strong><em><%= event.relation %></em><small><%= event.note %></small></a></li><% }) %></ul>
        </section>
        <% } %>

        <% sections.forEach(function(section) { %>
        <section class="commu-person-detail-section" id="s-<%= section.slug %>">
            <% if (section.heading) { %><h2><%= section.heading %></h2><% } %>
            <div class="commu-person-markdown"><%- section.bodyHtml %></div>
        </section>
        <% }) %>

        <% if (typeof relatedDocs !== 'undefined' && relatedDocs && relatedDocs.length) { %>
        <section class="commu-person-detail-section commu-related-reports" aria-labelledby="related-docs">
            <h2 id="related-docs"><%= en ? 'Reference documents' : '참고 문헌' %></h2>
            <ul class="commu-related-report-list commu-related-doc-list">
                <% relatedDocs.forEach(function(doc) { %>
                <li><a href="/commulingo/docs/<%= doc.id %>"><span><%= doc.kind %></span><strong><%= doc.title %></strong></a></li>
                <% }) %>
            </ul>
        </section>
        <% } %>

        <% if (typeof relatedReports !== 'undefined' && relatedReports && relatedReports.length) { %>
        <section class="commu-person-detail-section commu-related-reports" aria-labelledby="related-reports">
            <h2 id="related-reports"><%= en ? 'Related reports' : '관련 보고서' %></h2>
            <ul class="commu-related-report-list">
                <% relatedReports.forEach(function(report) { %>
                <li><a href="<%= report.href %>"><span><%= report.dateLabel || (en ? 'Report' : '보고서') %></span><strong><%= report.title %></strong></a></li>
                <% }) %>
            </ul>
        </section>
        <% } %>

        <a class="commu-back-link commu-person-detail-back" href="/commulingo/people#p-<%= person.id %>">← <%= en ? 'Back to card' : '카드로 돌아가기' %></a>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
