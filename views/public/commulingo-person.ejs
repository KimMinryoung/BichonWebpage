<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>

    <%
    var en = lang === 'en';
    var medalHref = typeof roleHubHref === 'function' ? roleHubHref(person.role) : '';
    var medalTitle = person.role && person.role.label ? person.role.label : (strings.commuLingoViews.person.contextMarker);
    %>

    <main class="container commulingo-shell commu-person-page" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [
                { label: strings.commuLingoViews.person.people, href: '/commulingo/people#p-' + person.id },
                { label: person.name },
            ],
            dictJump: 'people' }) %>

        <header class="commu-person-detail-head<%= person.position ? ' pos-' + person.position : '' %>">
            <div class="commu-person-detail-top">
                <%# Cards show the role by the medal alone; the detail head names it
                    under the medal, so the meta row below keeps its room. %>
                <div class="commu-person-detail-badge">
                <% if (medalHref) { %>
                <a class="commu-person-medal" href="<%= medalHref %>" title="<%= medalTitle %>" aria-label="<%= medalTitle %>"><%- roleIconSvg(person.role.icon) %></a>
                <% } else { %>
                <span class="commu-person-medal" title="<%= medalTitle %>" aria-hidden="true"><%- roleIconSvg(person.role ? person.role.icon : 'circle-help') %></span>
                <% } %>
                <% if (person.role && person.role.label) { %>
                <% if (medalHref) { %><a class="commu-person-role-tag" href="<%= medalHref %>" aria-hidden="true" tabindex="-1"><%= person.role.label %></a><% } else { %><span class="commu-person-role-tag"><%= person.role.label %></span><% } %>
                <% } %>
                </div>
                <div class="commu-person-detail-title">
                    <h1><%= person.displayName || person.name %></h1>
                    <span><%= person.cyrillic %></span>
                </div>
            </div>
            <%- include('../partials/commulingo-person-meta', { person: person }) %>
            <%# The three header fields carry dictionary links like the card does,
                and in reading order, so the first mention that links is the first
                one reached. Each falls back to the escaped plain text. %>
            <p class="commu-person-epithet"><%- typeof epithetHtml !== 'undefined' ? epithetHtml : person.epithet %></p>
            <% if (person.moment) { %>
            <p class="commu-person-moment"><%- typeof momentHtml !== 'undefined' ? momentHtml : person.moment %></p>
            <% } %>
            <p class="commu-person-bio"><%- typeof bioHtml !== 'undefined' ? bioHtml : person.bio %></p>
        </header>

        <% if (person.activities && person.activities.length) { %>
        <section class="commu-person-detail-section" aria-labelledby="person-activities">
            <h2 id="person-activities"><%= en ? 'Activities and affiliations' : '주요 활동과 소속' %></h2>
            <%# The year column exists only when some activity is dated; an empty
                column pushed undated rows off the section's left edge. %>
            <% var activitiesDated = person.activities.some(function(a) { return a.startYear || a.endYear; }); %>
            <ul class="commu-person-career commu-person-activities">
            <% person.activities.forEach(function(a) { %>
                <li><% if (activitiesDated) { %><span class="commu-career-year"><%= a.startYear && a.startYear === a.endYear ? a.startYear : (a.startYear || '') + (a.startYear || a.endYear ? '–' : '') + (a.endYear || '') %></span><% } %>
                    <span><a class="commu-person-activity-link" href="<%= a.href %>"><%= a.label %><% if (a.affiliationLabel) { %> · <span class="commu-person-affiliation"><% if (a.affiliationIcon === 'hammer-sickle') { %><%- roleIconSvg('hammer-sickle') %><% } %><%= a.affiliationLabel %></span><% } %></a>
                    <% if (a.officeLabel) { %> · <a class="commu-person-office-link" href="<%= a.officeHref %>"><%= a.officeLabel %></a><% } %>
                    </span></li>
            <% }) %>
            </ul>
            <% if (person.collections && person.collections.length) { %><p class="commu-person-collections"><%= en ? 'Political positions' : '정치적 입장' %>: <% person.collections.forEach(function(c, i) { %><%= i ? ' · ' : '' %><a href="<%= c.href %>"><%= c.title %></a><% }) %></p><% } %>
        </section>
        <% } %>
        <% if (person.career.length) { %>
        <section class="commu-person-detail-section commu-person-detail-career" aria-labelledby="career">
            <h2 id="career"><%= strings.commuLingoViews.person.careerTimeline %></h2>
            <ul class="commu-person-career">
                <% person.career.forEach(function(item) { %>
                <li><span class="commu-career-year"><%= item.y %></span><span class="commu-career-role"><%= item.r %></span></li>
                <% }) %>
            </ul>
        </section>
        <% } %>

        <% if (typeof politburo !== 'undefined' && politburo) { %>
        <section class="commu-person-detail-section commu-person-politburo" aria-labelledby="politburo">
            <h2 id="politburo"><a class="commu-topic-link" href="/commulingo/politburo"><%= strings.commuLingoViews.person.theSovietPolitburo %></a></h2>
            <ul class="commu-person-politburo-stints">
                <% politburo.parts.forEach(function(part) { %><li><%= part %></li><% }) %>
            </ul>
            <% if (politburo.note) { %><p class="commu-person-politburo-note"><%= politburo.note %></p><% } %>
        </section>
        <% } %>

        <% if (historyEvents && historyEvents.length) { %>
        <section class="commu-person-detail-section commu-person-history-events" aria-labelledby="history-events">
            <h2 id="history-events"><%= strings.commuLingoViews.person.relatedHistoricalEvents %></h2>
            <ul class="commu-person-event-links"><% historyEvents.forEach(function(event) { %><li class="is-<%= event.kind %>"><a href="/commulingo/events/<%= event.id %>"><span><%= event.period %></span><strong><%= event.title %></strong><em><%= event.relation %></em><small><%= event.note %></small></a></li><% }) %></ul>
        </section>
        <% } %>

        <% sections.forEach(function(section) { %>
        <section class="commu-person-detail-section" id="s-<%= section.slug %>">
            <% if (section.heading) { %><h2><%= section.heading %></h2><% } %>
            <div class="commu-person-markdown"><%- section.bodyHtml %></div>
        </section>
        <% }) %>

        <%- include('../partials/commulingo-practice-links', { decks: typeof practiceDecks !== 'undefined' ? practiceDecks : [], chapters: typeof courseChapters !== 'undefined' ? courseChapters : [], scenes: person.scenes }) %>

        <%- include('../partials/commulingo-genealogy-links', { en: en, charts: typeof genealogies !== 'undefined' ? genealogies : [], headword: person.displayName || person.name }) %>

        <%- include('../partials/commulingo-related-resources', {
            relatedDocs: typeof relatedDocs !== 'undefined' ? relatedDocs : [],
            relatedReports: typeof relatedReports !== 'undefined' ? relatedReports : [],
            copy: strings.commuLingoViews.person }) %>

        <a class="btn btn-block commu-person-detail-back" href="/commulingo/people#p-<%= person.id %>">&larr; <%= strings.commuLingoViews.person.backToCard %></a>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
