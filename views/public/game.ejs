<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/game.css?v=<%= assetVersion %>">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pixi.js/7.3.2/pixi.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
</head>
<body class="game-page">
    <div id="game-wrapper">
        <a id="back-btn" href="/"><%= lang === 'en' ? 'Exit' : '종료' %></a>
        <div id="game-canvas-container"></div>
        <div id="game-narrative"></div>
        <div id="game-choices"></div>
        <div id="game-ending"></div>
    </div>

    <script src="/js/game/config.js?v=<%= assetVersion %>"></script>
    <script src="/js/game/state.js?v=<%= assetVersion %>"></script>
    <script src="/js/game/road.js?v=<%= assetVersion %>"></script>
    <script src="/js/game/renderer.js?v=<%= assetVersion %>"></script>
    <script src="/js/game/assets.js?v=<%= assetVersion %>"></script>
    <script src="/js/game/entities.js?v=<%= assetVersion %>"></script>
    <script src="/js/game/touch.js?v=<%= assetVersion %>"></script>
    <script src="/js/game/events.js?v=<%= assetVersion %>"></script>
    <script src="/js/game/effects.js?v=<%= assetVersion %>"></script>
    <script src="/js/game/particles.js?v=<%= assetVersion %>"></script>
    <script src="/js/game/sound.js?v=<%= assetVersion %>"></script>
    <script src="/js/game/scenes/seoul.js?v=<%= assetVersion %>"></script>
    <script src="/js/game/timeline.js?v=<%= assetVersion %>"></script>
    <script src="/js/game/intervention.js?v=<%= assetVersion %>"></script>
    <script src="/js/game/main.js?v=<%= assetVersion %>"></script>
</body>
</html>
