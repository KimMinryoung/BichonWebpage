<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/game.css?v=<%= Date.now() %>">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pixi.js/7.3.2/pixi.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
</head>
<body class="game-page">
    <a id="back-btn" href="/"><%= lang === 'en' ? 'Exit' : '종료' %></a>

    <div id="game-canvas-container"></div>
    <div id="game-choices"></div>
    <div id="game-ending"></div>

    <div id="game-rotate-prompt">
        <div class="rotate-icon">&#x1F4F1;</div>
        <div><%= lang === 'en' ? 'Please rotate your device' : '기기를 가로로 회전해주세요' %></div>
    </div>

    <script src="/js/game/config.js?v=<%= Date.now() %>"></script>
    <script src="/js/game/state.js?v=<%= Date.now() %>"></script>
    <script src="/js/game/renderer.js?v=<%= Date.now() %>"></script>
    <script src="/js/game/entities.js?v=<%= Date.now() %>"></script>
    <script src="/js/game/scenes/seoul.js?v=<%= Date.now() %>"></script>
    <script src="/js/game/timeline.js?v=<%= Date.now() %>"></script>
    <script src="/js/game/intervention.js?v=<%= Date.now() %>"></script>
    <script src="/js/game/main.js?v=<%= Date.now() %>"></script>
</body>
</html>