<!DOCTYPE html>
<html lang="<%= lang %>">
<head><%- include('../partials/head') %></head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>
    <% var en = lang === 'en'; %>
    <main class="container commulingo-shell commu-events-page" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [{ label: en ? 'Historical events' : '역사 사건' }],
            dictJump: 'events' }) %>
        <h1 class="commu-sr-only"><%= en ? 'Historical Events' : '역사 사건' %></h1>
        <%- include('../partials/commulingo-dict-search', {
            target: '#commu-event-list',
            placeholder: en ? 'Search by period, event, or description…' : '시기 · 사건명 · 설명으로 검색…',
            ariaLabel: en ? 'Search historical events' : '역사 사건 검색',
            clearLabel: en ? 'Clear search' : '검색 지우기',
            resultOne: en ? 'event found' : '개의 사건',
            resultMany: en ? 'events found' : '개의 사건',
            emptyLabel: en ? 'No historical events found' : '검색 결과가 없습니다'
        }) %>
        <section class="commu-event-grid" id="commu-event-list" aria-label="<%= en ? 'Historical events' : '역사 사건 목록' %>">
            <% events.forEach(function(event) { %>
            <a class="commu-event-card" href="/commulingo/events/<%= event.id %>"
                data-search="<%= [event.period, event.title, event.summary].filter(Boolean).join(' ') %>"
                data-search-title="<%= event.title %>">
                <div class="commu-event-meta">
                    <span class="commu-event-period"><%= event.period %></span>
                </div>
                <h2><%= event.title %></h2>
                <p><%= event.summary %></p>
            </a>
            <% }) %>
        </section>
    </main>
    <%- include('../partials/footer') %>
    <script src="/js/commulingo-dict-search.js?v=<%= assetVersion %>"></script>
</body>
</html>
