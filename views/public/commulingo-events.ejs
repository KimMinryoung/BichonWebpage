<!DOCTYPE html>
<html lang="<%= lang %>">
<head><%- include('../partials/head') %></head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>
    <% var en = lang === 'en'; %>
    <main class="container commulingo-shell commu-events-page" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [{ label: strings.commuLingoViews.events.historicalEvents }],
            dictJump: 'events' }) %>
        <h1 class="commu-sr-only"><%= strings.commuLingoViews.events.historicalEvents2 %></h1>
        <% if (selectedCountry) { %>
        <div class="commu-country-event-filter">
            <div class="commu-country-event-actions">
                <a class="btn btn-small" href="<%= selectedCountry.href %>"><span aria-hidden="true">←</span> <%= selectedCountry.label %></a>
                <a class="btn btn-small" href="/commulingo/events"><%= en ? 'All countries' : '모든 국가 사건' %> <span aria-hidden="true">→</span></a>
            </div>
            <h2><%= selectedCountry.label %> · <%= en ? 'Events' : '사건' %> <small><%= events.length %></small></h2>
        </div>
        <% } %>
        <%- include('../partials/commulingo-dict-search', {
            target: '#commu-event-list',
            placeholder: strings.commuLingoViews.events.searchByPeriodEvent,
            ariaLabel: strings.commuLingoViews.events.searchHistoricalEvents,
            clearLabel: strings.commuLingoViews.events.clearSearch,
            resultOne: strings.commuLingoViews.events.eventFound,
            resultMany: strings.commuLingoViews.events.eventsFound,
            emptyLabel: strings.commuLingoViews.events.noHistoricalEventsFound
        }) %>
        <section class="commu-event-grid" id="commu-event-list" data-country="<%= selectedCountry ? selectedCountry.code : '' %>" data-page-size="<%= pagination.pageSize %>" data-page="<%= pagination.current %>"
            aria-label="<%= strings.commuLingoViews.events.historicalEvents3 %>">
            <% events.forEach(function(event) { %>
            <a class="commu-event-card" href="/commulingo/events/<%= event.id %>"
                data-search="<%= [event.period, event.title, event.summary, event.searchExpressions].filter(Boolean).join(' ') %>"
                data-search-title="<%= event.title %>"<% if (!event.onPage) { %> hidden<% } %>>
                <div class="commu-event-meta">
                    <span class="commu-event-period"><%= event.period %></span>
                </div>
                <h2><%= event.title %></h2>
                <p><%= event.summary %></p>
            </a>
            <% }) %>
        </section>
        <%- include('../partials/commulingo-list-pager', { pagination: pagination, target: '#commu-event-list', en: en }) %>
    </main>
    <%- include('../partials/footer') %>
    <script src="/js/commulingo-dict-search.js?v=<%= assetVersion %>"></script>
</body>
</html>
