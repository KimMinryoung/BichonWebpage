<!DOCTYPE html>
<html lang="<%= lang %>">
<head><%- include('../partials/head') %></head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>
    <% var en = lang === 'en'; %>
    <main class="container commulingo-shell commu-politburo-page" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [
                { label: strings.commuLingoViews.office.lineages, href: '/commulingo/offices' },
                { label: body.title }
            ],
            dictJump: 'people' }) %>
        <header class="commu-politburo-head">
            <h1><%= body.title %></h1>
            <p class="commu-politburo-range"><%= body.range %></p>
            <p class="commu-politburo-intro"><%= intro %></p>
        </header>

        <% eras.forEach(function(era) { %>
        <details class="commu-politburo-era" id="<%= era.id %>">
            <summary>
                <h2 id="era-<%= era.id %>"><%= era.title %> <span class="commu-politburo-period"><%= era.period %></span></h2>
            </summary>
            <p class="commu-politburo-era-intro"><%= era.intro %></p>
            <div class="commu-politburo-scroll">
                <table class="commu-politburo-table">
                    <thead>
                        <tr>
                            <th scope="col"><%= strings.commuLingoViews.politburo.person %></th>
                            <th scope="col"><%= strings.commuLingoViews.politburo.tenure %></th>
                            <th scope="col"><%= strings.commuLingoViews.politburo.notes %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% era.rows.forEach(function(row) { %>
                        <tr>
                            <td><% if (row.href) { %><a href="<%= row.href %>"><%= row.name %></a><% } else { %><span class="commu-politburo-unlinked"><%= row.name %></span><% } %></td>
                            <td><% row.tenureParts.forEach(function(part) { %><span class="commu-politburo-stint"><%= part %></span><% }) %></td>
                            <td><%= row.note %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </details>
        <% }) %>

        <section class="commu-politburo-congresses" aria-labelledby="politburo-congresses-title">
            <h2 id="politburo-congresses-title"><%= strings.commuLingoViews.politburo.compositionByPartyCongress %></h2>
            <% if (congressesIntro) { %><p class="commu-politburo-era-intro"><%= congressesIntro %></p><% } %>
            <% congresses.forEach(function(congress) { %>
            <details class="commu-politburo-congress" id="congress-<%= congress.n %>">
                <summary>
                    <span class="commu-politburo-congress-title"><%= congress.title %></span>
                    <span class="commu-politburo-congress-meta"><%= congress.date %> · <%= body.counts.full %> <%= congress.electedFull %><% if (congress.electedCandidates) { %> · <%= body.counts.candidates %> <%= congress.electedCandidates %><% } %></span>
                </summary>
                <% if (congress.note) { %><p class="commu-politburo-congress-note"><%= congress.note %></p><% } %>
                <% ['full', 'candidates'].forEach(function(bucket) { %>
                <% var members = congress[bucket]; if (!members.length) return; %>
                <h3><%= body.buckets[bucket] %></h3>
                <div class="commu-politburo-scroll">
                    <table class="commu-politburo-table">
                        <thead>
                            <tr>
                                <th scope="col"><%= strings.commuLingoViews.politburo.person %></th>
                                <th scope="col"><%= strings.commuLingoViews.politburo.entry %></th>
                                <th scope="col"><%= strings.commuLingoViews.politburo.change %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% members.forEach(function(row) { %>
                            <tr>
                                <td><% if (row.href) { %><a href="<%= row.href %>"><%= row.name %></a><% } else { %><span class="commu-politburo-unlinked"><%= row.name %></span><% } %></td>
                                <td><%= row.in %></td>
                                <td><%= row.out %></td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                <% }) %>
            </details>
            <% }) %>
        </section>

        <p class="commu-politburo-sources"><%= sources %></p>
        <a class="btn btn-block commu-person-detail-back" href="/commulingo/offices/<%= body.officeId %>">&larr; <%= strings.commuLingoViews.office.lineages %></a>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
