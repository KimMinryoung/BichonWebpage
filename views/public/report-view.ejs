<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <title>#<%= report.id %> — <%= report.content.split('\n')[0].substring(0, 80) %></title>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/report.css?v=<%= Date.now() %>">
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.6/purify.min.js"></script>
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <article class="post-content">
            <div class="report-task-label">Task #<%= report.id %></div>
            <h1><%= report.content.split('\n')[0] %></h1>
            <div class="post-meta">
                <time class="local-date" datetime="<%= new Date(report.completed_at).toISOString() %>" data-suffix="<%= strings.public.postedAt %>"></time>
            </div>
            <div class="report-body" id="report-content"></div>
            <script type="application/json" id="report-raw"><%- JSON.stringify(report.result).replace(/</g, '\\u003c') %></script>
        </article>

        <div class="box post-nav" style="margin-top: 20px;">
            <div class="post-nav-left">
                <a href="/reports">&larr; <%= strings.public.backToList %></a>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
    <script src="/js/report-view.js?v=<%= Date.now() %>"></script>
</body>
</html>
