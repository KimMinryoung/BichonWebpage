<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>

    <% var en = lang === 'en'; %>
    <main class="container commulingo-shell commu-person-hub-page" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [
                { label: strings.commuLingoViews.worldMap.title, href: '/commulingo/map' },
                { label: filter.label, href: countryPageHref },
                { label: filter.peopleLabel },
            ],
            dictJump: 'map' }) %>

        <header class="commu-hub-head commu-nationality-hub-head">
            <span class="commu-nationality-hub-flag" aria-hidden="true"><%- flagImg(filter.code, filter.label) %></span>
            <div>
                <h1><%= en ? filter.label + ': ' + filter.peopleLabel : filter.label + ' ' + filter.peopleLabel %></h1>
                <p><%= people.length %> <%= en ? (people.length === 1 ? 'person' : 'people') : '명' %></p>
            </div>
        </header>

        <section class="commu-hub-section" aria-label="<%= filter.peopleLabel %>">
            <div class="commu-people-grid">
                <% people.forEach(function(person) { %>
                <%- include('../partials/commulingo-person-card', { person: person, en: en, roleIconSvg: roleIconSvg, roleHubHref: roleHubHref, flagImg: flagImg, personFlagHref: personFlagHref }) %>
                <% }) %>
            </div>
        </section>
    </main>

    <%- include('../partials/footer') %>
    <%- include('../partials/commulingo-person-card-click-script') %>
</body>
</html>
