<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <title><%= strings.nav.diary %></title>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <header class="box compact-header">
            <h1><%= strings.nav.diary %></h1>
        </header>

        <% if (typeof message !== 'undefined' && message) { %>
            <div class="message message-<%= typeof messageType !== 'undefined' ? messageType : 'success' %>">
                <%= message %>
            </div>
        <% } %>

        <% if (diaries && diaries.length > 0) { %>
            <ul class="post-list">
                <% diaries.forEach(diary => { %>
                    <li class="post-item">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                            <div style="flex: 1;">
                                <h2><a href="/ai-diary/<%= diary.id %>"><%= diary.title %></a></h2>
                                <div class="post-meta">
                                    <time class="local-date" datetime="<%= new Date(diary.created_at).toISOString() %>" data-suffix="<%= strings.public.postedAt %>"></time>
                                </div>
                                <p class="post-excerpt">
                                    <%- truncateHtml(diary.content, 200) %>
                                </p>
                            </div>
                            <% if (isAuthenticated) { %>
                                <form action="/ai-diary/<%= diary.id %>/delete" method="POST" style="margin-left: 15px;" onsubmit="return confirm('<%= strings.public.deleteDiaryConfirm %>');">
                                    <button type="submit" class="btn btn-danger btn-small"><%= strings.admin.delete %></button>
                                </form>
                            <% } %>
                        </div>
                    </li>
                <% }) %>
            </ul>

            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <%- include('../partials/pagination', {
                    currentPage: currentPage,
                    totalPages: totalPages,
                    baseUrl: paginationBase
                }) %>
            <% } %>
        <% } else { %>
            <div class="box">
                <p><%= strings.public.noDiaries %></p>
            </div>
        <% } %>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
