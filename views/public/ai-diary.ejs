<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <%- include('../partials/library-tabs', { active: 'diary' }) %>

        <% if (typeof message !== 'undefined' && message) { %>
            <div class="message message-<%= typeof messageType !== 'undefined' ? messageType : 'success' %>">
                <%= message %>
            </div>
        <% } %>

        <%- include('../partials/library-search', { section: 'diary' }) %>
        <% if (typeof loadFailed !== 'undefined' && loadFailed) { %>
            <div class="box"><p><%= strings.public.listUnavailable %></p></div>
        <% } else { %>
            <% if (diaries.length === 0 && !searchValue) { %>
                <div class="box"><p><%= strings.public.noDiaries %></p></div>
            <% } %>
            <ul class="post-list library-list" id="library-list" data-search-endpoint="/ai-diary/search" data-page="<%= pagination.current %>">
                <%- include('../partials/library-entry-items', { entries: diaries, hrefPrefix: '/ai-diary/', deletable: true }) %>
            </ul>
            <%- include('../partials/commulingo-list-pager', { pagination: pagination, target: '#library-list' }) %>
        <% } %>
    </div>

    <%- include('../partials/footer') %>
    <script src="/js/commulingo-search-utils.js?v=<%= assetVersion %>"></script>
    <script src="/js/commulingo-dict-search.js?v=<%= assetVersion %>"></script>
</body>
</html>
