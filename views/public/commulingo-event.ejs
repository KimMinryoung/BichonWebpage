<!DOCTYPE html>
<html lang="<%= lang %>">
<head><%- include('../partials/head') %></head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>
    <% var en = lang === 'en'; %>
    <% var paired = typeof termPanel !== 'undefined' && termPanel; %>
    <main class="container commulingo-shell commu-event-page" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [
                { label: en ? 'Historical events' : '역사 사건', href: '/commulingo/events', pair: paired },
                { label: event.title, pair: paired },
            ],
            attached: paired,
            dictJump: paired ? false : 'events' }) %>
        <% if (paired) { %>
        <%- include('../partials/commulingo-pair-tabs', {
                en: en, activePanel: 'event',
                pairTermId: termPanel.term.id, pairEventId: event.id,
                pairTermLabel: termPanel.term.term, pairEventLabel: event.title }) %>
        <div class="commu-pair-panel" data-panel="term" hidden>
            <%- include('../partials/commulingo-term-panel', { en: en, p: termPanel }) %>
        </div>
        <div class="commu-pair-panel is-active" data-panel="event">
        <% } %>
        <%- include('../partials/commulingo-event-panel', {
                en: en,
                p: { event: event, relatedTerms: relatedTerms,
                     relatedDocs: relatedDocs, relatedReports: relatedReports,
                     genealogies: genealogies } }) %>
        <% if (paired) { %>
        </div>
        <% } %>
        <% if ((typeof prevEvent !== 'undefined' && prevEvent) || (typeof nextEvent !== 'undefined' && nextEvent)) { %>
        <nav class="commu-event-nav" aria-label="<%= en ? 'Other events' : '다른 사건' %>">
            <% if (typeof prevEvent !== 'undefined' && prevEvent) { %>
            <a class="commu-event-nav-link is-prev" href="/commulingo/events/<%= prevEvent.id %>"><span class="commu-event-nav-dir">← <%= en ? 'Previous' : '이전' %></span><span class="commu-event-nav-period"><%= prevEvent.period %></span><strong><%= prevEvent.title %></strong></a>
            <% } else { %><span></span><% } %>
            <% if (typeof nextEvent !== 'undefined' && nextEvent) { %>
            <a class="commu-event-nav-link is-next" href="/commulingo/events/<%= nextEvent.id %>"><span class="commu-event-nav-dir"><%= en ? 'Next' : '다음' %> →</span><span class="commu-event-nav-period"><%= nextEvent.period %></span><strong><%= nextEvent.title %></strong></a>
            <% } %>
        </nav>
        <% } %>
        <a class="commu-back-link commu-person-detail-back" data-pair-back href="/commulingo/events">← <%= en ? 'Historical events' : '역사 사건' %></a>
    </main>
    <% if (paired) { %><script src="/js/commulingo-pair-tabs.js?v=<%= assetVersion %>" defer></script><% } %>
    <%- include('../partials/footer') %>
</body>
</html>
