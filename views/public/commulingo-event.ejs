<!DOCTYPE html>
<html lang="<%= lang %>">
<head><%- include('../partials/head') %></head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>
    <% var en = lang === 'en'; %>
    <main class="container commulingo-shell commu-event-page" data-lang="<%= lang %>">
        <a class="commu-back-link" href="/commulingo/events">← <%= en ? 'Historical events' : '역사 사건' %></a>
        <header class="commu-event-head">
            <span class="commu-event-period"><%= event.period %></span>
            <h1><%= event.title %></h1>
            <p class="commu-event-question"><%= event.question %></p>
            <p><%= event.summary %></p>
        </header>
        <section class="commu-person-detail-section commu-event-timeline" aria-labelledby="event-timeline">
            <h2 id="event-timeline"><%= en ? 'Timeline' : '연표' %></h2>
            <ol class="commu-event-timeline-list"><% event.timeline.forEach(function(item) { %><li><span><%= item.date %></span><div><strong><%= item.title %></strong><p><%= item.body %></p></div></li><% }) %></ol>
        </section>
        <section class="commu-person-detail-section commu-event-outcome" aria-labelledby="event-outcome"><h2 id="event-outcome"><%= en ? 'Consequences' : '결과' %></h2><p><%= event.outcome %></p></section>
        <section class="commu-person-detail-section commu-event-people" aria-labelledby="event-people">
            <h2 id="event-people"><%= en ? 'Related people' : '관련 인물' %> <span class="commu-event-people-count"><%= event.people.length %><%= en ? '' : '명' %></span></h2>
            <% event.peopleGroups.forEach(function(group) { %>
            <div class="commu-event-people-group is-<%= group.kind %>">
                <h3 class="commu-event-people-group-head"><%= group.label %><span class="commu-event-people-group-count"><%= group.people.length %></span></h3>
                <div class="commu-event-people-grid"><% group.people.forEach(function(person) { %><a class="is-<%= person.kind %>" href="/commulingo/people/<%= person.id %>"><span class="commu-event-person-relation"><%= person.relation %></span><strong><%= person.name %></strong><small><%= person.years %></small><p><%= person.note %></p></a><% }) %></div>
            </div>
            <% }) %>
        </section>
        <% if (typeof relatedTerms !== 'undefined' && relatedTerms && relatedTerms.length) { %>
        <section class="commu-person-detail-section" aria-labelledby="event-terms">
            <h2 id="event-terms"><%= en ? 'Related terms' : '관련 용어' %></h2>
            <div class="commu-term-chips">
                <% relatedTerms.forEach(function(entry) { %>
                <a class="commu-term-chip" href="/commulingo/terms/<%= encodeURIComponent(entry.id) %>"><%= entry.term %></a>
                <% entry.children.forEach(function(child) { %>
                <a class="commu-term-chip is-child" href="/commulingo/terms/<%= encodeURIComponent(child.id) %>">└ <%= child.term %></a>
                <% }) %>
                <% }) %>
            </div>
        </section>
        <% } %>
        <% if (typeof relatedDocs !== 'undefined' && relatedDocs && relatedDocs.length) { %>
        <section class="commu-person-detail-section commu-related-reports" aria-labelledby="related-docs">
            <h2 id="related-docs"><%= en ? 'Reference documents' : '참고 문헌' %></h2>
            <ul class="commu-related-report-list commu-related-doc-list">
                <% relatedDocs.forEach(function(doc) { %>
                <li><a href="/commulingo/docs/<%= doc.id %>"><span><%= doc.kind %></span><strong><%= doc.title %></strong></a></li>
                <% }) %>
            </ul>
        </section>
        <% } %>
        <% if (typeof relatedReports !== 'undefined' && relatedReports && relatedReports.length) { %>
        <section class="commu-person-detail-section commu-related-reports" aria-labelledby="related-reports">
            <h2 id="related-reports"><%= en ? 'Related reports' : '관련 보고서' %></h2>
            <ul class="commu-related-report-list">
                <% relatedReports.forEach(function(report) { %>
                <li><a href="<%= report.href %>"><span><%= report.dateLabel || (en ? 'Report' : '보고서') %></span><strong><%= report.title %></strong></a></li>
                <% }) %>
            </ul>
        </section>
        <% } %>
        <% if (event.sources.length) { %><p class="commu-event-sources"><%= en ? 'Sources:' : '출처:' %> <% event.sources.forEach(function(source, index) { %><% if (/^https?:\/\//.test(source)) { %><a href="<%= source %>" target="_blank" rel="noopener noreferrer"><%= en ? 'reference ' + (index + 1) : '자료 ' + (index + 1) %></a><% } else { %><span class="commu-event-source-text"><%= source %></span><% } %><% }) %></p><% } %>
        <% if ((typeof prevEvent !== 'undefined' && prevEvent) || (typeof nextEvent !== 'undefined' && nextEvent)) { %>
        <nav class="commu-event-nav" aria-label="<%= en ? 'Other events' : '다른 사건' %>">
            <% if (typeof prevEvent !== 'undefined' && prevEvent) { %>
            <a class="commu-event-nav-link is-prev" href="/commulingo/events/<%= prevEvent.id %>"><span class="commu-event-nav-dir">← <%= en ? 'Previous' : '이전' %></span><span class="commu-event-nav-period"><%= prevEvent.period %></span><strong><%= prevEvent.title %></strong></a>
            <% } else { %><span></span><% } %>
            <% if (typeof nextEvent !== 'undefined' && nextEvent) { %>
            <a class="commu-event-nav-link is-next" href="/commulingo/events/<%= nextEvent.id %>"><span class="commu-event-nav-dir"><%= en ? 'Next' : '다음' %> →</span><span class="commu-event-nav-period"><%= nextEvent.period %></span><strong><%= nextEvent.title %></strong></a>
            <% } %>
        </nav>
        <% } %>
        <a class="commu-back-link commu-person-detail-back" href="/commulingo/events">← <%= en ? 'Historical events' : '역사 사건' %></a>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
