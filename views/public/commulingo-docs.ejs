<!DOCTYPE html>
<html lang="<%= lang %>">
<head><%- include('../partials/head') %></head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>
    <% var en = lang === 'en'; %>
    <main class="container commulingo-shell commu-docs-page" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [{ label: en ? 'References' : '참고 문헌' }],
            dictJump: 'docs' }) %>
        <h1 class="commu-sr-only"><%= en ? 'Reference Library' : '참고 문헌' %></h1>
        <%- include('../partials/commulingo-dict-search', {
            target: '#commu-doc-list',
            placeholder: en ? 'Search by title, kind, or description…' : '제목 · 분류 · 설명으로 검색…',
            ariaLabel: en ? 'Search reference documents' : '참고 문헌 검색',
            clearLabel: en ? 'Clear search' : '검색 지우기',
            resultOne: en ? 'document found' : '개의 문헌',
            resultMany: en ? 'documents found' : '개의 문헌',
            emptyLabel: en ? 'No reference documents found' : '검색 결과가 없습니다'
        }) %>
        <%
        // Kind chips and the pager are links so the list works without script;
        // commulingo-dict-search.js takes them over (data-page-size turns its
        // chunked reveal into pages) and rewrites the URL as the reader moves.
        %>
        <div class="commu-dict-chips" data-commu-dict-chips data-target="#commu-doc-list"
            role="group" aria-label="<%= en ? 'Filter by kind' : '분류로 걸러보기' %>">
            <a class="commu-dict-chip<%= kind ? '' : ' is-active' %>" href="/commulingo/docs"
                data-category="" aria-pressed="<%= kind ? 'false' : 'true' %>"><%= en ? 'All' : '전체' %> <span><%= docs.length %></span></a>
            <% facets.forEach(function(facet) { %>
            <a class="commu-dict-chip<%= facet.id === kind ? ' is-active' : '' %>" href="/commulingo/docs?kind=<%= encodeURIComponent(facet.id) %>"
                data-category="<%= facet.id %>" aria-pressed="<%= facet.id === kind ? 'true' : 'false' %>"><%= facet.label %> <span><%= facet.count %></span></a>
            <% }) %>
        </div>
        <section class="commu-event-grid" id="commu-doc-list" data-page-size="<%= pageSize %>" data-page="<%= pagination.current %>"
            aria-label="<%= en ? 'Reference documents' : '참고 문헌 목록' %>">
            <% docs.forEach(function(doc) { %>
            <a class="commu-event-card" href="/commulingo/docs/<%= doc.id %>"
                data-search="<%= doc.searchText %>"
                data-search-title="<%= doc.searchTitleText %>"
                data-category="<%= doc.kindId %>"<% if (!doc.onPage) { %> hidden<% } %>>
                <span class="commu-event-period"><%= doc.kind %></span>
                <h2><%= doc.title %></h2>
                <p><%= doc.description %></p>
                <span class="commu-event-card-link"><%= en ? 'Read the full text →' : '전문 읽기 →' %></span>
            </a>
            <% }) %>
        </section>
        <%
        // The site's pagination partial (the one under /ai-diary), wrapped in
        // a hook so commulingo-dict-search.js can redraw it over a filtered
        // list. Labels are passed so the English page reads in English.
        %>
        <div data-commu-list-pager data-target="#commu-doc-list"
            data-label-prev="<%= en ? 'Previous' : '이전' %>" data-label-next="<%= en ? 'Next' : '다음' %>"
            data-label-page="<%= en ? 'Page' : '쪽' %>"<% if (pagination.total < 2) { %> hidden<% } %>>
            <% if (pagination.total > 1) { %>
            <%- include('../partials/pagination', {
                currentPage: pagination.current,
                totalPages: pagination.total,
                baseUrl: pagination.baseUrl,
                prevLabel: en ? 'Previous' : '이전',
                nextLabel: en ? 'Next' : '다음'
            }) %>
            <% } %>
        </div>
    </main>
    <%- include('../partials/footer') %>
    <script src="/js/commulingo-dict-search.js?v=<%= assetVersion %>"></script>
</body>
</html>
