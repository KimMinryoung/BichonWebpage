<!DOCTYPE html>
<html lang="<%= lang %>">
<head><%- include('../partials/head') %></head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>
    <% var en = lang === 'en'; %>
    <main class="container commulingo-shell commu-dict-shell commu-docs-page" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [{ label: strings.commuLingoViews.docs.references }],
            dictJump: 'docs' }) %>
        <h1 class="commu-sr-only"><%= strings.commuLingoViews.docs.referenceLibrary %></h1>
        <%- include('../partials/commulingo-dict-search', {
            target: '#commu-doc-list',
            placeholder: strings.commuLingoViews.docs.searchByTitleKind,
            ariaLabel: strings.commuLingoViews.docs.searchReferenceDocuments,
            clearLabel: strings.commuLingoViews.docs.clearSearch,
            resultOne: strings.commuLingoViews.docs.documentFound,
            resultMany: strings.commuLingoViews.docs.documentsFound,
            emptyLabel: strings.commuLingoViews.docs.noReferenceDocumentsFound
        }) %>
        <%
        // Kind options and the pager are links so the list works without script;
        // Search and pagination fetch only the requested page of cards.
        %>
        <div class="commu-people-filterbar commu-dict-facets">
            <%- include('../partials/commulingo-dict-facet', {
                title: strings.commuLingoViews.docs.kind, ariaLabel: strings.commuLingoViews.docs.filterByKind,
                target: '#commu-doc-list', allLabel: strings.commuLingoViews.docs.all,
                allCount: docs.length, allHref: '/commulingo/docs', selected: kind || '',
                options: facets.map(function(facet) {
                    return { value: facet.id, label: facet.label, count: facet.count,
                        href: '/commulingo/docs?kind=' + encodeURIComponent(facet.id) };
                }) }) %>
        </div>
        <section class="commu-event-grid" id="commu-doc-list" data-search-endpoint="/commulingo/docs/search" data-page="<%= pagination.current %>"
            aria-label="<%= strings.commuLingoViews.docs.referenceDocuments %>">
            <%- include('../partials/commulingo-docs-cards', { docs: pagination.pageItems }) %>
        </section>
        <%- include('../partials/commulingo-list-pager', { pagination: pagination, target: '#commu-doc-list', en: en }) %>
    </main>
    <%- include('../partials/footer') %>
    <script src="/js/commulingo-search-utils.js?v=<%= assetVersion %>"></script>
    <script src="/js/commulingo-dict-search.js?v=<%= assetVersion %>"></script>
</body>
</html>
