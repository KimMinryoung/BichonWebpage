<!DOCTYPE html>
<html lang="<%= lang %>">
<head><%- include('../partials/head') %></head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>
    <% var en = lang === 'en'; %>
    <main class="container commulingo-shell commu-docs-page" data-lang="<%= lang %>">
        <a class="commu-back-link" href="/commulingo">← <%= en ? 'CommuLingo' : '공산링고' %></a>
        <%- include('../partials/commulingo-dict-nav', { active: 'docs' }) %>
        <h1 class="commu-sr-only"><%= en ? 'Reference Library' : '참고 문헌' %></h1>
        <section class="commu-event-grid" aria-label="<%= en ? 'Reference documents' : '참고 문헌 목록' %>">
            <% docs.forEach(function(doc) { %>
            <a class="commu-event-card" href="/commulingo/docs/<%= doc.id %>">
                <span class="commu-event-period"><%= doc.kind %></span>
                <h2><%= doc.title %></h2>
                <p><%= doc.description %></p>
                <span class="commu-event-card-link"><%= en ? 'Read the full text →' : '전문 읽기 →' %></span>
            </a>
            <% }) %>
        </section>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
