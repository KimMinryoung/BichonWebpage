<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>

    <main class="container commulingo-shell commu-person-hub-page" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [
                { label: strings.commuLingoViews.office.people, href: '/commulingo/people' },
                { label: strings.commuLingoViews.office.lineages },
            ],
            dictJump: 'people' }) %>

        <header class="commu-hub-head">
            <div>
                <h1><%= strings.commuLingoViews.office.lineages %></h1>
                <p><%= strings.commuLingoViews.office.lineagesIntro %></p>
            </div>
        </header>

        <div class="commu-office-index">
            <%- include('../partials/commulingo-office-index', { bodies: bodies, offices: offices, sectionTitles: strings.commuLingoViews.office.sections }) %>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
