<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <%- include('../partials/library-tabs', { active: 'reports' }) %>

        <% if (typeof showTasks !== 'undefined' && showTasks) { %>
        <div class="report-tabs">
            <button type="button" class="report-tab active" data-tab="research"><%= lang === 'ko' ? '리서치' : 'Research' %></button>
            <button type="button" class="report-tab" data-tab="tasks"><%= lang === 'ko' ? '태스크' : 'Tasks' %></button>
        </div>
        <% } %>

        <!-- Research panel -->
        <div class="report-panel active" id="panel-research">
            <% const researchFeedFailed = typeof feedFailed !== 'undefined' && feedFailed; %>
            <% if (researchFeedFailed && researchItems && researchItems.length > 0) { %>
                <div class="box" role="status"><p><%= strings.public.partlyUnavailable %></p></div>
            <% } %>
            <%- include('../partials/library-search', { section: 'reports' }) %>
            <% if (researchItems.length === 0 && (researchFeedFailed || !searchValue)) { %>
                <div class="box">
                    <p><%= researchFeedFailed ? strings.public.listUnavailable : (lang === 'ko' ? '아직 리서치가 없습니다.' : 'No research reports yet.') %></p>
                </div>
            <% } %>
            <ul class="post-list library-list" id="library-list" data-search-endpoint="/reports/search" data-page="<%= researchPagination.current %>">
                <%- include('../partials/library-report-items', { researchItems: researchItems }) %>
            </ul>
            <%- include('../partials/commulingo-list-pager', { pagination: researchPagination, target: '#library-list' }) %>
        </div>

        <!-- Task reports panel — admin-only -->
        <% if (typeof showTasks !== 'undefined' && showTasks) { %>
        <div class="report-panel" id="panel-tasks">
            <% if (reports && reports.length > 0) { %>
                <ul class="post-list">
                    <% reports.forEach(report => {
                        var _lines = (report.result || '').split('\n');
                        var _title = '';
                        for (var _i = 0; _i < _lines.length; _i++) {
                            var _m = _lines[_i].match(/^#\s+(.+)/);
                            if (_m) { _title = _m[1]; break; }
                        }
                        if (!_title) _title = report.content.split('\n')[0];
                    %>
                        <li class="post-item">
                            <div>
                                <h2><a href="/reports/<%= report.id %>"><%= _title %></a></h2>
                                <div class="post-meta">
                                    <span class="report-id">#<%= report.id %></span>
                                    <time class="local-date" datetime="<%= new Date(report.completed_at).toISOString() %>" data-suffix="<%= lang === 'ko' ? '에 보고' : ', reported' %>"></time>
                                </div>
                                <% if (report.result) { %>
                                    <p class="post-excerpt"><%= report.result.replace(/[#*_`\-|>]/g, '').replace(/\n+/g, ' ').substring(0, 200) %>...</p>
                                <% } %>
                            </div>
                        </li>
                    <% }) %>
                </ul>

                <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                    <%- include('../partials/pagination', {
                        currentPage: currentPage,
                        totalPages: totalPages,
                        baseUrl: paginationBase
                    }) %>
                <% } %>
            <% } else { %>
                <div class="box">
                    <p><%= lang === 'ko' ? '아직 완료된 보고서가 없습니다.' : 'No completed reports yet.' %></p>
                </div>
            <% } %>
        </div>
        <% } %>
    </div>

    <%- include('../partials/footer') %>
    <script src="/js/commulingo-search-utils.js?v=<%= assetVersion %>"></script>
    <script src="/js/commulingo-dict-search.js?v=<%= assetVersion %>"></script>
    <script>
    (function() {
        var tabs = document.querySelectorAll('.report-tab');
        var panels = document.querySelectorAll('.report-panel');
        var storageKey = 'reportTab';

        function activate(tabName) {
            tabs.forEach(function(t) {
                t.classList.toggle('active', t.getAttribute('data-tab') === tabName);
            });
            panels.forEach(function(p) {
                p.classList.toggle('active', p.id === 'panel-' + tabName);
            });
        }

        // Restore saved tab
        var saved = localStorage.getItem(storageKey);
        if (saved && document.getElementById('panel-' + saved)) {
            activate(saved);
        }

        tabs.forEach(function(tab) {
            tab.addEventListener('click', function() {
                var name = this.getAttribute('data-tab');
                activate(name);
                localStorage.setItem(storageKey, name);
            });
        });
    })();
    </script>
</body>
</html>
