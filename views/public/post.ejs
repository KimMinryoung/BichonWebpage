<!DOCTYPE html>
<html lang="ko">
<head>
    <% pageTitle = post.title %>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <article class="post-content">
            <h1><%= post.title %></h1>
            <div class="post-meta">
                <%= new Date(post.created_at).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' }) %><%= strings.public.postedAt %>
                <% if (post.updated_at && post.updated_at > post.created_at) { %>
                    | <%= new Date(post.updated_at).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' }) %><%= strings.public.updatedAt %>
                <% } %>
            </div>
            <div class="post-body">
<%= post.content %>
            </div>
        </article>

        <div class="box" style="margin-top: 20px;">
            <a href="/">&larr; <%= strings.public.backToList %></a>
            <% if (isAuthenticated) { %>
                | <a href="/admin/posts/edit/<%= post.id %>"><%= strings.admin.edit %></a>
            <% } %>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
