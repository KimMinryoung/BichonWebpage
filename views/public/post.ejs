<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head', { pageTitle: post.title }) %>
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <%- include('../partials/library-tabs', { active: 'posts' }) %>
        <article class="post-content">
            <h1><%= post.title %></h1>
            <div class="post-meta">
                <time class="local-date" datetime="<%= new Date(post.created_at).toISOString() %>" data-suffix="<%= strings.public.postedAt %>"></time>
                <% if (post.updated_at && post.updated_at > post.created_at) { %>
                    | <time class="local-date" datetime="<%= new Date(post.updated_at).toISOString() %>" data-suffix="<%= strings.public.updatedAt %>"></time>
                <% } %>
            </div>
            <div class="post-body">
                <%- typeof contentHtml !== 'undefined' ? contentHtml : sanitizePost(post.content).replace(/\n/g, '<br>') %>
            </div>
        </article>

        <div class="box ui-action-bar post-nav">
            <div class="ui-action-bar-start post-nav-left">
                <a class="btn btn-small" href="/">&larr; <%= strings.public.backToList %></a>
                <% if (isAuthenticated) { %>
                    <a class="btn btn-small" href="/admin/posts/edit/<%= post.id %>"><%= strings.admin.edit %></a>
                <% } %>
            </div>
            <div class="ui-action-bar-end post-nav-right">
                <% if (prevId) { %>
                    <a href="/post/<%= prevId %>" class="btn btn-small">&larr; <%= strings.public.prevPost %></a>
                <% } %>
                <% if (nextId) { %>
                    <a href="/post/<%= nextId %>" class="btn btn-small"><%= strings.public.nextPost %> &rarr;</a>
                <% } %>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
