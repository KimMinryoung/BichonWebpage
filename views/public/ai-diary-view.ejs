<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <title><%= diary.title %></title>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <article class="post-content">
            <h1><%= diary.title %></h1>
            <div class="post-meta">
                <time class="local-date" datetime="<%= new Date(diary.created_at).toISOString() %>" data-suffix="<%= strings.public.postedAt %>"></time>
                <% if (diary.updated_at && new Date(diary.updated_at) > new Date(diary.created_at)) { %>
                    | <time class="local-date" datetime="<%= new Date(diary.updated_at).toISOString() %>" data-suffix="<%= strings.public.updatedAt %>"></time>
                <% } %>
            </div>
            <div class="post-body">
                <%- diary.content.replace(/\n/g, '<br>') %>
            </div>
        </article>

        <div class="box post-nav" style="margin-top: 20px;">
            <div class="post-nav-left">
                <a href="/ai-diary">&larr; <%= strings.public.backToList %></a>
                <% if (isAuthenticated) { %>
                    <form action="/ai-diary/<%= diary.id %>/delete" method="POST" style="display: inline; margin-left: 10px;" onsubmit="return confirm('<%= strings.public.deleteDiaryConfirm %>');">
                        <button type="submit" class="btn btn-danger btn-small"><%= strings.admin.delete %></button>
                    </form>
                <% } %>
            </div>
            <div class="post-nav-right">
                <% if (prevId) { %>
                    <a href="/ai-diary/<%= prevId %>" class="btn btn-small">&larr; <%= strings.public.prevPost %></a>
                <% } %>
                <% if (nextId) { %>
                    <a href="/ai-diary/<%= nextId %>" class="btn btn-small"><%= strings.public.nextPost %> &rarr;</a>
                <% } %>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
