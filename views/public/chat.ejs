<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.6/purify.min.js"></script>
    <meta name="api-url" content="<%= chatApiUrl %>">
    <meta name="str-thinking" content="<%= strings.chat.thinking %>">
    <meta name="str-error" content="<%= strings.chat.error %>">
    <meta name="str-not-saved" content="<%= strings.chat.notSaved %>">
    <meta name="str-retry" content="<%= strings.chat.retry %>">
    <meta name="str-persona-label" content="<%= strings.chat.personaLabel %>">
    <meta name="str-feedback-saved" content="<%= strings.chat.feedbackSaved %>">
    <meta name="str-feedback-error" content="<%= strings.chat.feedbackError %>">
    <meta name="str-feedback-note" content="<%= strings.chat.feedbackNote %>">
    <meta name="str-feedback-save" content="<%= strings.chat.feedbackSave %>">
    <meta name="str-regenerate" content="<%= strings.chat.regenerate %>">
    <meta name="str-regenerating" content="<%= strings.chat.regenerating %>">
</head>
<body>
    <script src="/js/chat-viewport.js?v=<%= assetVersion %>"></script>
    <div class="chat-page">
        <%- include('../partials/nav') %>

        <div class="container">
            <header class="box compact-header">
                <div class="header-actions">
                    <select id="personaSelector" class="persona-select" aria-label="<%= strings.chat.personaLabel %>" hidden></select>
                    <button type="button" class="btn btn-secondary" id="newChatBtn"><%= strings.public.chatNew %></button>
                    <button type="button" class="btn btn-secondary" id="historyBtn"><%= strings.public.chatHistory %></button>
                </div>
            </header>

            <div class="chat-box" id="chatBox" data-empty-hint="<%= strings.chat.emptyHint %>"></div>

            <div class="chat-feedback-bar" id="chatFeedbackBar" hidden>
                <select id="feedbackTone" aria-label="tone feedback"></select>
                <input
                    type="text"
                    id="feedbackNote"
                    maxlength="500"
                    placeholder="<%= strings.chat.feedbackNote %>"
                    autocomplete="off"
                />
                <button type="button" id="feedbackSave"><%= strings.chat.feedbackSave %></button>
                <button type="button" id="feedbackRegenerate"><%= strings.chat.regenerate %></button>
                <span class="chat-feedback-status" id="feedbackStatus"></span>
            </div>

            <form class="chat-input-row" id="chatForm">
                <textarea
                    id="chatInput"
                    placeholder="<%= strings.chat.placeholder %>"
                    aria-label="<%= strings.chat.inputLabel %>"
                    title="<%= strings.chat.inputHint %>"
                    autocomplete="off"
                    rows="1"
                ></textarea>
                <button type="submit" class="btn btn-primary" id="chatSend">
                    <%= strings.chat.send %>
                </button>
            </form>
        </div>
    </div>

    <script src="/js/common.js?v=<%= assetVersion %>"></script>
    <script src="/js/chat.js?v=<%= assetVersion %>"></script>
</body>
</html>
