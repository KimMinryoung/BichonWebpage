<!DOCTYPE html>
<html lang="ko">
<head>
    <%- include('../partials/head') %>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.6/purify.min.js"></script>
</head>
<body class="chat-page">
    <script>
        // window.innerHeight correctly excludes the browser toolbar on mobile.
        // Run before layout to avoid a flash of incorrect height.
        function setVH() {
            var vv = window.visualViewport;
            var h = vv ? vv.height : window.innerHeight;
            document.documentElement.style.setProperty('--vh', h + 'px');
        }

        // Measure the system nav bar height once at startup, before keyboard ever appears.
        // On Android with gesture nav overlay, window.innerHeight includes the gesture area
        // while visualViewport.height excludes it — the gap is the nav bar height.
        // Only update on orientation change (not on resize, which fires when keyboard opens).
        function initSafeBottom() {
            var vv = window.visualViewport;
            if (vv) {
                var gap = Math.max(0, window.innerHeight - vv.height);
                document.documentElement.style.setProperty('--safe-bottom', gap + 'px');
            }
        }

        setVH();
        initSafeBottom();
        (window.visualViewport || window).addEventListener('resize', setVH);
        window.addEventListener('orientationchange', function() { setVH(); initSafeBottom(); });
    </script>
    <%- include('../partials/nav') %>

    <div class="container">
        <header class="box compact-header">
            <h1><%= strings.chat.title %></h1>
        </header>

        <div class="chat-box" id="chatBox"></div>

        <form class="chat-input-row" id="chatForm">
            <input
                type="text"
                id="chatInput"
                placeholder="<%= strings.chat.placeholder %>"
                autocomplete="off"
            />
            <button type="submit" class="btn btn-primary" id="chatSend">
                <%= strings.chat.send %>
            </button>
        </form>
    </div>

    <%- include('../partials/footer') %>

    <script>
        var API_URL = '<%= chatApiUrl %>';
        var STRINGS = {
            thinking: '<%= strings.chat.thinking %>',
            error: '<%= strings.chat.error %>'
        };
    </script>
    <script src="/js/chat.js"></script>
</body>
</html>
