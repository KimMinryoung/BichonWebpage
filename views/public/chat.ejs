<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
    <%# marked/DOMPurify are only invoked during streaming, long after load;
        defer keeps them off the parser without changing that. chat.js defers
        after them in document order. %>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <script src="https://cdn.jsdelivr.net/npm/marked@15.0.12/marked.min.js" integrity="sha384-948ahk4ZmxYVYOc+rxN1H2gM1EJ2Duhp7uHtZ4WSLkV4Vtx5MUqnV+l7u9B+jFv+" crossorigin="anonymous" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.6/purify.min.js" integrity="sha384-cwS6YdhLI7XS60eoDiC+egV0qHp8zI+Cms46R0nbn8JrmoAzV9uFL60etMZhAnSu" crossorigin="anonymous" defer></script>
    <meta name="api-url" content="<%= chatApiUrl %>">
    <%# Every string chat.js shows, in the page language. type=application/json
        is data, not script, so the CSP does not apply to it. %>
    <script type="application/json" id="chatStrings"><%- jsonLdScript(strings.chat) %></script>
</head>
<body>
    <script src="/js/chat-viewport.js?v=<%= assetVersion %>"></script>
    <div class="chat-page nav-collapsed">
        <div class="chat-topbar">
            <button
                type="button"
                class="chat-nav-toggle"
                id="chatNavToggle"
                aria-expanded="false"
                aria-controls="chatNavGroup"
                aria-label="<%= strings.siteName %>"
            >
                <span class="chat-nav-toggle-icon" aria-hidden="true"></span>
            </button>
            <select id="personaSelector" class="persona-select" aria-label="<%= strings.chat.personaLabel %>" hidden></select>
            <button type="button" class="btn btn-secondary" id="newChatBtn"><%= strings.public.chatNew %></button>
            <button type="button" class="btn btn-secondary" id="historyBtn"><%= strings.public.chatHistory %></button>
        </div>
        <div class="chat-nav-group" id="chatNavGroup">
            <%- include('../partials/nav', { outageNoticeElsewhere: true }) %>
        </div>
        <%- include('../partials/site-notice') %>

        <div class="container">
            <%# role=log reads each new message once; chat.js holds aria-busy
                while an answer streams so it is read whole, not chunk by chunk. %>
            <div class="chat-box" id="chatBox" role="log" aria-live="polite" aria-relevant="additions"
                 data-empty-hint="<%= withPersona(strings.chat.emptyHint, strings.chat.defaultPersonaName) %>"
                 data-empty-hint-template="<%= strings.chat.emptyHint %>"></div>
            <%# Shown only while the box is empty (CSS); a row sends its question. %>
            <div class="chat-starters" id="chatStarters" role="group" aria-label="<%= strings.chat.startersLabel %>">
                <% strings.chat.starters.forEach(function (question) { %>
                <button type="button" class="chat-starter"><%= question %></button>
                <% }); %>
            </div>
            <button type="button" class="chat-jump" id="chatJump" hidden><%= strings.chat.jumpLatest %></button>

            <div class="chat-feedback-bar collapsed" id="chatFeedbackBar" hidden>
                <button
                    type="button"
                    class="chat-feedback-toggle"
                    id="feedbackToggle"
                    aria-expanded="false"
                    aria-controls="feedbackControls"
                ><%= strings.chat.feedbackToggle %></button>
                <div class="chat-feedback-controls" id="feedbackControls">
                    <select id="feedbackTone" aria-label="tone feedback"></select>
                    <input
                        type="text"
                        id="feedbackNote"
                        maxlength="500"
                        placeholder="<%= strings.chat.feedbackNote %>"
                        autocomplete="off"
                    />
                    <button type="button" id="feedbackSave"><%= strings.chat.feedbackSave %></button>
                    <button type="button" id="feedbackRegenerate"><%= strings.chat.regenerate %></button>
                    <span class="chat-feedback-status" id="feedbackStatus"></span>
                </div>
            </div>

            <div class="chat-input-count" id="chatInputCount" aria-live="polite" hidden></div>
            <form class="chat-input-row" id="chatForm">
                <textarea
                    id="chatInput"
                    maxlength="8000"
                    placeholder="<%= strings.chat.placeholder %>"
                    aria-label="<%= strings.chat.inputLabel %>"
                    title="<%= strings.chat.inputHint %>"
                    autocomplete="off"
                    rows="1"
                ></textarea>
                <button type="submit" class="btn btn-primary" id="chatSend">
                    <%= strings.chat.send %>
                </button>
            </form>
        </div>
    </div>

    <script src="/js/common.js?v=<%= assetVersion %>"></script>
    <script src="/js/chat.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
