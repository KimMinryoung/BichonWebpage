<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.6/purify.min.js"></script>
    <meta name="api-url" content="<%= chatApiUrl %>">
    <meta name="str-thinking" content="<%= strings.chat.thinking %>">
    <meta name="str-error" content="<%= strings.chat.error %>">
    <meta name="str-disconnect" content="<%= strings.chat.disconnectError %>">
</head>
<body>
    <script src="/js/chat-viewport.js?v=<%= Date.now() %>"></script>
    <div class="chat-page">
        <%- include('../partials/nav') %>

        <div class="container">
            <header class="box compact-header">
                <h1><%= strings.chat.title %></h1>
                <button type="button" class="btn btn-secondary" id="historyBtn"><%= strings.public.chatHistory %></button>
            </header>

            <div class="chat-box" id="chatBox"></div>

            <form class="chat-input-row" id="chatForm">
                <input
                    type="text"
                    id="chatInput"
                    placeholder="<%= strings.chat.placeholder %>"
                    autocomplete="off"
                />
                <button type="submit" class="btn btn-primary" id="chatSend">
                    <%= strings.chat.send %>
                </button>
            </form>
        </div>
    </div>

    <script src="/js/common.js?v=<%= Date.now() %>"></script>
    <script src="/js/chat.js?v=<%= Date.now() %>"></script>
</body>
</html>
