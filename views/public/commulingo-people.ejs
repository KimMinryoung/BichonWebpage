<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>

    <%
    var en = lang === 'en';
    %>
    <main class="container commulingo-shell commu-people-shell" data-lang="<%= lang %>">
        <a class="commu-back-link" href="/commulingo">← <%= strings.commuLingo.backToBooks %></a>
        <a class="commu-events-cta" href="/commulingo/events"><span aria-hidden="true">◉</span> <%= en ? "Explore historical events →" : "역사 사건 둘러보기 →" %></a>

        <header class="box commulingo-hero commulingo-hero--graph">
            <div>
                <h1><%= en ? 'People of the Revolution and the USSR' : '인물 사전: 혁명과 소련의 사람들' %></h1>
            </div>
        </header>

        <div class="commu-people-search">
            <span class="commu-people-search-icon" aria-hidden="true">⌕</span>
            <input type="search" id="commu-people-search-input" class="commu-people-search-input"
                placeholder="<%= en ? 'Search by name, alias, role, or bio…' : '이름 · 별칭 · 역할 · 설명으로 검색…' %>"
                autocomplete="off" spellcheck="false"
                aria-label="<%= en ? 'Search people' : '인물 검색' %>">
            <button type="button" id="commu-people-search-clear" class="commu-people-search-clear" aria-label="<%= en ? 'Clear search' : '검색 지우기' %>" hidden>×</button>
        </div>

        <div class="commu-people-results" id="commu-people-results" hidden>
            <section class="commu-people-result-section" id="commu-people-result-name" hidden>
                <div class="commu-people-result-head">
                    <span class="commu-people-result-label"><%= en ? 'Name matches' : '이름 일치' %></span>
                    <span class="commu-people-result-count" id="commu-people-result-name-count"></span>
                </div>
                <div class="commu-people-grid" id="commu-people-result-name-grid"></div>
            </section>
            <section class="commu-people-result-section" id="commu-people-result-desc" hidden>
                <div class="commu-people-result-head">
                    <span class="commu-people-result-label"><%= en ? 'Mentioned in description' : '설명에서 언급됨' %></span>
                    <span class="commu-people-result-count" id="commu-people-result-desc-count"></span>
                </div>
                <div class="commu-people-grid" id="commu-people-result-desc-grid"></div>
            </section>
            <p class="commu-people-result-empty" id="commu-people-result-empty" role="status" aria-live="polite" hidden><%= en ? 'No people found' : '검색 결과가 없습니다' %></p>
        </div>

        <% var officesList = (typeof offices !== 'undefined' && offices) || []; %>
        <% var roleCategoriesList = (typeof roleCategories !== 'undefined' && roleCategories) || []; %>
        <% if (officesList.length || roleCategoriesList.length) { %>
        <details class="commu-office-index" aria-label="<%= en ? 'People categories and Soviet institution leadership timelines' : '인물 분류와 소련 기관별 지도부 타임라인' %>">
            <summary class="commu-office-index-head">
                <span class="commu-people-range">INDEX</span>
                <h2><%= en ? 'People Categories and Soviet Institution Timelines' : '인물 분류와 소련 기관별 지도부' %></h2>
            </summary>
            <div class="commu-office-grid">
                <% roleCategoriesList.forEach(function(category) { %>
                <a class="commu-office-card commu-role-category-link" href="/commulingo/roles/<%= category.id %>">
                    <span class="commu-office-icon-link" aria-hidden="true"><%- roleIconSvg(category.icon) %></span>
                    <span class="commu-role-category-copy">
                        <h3><%= category.label %></h3>
                        <p><%= category.peopleCount %> <%= en ? (category.peopleCount === 1 ? 'person' : 'people') : '명' %></p>
                    </span>
                    <span class="commu-role-category-arrow" aria-hidden="true">→</span>
                </a>
                <% }) %>
                <% officesList.forEach(function(office) { %>
                <details class="commu-office-card is-<%= office.id %>" id="office-<%= office.id %>">
                    <summary class="commu-office-card-head">
                        <a class="commu-office-icon-link" href="/commulingo/offices/<%= office.id %>" title="<%= office.title %>" aria-label="<%= en ? 'Open ' + office.title + ' page' : office.title + ' 기관 페이지 열기' %>" onclick="event.stopPropagation()"><%- roleIconSvg(office.icon) %></a>
                        <span class="commu-office-range"><%= office.range %></span>
                        <h3><%= office.title %></h3>
                        <p><%= office.blurb %></p>
                    </summary>
                    <ol class="commu-office-rows">
                        <% office.rows.forEach(function(row) { %>
                        <li>
                            <span class="commu-office-years"><%= row.years %></span>
                            <span class="commu-office-main">
                                <% if (row.personId) { %>
                                <a href="#p-<%= row.personId %>"><%= row.name %></a>
                                <% } else { %>
                                <strong><%= row.name %></strong>
                                <% } %>
                                <small><%= row.body %></small>
                                <% if (row.note) { %><em><%= row.note %></em><% } %>
                            </span>
                        </li>
                        <% }) %>
                    </ol>
                    <a class="commu-office-page-link" href="/commulingo/offices/<%= office.id %>"><%= en ? 'Office page →' : '기관 페이지 →' %></a>
                </details>
                <% }) %>
            </div>
        </details>
        <% } %>

        <%
        // Standalone groups sit outside the Soviet/Russian era sequence and
        // render at the end under their own section heading.
        var standaloneGroupIds = ['international-revolutionary'];
        var orderedGroups = groups.filter(function(g) { return standaloneGroupIds.indexOf(g.id) === -1; })
            .concat(groups.filter(function(g) { return standaloneGroupIds.indexOf(g.id) !== -1; }));
        var standaloneHeadPrinted = false;
        %>
        <% orderedGroups.forEach(function(group) { %>
        <% if (!standaloneHeadPrinted && standaloneGroupIds.indexOf(group.id) !== -1) { standaloneHeadPrinted = true; %>
        <h2 class="commu-people-standalone-head"><%= en ? 'Revolutionaries beyond the Soviet Union' : '소련 밖의 혁명가들' %></h2>
        <% } %>
        <details class="commu-people-group is-<%= group.id %>">
            <summary class="commu-people-group-head">
                <span class="commu-people-range"><%= group.range %></span>
                <h2><%= group.title %></h2>
                <p><%= group.blurb %></p>
            </summary>
            <div class="commu-people-grid">
                <% group.people.forEach(function(person) { %>
                <%- include('../partials/commulingo-person-card', { person: person, groupId: group.id, en: en, roleIconSvg: roleIconSvg, roleHubHref: roleHubHref }) %>
                <% }) %>
            </div>
        </details>
        <% }) %>
    </main>

    <%- include('../partials/footer') %>
    <script>
        // Highlight the card targeted by the URL hash (arriving from a book's name link).
        (function() {
            function focusHash() {
                var hash = window.location.hash;
                if (!hash) return;
                if (hash.indexOf('#office-') === 0) {
                    var office = document.getElementById(hash.slice(1));
                    var officeIndex = document.querySelector('details.commu-office-index');
                    if (officeIndex) officeIndex.open = true;
                    if (office && office.tagName === 'DETAILS') {
                        office.open = true;
                        window.requestAnimationFrame(function() {
                            office.scrollIntoView({ block: 'start' });
                        });
                    }
                    return;
                }
                if (hash.indexOf('#p-') !== 0) return;
                var card = document.getElementById(hash.slice(1));
                if (!card) return;
                var group = card.closest('details.commu-people-group');
                if (group) group.open = true;
                document.querySelectorAll('.commu-person-card.is-focused').forEach(function(el) {
                    el.classList.remove('is-focused');
                });
                card.classList.add('is-focused');
                window.requestAnimationFrame(function() {
                    card.scrollIntoView({ block: 'start' });
                });
            }
            window.addEventListener('hashchange', focusHash);
            focusHash();
        })();
    </script>
    <script>
        // Live person search. Each card carries `data-name` (identity: name,
        // aliases, cyrillic) and `data-desc` (prose: epithet, moment, bio).
        // Matching is AND across whitespace-separated terms. Results split into
        // two buckets: name matches on top, people merely mentioned in a
        // description below. Matched cards are physically moved into the result
        // grids and moved back on clear (browse groups hide while searching).
        (function() {
            var input = document.getElementById('commu-people-search-input');
            var clearBtn = document.getElementById('commu-people-search-clear');
            if (!input) return;
            var en = <%- en ? 'true' : 'false' %>;
            var results = document.getElementById('commu-people-results');
            var nameSection = document.getElementById('commu-people-result-name');
            var descSection = document.getElementById('commu-people-result-desc');
            var nameGrid = document.getElementById('commu-people-result-name-grid');
            var descGrid = document.getElementById('commu-people-result-desc-grid');
            var nameCount = document.getElementById('commu-people-result-name-count');
            var descCount = document.getElementById('commu-people-result-desc-count');
            var emptyMsg = document.getElementById('commu-people-result-empty');
            var cards = Array.prototype.slice.call(document.querySelectorAll('.commu-person-card[data-name]'));
            var groups = Array.prototype.slice.call(document.querySelectorAll('details.commu-people-group'));
            var chrome = Array.prototype.slice.call(document.querySelectorAll(
                'details.commu-office-index, .commu-people-standalone-head'));
            // Remember each card's home so search can restore browse order.
            var origin = cards.map(function(card) { return { card: card, parent: card.parentNode }; });

            function countText(n) {
                if (en) return n + (n === 1 ? ' person' : ' people');
                return n + '명';
            }

            function homeAllCards() {
                origin.forEach(function(o) { o.parent.appendChild(o.card); });
            }

            function reset() {
                homeAllCards();
                results.hidden = true;
                groups.forEach(function(group) { group.hidden = false; group.open = false; });
                chrome.forEach(function(el) { el.hidden = false; });
                clearBtn.hidden = true;
            }

            function apply(query) {
                var terms = query.split(/\s+/).filter(Boolean);
                if (!terms.length) { reset(); return; }
                homeAllCards();
                clearBtn.hidden = false;
                groups.forEach(function(group) { group.hidden = true; });
                chrome.forEach(function(el) { el.hidden = true; });

                var nameHits = [];
                var descHits = [];
                cards.forEach(function(card) {
                    var nameHay = card.getAttribute('data-name') || '';
                    var isName = terms.every(function(term) { return nameHay.indexOf(term) !== -1; });
                    if (isName) { nameHits.push(card); return; }
                    var combined = nameHay + ' ' + (card.getAttribute('data-desc') || '');
                    var isDesc = terms.every(function(term) { return combined.indexOf(term) !== -1; });
                    if (isDesc) descHits.push(card);
                });
                nameHits.forEach(function(card) { nameGrid.appendChild(card); });
                descHits.forEach(function(card) { descGrid.appendChild(card); });

                nameSection.hidden = nameHits.length === 0;
                descSection.hidden = descHits.length === 0;
                nameCount.textContent = countText(nameHits.length);
                descCount.textContent = countText(descHits.length);
                emptyMsg.hidden = (nameHits.length + descHits.length) > 0;
                results.hidden = false;
            }

            var raf = null;
            function onInput() {
                if (raf) cancelAnimationFrame(raf);
                raf = requestAnimationFrame(function() { apply(input.value.trim().toLowerCase()); });
            }
            input.addEventListener('input', onInput);
            input.addEventListener('keydown', function(event) {
                if (event.key === 'Escape' && input.value) {
                    event.preventDefault();
                    input.value = '';
                    reset();
                } else if (event.key === 'Enter') {
                    // Jump straight to the first name match.
                    var first = nameGrid.querySelector('.commu-person-card[data-person-href]')
                        || descGrid.querySelector('.commu-person-card[data-person-href]');
                    if (first) window.location.href = first.getAttribute('data-person-href');
                }
            });
            clearBtn.addEventListener('click', function() {
                input.value = '';
                reset();
                input.focus();
            });
            // Restore filtering if the browser repopulates the field on back-nav.
            if (input.value.trim()) apply(input.value.trim().toLowerCase());
        })();
    </script>
    <%- include('../partials/commulingo-person-card-click-script') %>
</body>
</html>
