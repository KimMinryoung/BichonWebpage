<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>

    <%
    var en = lang === 'en';
    %>
    <main class="container commulingo-shell commu-people-shell" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [{ label: en ? 'People' : '인물 사전' }],
            dictJump: 'people' }) %>

        <h1 class="commu-sr-only"><%= en ? 'People of the Revolution and the USSR' : '인물 사전: 혁명과 소련의 사람들' %></h1>

        <div class="commu-people-search">
            <span class="commu-people-search-icon" aria-hidden="true">⌕</span>
            <input type="search" id="commu-people-search-input" class="commu-people-search-input"
                placeholder="<%= en ? 'Search by name, alias, role, or bio…' : '이름 · 별칭 · 역할 · 설명으로 검색…' %>"
                autocomplete="off" spellcheck="false"
                aria-label="<%= en ? 'Search people' : '인물 검색' %>">
            <button type="button" id="commu-people-search-clear" class="commu-people-search-clear" aria-label="<%= en ? 'Clear search' : '검색 지우기' %>" hidden>×</button>
        </div>

        <div class="commu-people-results" id="commu-people-results" hidden>
            <section class="commu-people-result-section" id="commu-people-result-name" hidden>
                <div class="commu-people-result-head">
                    <span class="commu-people-result-label"><%= en ? 'Name matches' : '이름 일치' %></span>
                    <span class="commu-people-result-count" id="commu-people-result-name-count"></span>
                </div>
                <div class="commu-people-grid" id="commu-people-result-name-grid"></div>
            </section>
            <section class="commu-people-result-section" id="commu-people-result-role" hidden>
                <div class="commu-people-result-head">
                    <span class="commu-people-result-label"><%= en ? 'Role matches' : '역할 일치' %></span>
                    <span class="commu-people-result-count" id="commu-people-result-role-count"></span>
                </div>
                <div class="commu-people-grid" id="commu-people-result-role-grid"></div>
            </section>
            <section class="commu-people-result-section" id="commu-people-result-desc" hidden>
                <div class="commu-people-result-head">
                    <span class="commu-people-result-label"><%= en ? 'Mentioned in description' : '설명에서 언급됨' %></span>
                    <span class="commu-people-result-count" id="commu-people-result-desc-count"></span>
                </div>
                <div class="commu-people-grid" id="commu-people-result-desc-grid"></div>
            </section>
            <p class="commu-people-result-empty" id="commu-people-result-empty" role="status" aria-live="polite" hidden><%= en ? 'No people found' : '검색 결과가 없습니다' %></p>
        </div>

        <% var officesList = (typeof offices !== 'undefined' && offices) || []; %>
        <% var roleCategoriesList = (typeof roleCategories !== 'undefined' && roleCategories) || []; %>
        <% if (officesList.length || roleCategoriesList.length) { %>
        <details class="commu-office-index" aria-label="<%= en ? 'People categories and Soviet institution leadership timelines' : '인물 분류와 소련 기관별 지도부 타임라인' %>">
            <summary class="commu-office-index-head">
                <span class="commu-people-range">INDEX</span>
                <h2><%= en ? 'People Categories and Soviet Institution Timelines' : '인물 분류와 소련 기관별 지도부' %></h2>
            </summary>
            <div class="commu-office-grid">
                <% roleCategoriesList.forEach(function(category) { %>
                <a class="commu-office-card commu-role-category-link" href="/commulingo/roles/<%= category.id %>">
                    <span class="commu-office-icon-link" aria-hidden="true"><%- roleIconSvg(category.icon) %></span>
                    <span class="commu-role-category-copy">
                        <h3><%= category.label %></h3>
                        <p><%= category.peopleCount %> <%= en ? (category.peopleCount === 1 ? 'person' : 'people') : '명' %></p>
                    </span>
                    <span class="commu-role-category-arrow" aria-hidden="true">→</span>
                </a>
                <% }) %>
                <% officesList.forEach(function(office) { %>
                <details class="commu-office-card is-<%= office.id %>" id="office-<%= office.id %>">
                    <summary class="commu-office-card-head">
                        <a class="commu-office-icon-link" href="/commulingo/offices/<%= office.id %>" title="<%= office.title %>" aria-label="<%= en ? 'Open ' + office.title + ' page' : office.title + ' 기관 페이지 열기' %>" onclick="event.stopPropagation()"><%- roleIconSvg(office.icon) %></a>
                        <span class="commu-office-range"><%= office.range %></span>
                        <h3><%= office.title %></h3>
                        <p><%= office.blurb %></p>
                    </summary>
                    <ol class="commu-office-rows">
                        <% office.rows.forEach(function(row) { %>
                        <li>
                            <span class="commu-office-years"><%= row.years %></span>
                            <span class="commu-office-main">
                                <% if (row.personId) { %>
                                <a href="#p-<%= row.personId %>"><%= row.name %></a>
                                <% } else { %>
                                <strong><%= row.name %></strong>
                                <% } %>
                                <small><%= row.body %></small>
                                <% if (row.note) { %><em><%= row.note %></em><% } %>
                            </span>
                        </li>
                        <% }) %>
                    </ol>
                    <a class="commu-office-page-link" href="/commulingo/offices/<%= office.id %>"><%= en ? 'Office page →' : '기관 페이지 →' %></a>
                </details>
                <% }) %>
            </div>
        </details>
        <% } %>

        <%
        // Group shells only — the card grids (~8MB of markup) load per group
        // from /commulingo/people/cards?group=<id> when a group is opened or a
        // search begins. data-people carries the member ids so #p-<id> deep
        // links know which group to fetch; the <noscript> list keeps every
        // person page reachable for crawlers and script-less readers.
        var standaloneHeadPrinted = false;
        %>
        <% groupsMeta.forEach(function(group) { %>
        <% if (!standaloneHeadPrinted && group.standalone) { standaloneHeadPrinted = true; %>
        <h2 class="commu-people-standalone-head"><%= en ? 'Revolutionaries beyond the Soviet Union' : '소련 밖의 혁명가들' %></h2>
        <% } %>
        <details class="commu-people-group is-<%= group.id %>" data-group-id="<%= group.id %>" data-people="<%= group.personIds %>">
            <summary class="commu-people-group-head">
                <span class="commu-people-range"><%= group.range %></span>
                <h2><%= group.title %> <span class="commu-people-group-count"><%= group.count %><%= en ? '' : '명' %></span></h2>
                <p><%= group.blurb %></p>
            </summary>
            <div class="commu-people-grid">
                <noscript>
                    <ul class="commu-people-noscript-list">
                        <% group.links.forEach(function(link) { %>
                        <li><a href="/commulingo/people/<%= link.id %>"><%= link.name %></a></li>
                        <% }) %>
                    </ul>
                </noscript>
            </div>
        </details>
        <% }) %>
    </main>

    <%- include('../partials/footer') %>
    <script>
        // Lazy card loading: each group's grid is fetched once, when the group
        // is first opened (or when a search needs every card).
        (function() {
            var en = document.documentElement.lang === 'en';
            var pending = {};
            var groupEls = Array.prototype.slice.call(
                document.querySelectorAll('details.commu-people-group[data-group-id]'));

            function loadGroup(group) {
                if (!group || group.hasAttribute('data-loaded')) return Promise.resolve();
                var id = group.getAttribute('data-group-id');
                if (pending[id]) return pending[id];
                var grid = group.querySelector('.commu-people-grid');
                var loading = document.createElement('p');
                loading.className = 'commu-people-loading';
                loading.textContent = en ? 'Loading…' : '불러오는 중…';
                if (grid) grid.appendChild(loading);
                pending[id] = fetch('/commulingo/people/cards?group=' + encodeURIComponent(id), { credentials: 'same-origin' })
                    .then(function(res) {
                        if (!res.ok) throw new Error('HTTP ' + res.status);
                        return res.text();
                    })
                    .then(function(html) {
                        loading.remove();
                        if (grid && !group.hasAttribute('data-loaded')) {
                            grid.insertAdjacentHTML('beforeend', html);
                            group.setAttribute('data-loaded', '');
                        }
                    })
                    .catch(function(err) {
                        loading.textContent = en ? 'Failed to load — reopen to retry' : '불러오지 못했습니다 — 다시 열면 재시도합니다';
                        setTimeout(function() { loading.remove(); }, 4000);
                        delete pending[id];
                        throw err;
                    });
                return pending[id];
            }

            groupEls.forEach(function(group) {
                group.addEventListener('toggle', function() {
                    if (group.open) loadGroup(group).catch(function() {});
                });
            });

            window.__commuPeopleCards = {
                loadGroup: loadGroup,
                loadAll: function() {
                    return Promise.all(groupEls.map(function(group) { return loadGroup(group); }));
                },
                groupFor: function(personId) {
                    for (var i = 0; i < groupEls.length; i++) {
                        var ids = ' ' + (groupEls[i].getAttribute('data-people') || '') + ' ';
                        if (ids.indexOf(' ' + personId + ' ') !== -1) return groupEls[i];
                    }
                    return null;
                }
            };
        })();
    </script>
    <script>
        // Highlight the card targeted by the URL hash (arriving from a book's
        // name link), fetching its group's cards first if needed.
        (function() {
            function focusCard(personId) {
                var card = document.getElementById('p-' + personId);
                if (!card) return;
                var group = card.closest('details.commu-people-group');
                if (group) group.open = true;
                document.querySelectorAll('.commu-person-card.is-focused').forEach(function(el) {
                    el.classList.remove('is-focused');
                });
                card.classList.add('is-focused');
                window.requestAnimationFrame(function() {
                    card.scrollIntoView({ block: 'start' });
                });
            }
            function focusHash() {
                var hash = window.location.hash;
                if (!hash) return;
                if (hash.indexOf('#office-') === 0) {
                    var office = document.getElementById(hash.slice(1));
                    var officeIndex = document.querySelector('details.commu-office-index');
                    if (officeIndex) officeIndex.open = true;
                    if (office && office.tagName === 'DETAILS') {
                        office.open = true;
                        window.requestAnimationFrame(function() {
                            office.scrollIntoView({ block: 'start' });
                        });
                    }
                    return;
                }
                if (hash.indexOf('#p-') !== 0) return;
                var personId = hash.slice(3);
                var group = window.__commuPeopleCards.groupFor(personId);
                if (group && !group.hasAttribute('data-loaded')) {
                    window.__commuPeopleCards.loadGroup(group)
                        .then(function() { focusCard(personId); })
                        .catch(function() {});
                } else {
                    focusCard(personId);
                }
            }
            window.addEventListener('hashchange', focusHash);
            focusHash();
        })();
    </script>
    <script>
        // Live person search. Each card carries three haystacks: data-name
        // (identity), data-role (category/career/institution), data-desc (prose).
        // Terms are AND-matched and bucketed most-identity-first into three
        // result containers: name → role → description. Matched cards are moved
        // into the result grids (restored on clear) and the matched substrings
        // are wrapped in <mark> for highlighting.
        (function() {
            var input = document.getElementById('commu-people-search-input');
            var clearBtn = document.getElementById('commu-people-search-clear');
            if (!input) return;
            var en = <%- en ? 'true' : 'false' %>;
            var results = document.getElementById('commu-people-results');
            var emptyMsg = document.getElementById('commu-people-result-empty');
            var buckets = ['name', 'role', 'desc'].map(function(key) {
                return {
                    key: key,
                    section: document.getElementById('commu-people-result-' + key),
                    grid: document.getElementById('commu-people-result-' + key + '-grid'),
                    count: document.getElementById('commu-people-result-' + key + '-count')
                };
            });
            var groups = Array.prototype.slice.call(document.querySelectorAll('details.commu-people-group'));
            var chrome = Array.prototype.slice.call(document.querySelectorAll(
                'details.commu-office-index, .commu-people-standalone-head'));
            // Cards load lazily; the haystack list and each card's home parent
            // are captured once every group's grid has been fetched.
            var cards = [];
            var origin = [];
            var cardsReady = null;
            var emptyText = emptyMsg.textContent;
            function ensureCards() {
                if (!cardsReady) {
                    cardsReady = window.__commuPeopleCards.loadAll().then(function() {
                        cards = Array.prototype.slice.call(document.querySelectorAll('.commu-person-card[data-name]'));
                        origin = cards.map(function(card) { return { card: card, parent: card.parentNode }; });
                    });
                }
                return cardsReady;
            }
            // Start the download as soon as the reader engages the search box,
            // so the cards are usually there before the first keystroke lands.
            input.addEventListener('focus', function() { ensureCards(); }, { once: true });
            var highlighted = [];

            function countText(n) {
                if (en) return n + (n === 1 ? ' person' : ' people');
                return n + '명';
            }
            function escapeRegExp(value) {
                return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            }
            function homeAllCards() {
                origin.forEach(function(o) { o.parent.appendChild(o.card); });
            }
            function clearHighlights(card) {
                var marks = card.querySelectorAll('mark.commu-search-hl');
                for (var i = 0; i < marks.length; i++) {
                    var mark = marks[i];
                    var parent = mark.parentNode;
                    while (mark.firstChild) parent.insertBefore(mark.firstChild, mark);
                    parent.removeChild(mark);
                    parent.normalize();
                }
            }
            function highlight(card, re) {
                var walker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT, {
                    acceptNode: function(node) {
                        if (!node.nodeValue || !node.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
                        return NodeFilter.FILTER_ACCEPT;
                    }
                });
                var nodes = [], n;
                while ((n = walker.nextNode())) nodes.push(n);
                nodes.forEach(function(node) {
                    var text = node.nodeValue;
                    re.lastIndex = 0;
                    if (!re.test(text)) return;
                    re.lastIndex = 0;
                    var frag = document.createDocumentFragment();
                    var last = 0, match;
                    while ((match = re.exec(text))) {
                        if (match.index > last) frag.appendChild(document.createTextNode(text.slice(last, match.index)));
                        var mark = document.createElement('mark');
                        mark.className = 'commu-search-hl';
                        mark.textContent = match[0];
                        frag.appendChild(mark);
                        last = match.index + match[0].length;
                        if (re.lastIndex === match.index) re.lastIndex++;
                    }
                    if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
                    node.parentNode.replaceChild(frag, node);
                });
            }

            function reset() {
                highlighted.forEach(clearHighlights);
                highlighted = [];
                homeAllCards();
                results.hidden = true;
                groups.forEach(function(group) { group.hidden = false; group.open = false; });
                chrome.forEach(function(el) { el.hidden = false; });
                clearBtn.hidden = true;
            }

            function apply(query) {
                var terms = query.split(/\s+/).filter(Boolean);
                if (!terms.length) { reset(); return; }
                emptyMsg.textContent = emptyText;
                highlighted.forEach(clearHighlights);
                highlighted = [];
                homeAllCards();
                clearBtn.hidden = false;
                groups.forEach(function(group) { group.hidden = true; });
                chrome.forEach(function(el) { el.hidden = true; });

                var hits = { name: [], role: [], desc: [] };
                cards.forEach(function(card) {
                    var nameHay = card.getAttribute('data-name') || '';
                    var roleHay = nameHay + ' ' + (card.getAttribute('data-role') || '');
                    var descHay = roleHay + ' ' + (card.getAttribute('data-desc') || '');
                    function all(hay) { return terms.every(function(t) { return hay.indexOf(t) !== -1; }); }
                    if (all(nameHay)) hits.name.push(card);
                    else if (all(roleHay)) hits.role.push(card);
                    else if (all(descHay)) hits.desc.push(card);
                });

                var re = new RegExp('(' + terms.slice().sort(function(a, b) { return b.length - a.length; })
                    .map(escapeRegExp).join('|') + ')', 'gi');
                var total = 0;
                buckets.forEach(function(bucket) {
                    var list = hits[bucket.key];
                    list.forEach(function(card) {
                        bucket.grid.appendChild(card);
                        highlight(card, re);
                        highlighted.push(card);
                    });
                    bucket.section.hidden = list.length === 0;
                    bucket.count.textContent = countText(list.length);
                    total += list.length;
                });
                emptyMsg.hidden = total > 0;
                results.hidden = false;
            }

            var raf = null;
            function onInput() {
                if (raf) cancelAnimationFrame(raf);
                raf = requestAnimationFrame(function() {
                    var query = input.value.trim().toLowerCase();
                    if (!query) { apply(query); return; }
                    if (origin.length) {
                        ensureCards().then(function() { apply(input.value.trim().toLowerCase()); });
                        return;
                    }
                    // First search before the cards arrived: show a loading
                    // note, then run the query once the grids are in.
                    groups.forEach(function(group) { group.hidden = true; });
                    chrome.forEach(function(el) { el.hidden = true; });
                    buckets.forEach(function(bucket) { bucket.section.hidden = true; });
                    emptyMsg.textContent = en ? 'Loading people…' : '인물 데이터를 불러오는 중…';
                    emptyMsg.hidden = false;
                    results.hidden = false;
                    clearBtn.hidden = false;
                    ensureCards().then(function() {
                        apply(input.value.trim().toLowerCase());
                    }).catch(function() {
                        emptyMsg.textContent = en ? 'Failed to load people data' : '인물 데이터를 불러오지 못했습니다';
                    });
                });
            }
            input.addEventListener('input', onInput);
            input.addEventListener('keydown', function(event) {
                if (event.key === 'Escape' && input.value) {
                    event.preventDefault();
                    input.value = '';
                    reset();
                } else if (event.key === 'Enter') {
                    var first = results.querySelector('.commu-person-card[data-person-href]');
                    if (first) window.location.href = first.getAttribute('data-person-href');
                }
            });
            clearBtn.addEventListener('click', function() {
                input.value = '';
                reset();
                input.focus();
            });
            // Restore filtering if the browser repopulates the field on back-nav.
            if (input.value.trim()) onInput();
        })();
    </script>
    <%- include('../partials/commulingo-person-card-click-script') %>
</body>
</html>
