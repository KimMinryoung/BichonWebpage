<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>

    <%
    var en = lang === 'en';
    %>
    <main class="container commulingo-shell commu-people-shell" data-lang="<%= lang %>" data-page-size="<%= pageSize %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [{ label: strings.commuLingoViews.people.people }],
            dictJump: 'people' }) %>

        <h1 class="commu-sr-only"><%= strings.commuLingoViews.people.peopleOfTheRevolution %></h1>

        <div class="commu-people-search">
            <span class="commu-people-search-icon" aria-hidden="true"><%- roleIconSvg('search') %></span>
            <input type="search" id="commu-people-search-input" class="commu-people-search-input"
                placeholder="<%= strings.commuLingoViews.people.searchByNameAlias %>"
                autocomplete="off" spellcheck="false"
                aria-label="<%= strings.commuLingoViews.people.searchPeople %>">
            <button type="button" id="commu-people-search-clear" class="commu-people-search-clear" aria-label="<%= strings.commuLingoViews.people.clearSearch %>" hidden><%- roleIconSvg('x') %></button>
        </div>

        <div class="commu-people-results" id="commu-people-results" hidden>
            <section class="commu-people-result-section" id="commu-people-result-name" hidden>
                <div class="commu-people-result-head">
                    <span class="commu-people-result-label"><%= strings.commuLingoViews.people.nameMatches %></span>
                    <span class="commu-people-result-count" id="commu-people-result-name-count"></span>
                </div>
                <div class="commu-people-grid" id="commu-people-result-name-grid"></div>
            </section>
            <section class="commu-people-result-section" id="commu-people-result-role" hidden>
                <div class="commu-people-result-head">
                    <span class="commu-people-result-label"><%= strings.commuLingoViews.people.roleMatches %></span>
                    <span class="commu-people-result-count" id="commu-people-result-role-count"></span>
                </div>
                <div class="commu-people-grid" id="commu-people-result-role-grid"></div>
            </section>
            <section class="commu-people-result-section" id="commu-people-result-desc" hidden>
                <div class="commu-people-result-head">
                    <span class="commu-people-result-label"><%= strings.commuLingoViews.people.mentionedInDescription %></span>
                    <span class="commu-people-result-count" id="commu-people-result-desc-count"></span>
                </div>
                <div class="commu-people-grid" id="commu-people-result-desc-grid"></div>
            </section>
            <p class="commu-people-result-empty" id="commu-people-result-empty" role="status" aria-live="polite" hidden><%= strings.commuLingoViews.people.noPeopleFound %></p>
        </div>

        <section class="commu-hub-section" aria-labelledby="activity-index-title">
            <h2 id="activity-index-title"><%= en ? 'Functions and activities' : '기능·활동별 인물' %></h2>
            <div class="commu-office-grid">
            <% ((typeof activityFunctions !== 'undefined' && activityFunctions) || []).forEach(function(f) { %>
                <a class="commu-office-card commu-role-category-link" href="/commulingo/activities?function=<%= f.id %>">
                    <span class="commu-office-icon-link" aria-hidden="true"><%- roleIconSvg(f.icon) %></span>
                    <span class="commu-role-category-copy"><h3><%= f.label %></h3><p><%= f.count %> <%= en ? 'people' : '명' %></p></span>
                    <span aria-hidden="true">→</span>
                </a>
            <% }) %>
            </div>
            <p><a class="btn" href="/commulingo/activities"><%= en ? 'Browse by activity and affiliation →' : '기능·활동과 국가·세력으로 찾기 →' %></a></p>
        </section>
        <% var officesList = (typeof offices !== 'undefined' && offices) || []; %>
        <% var roleCategoriesList = (typeof roleCategories !== 'undefined' && roleCategories) || []; %>
        <% if (officesList.length || roleCategoriesList.length) { %>
        <details class="commu-office-index" aria-label="<%= en ? 'Institution leadership timelines' : '기관별 지도부 타임라인' %>">
            <summary class="commu-office-index-head">
                <span class="commu-people-range">INDEX</span>
                <h2><%= en ? 'Institution leadership timelines' : '기관별 지도부 타임라인' %></h2>
            </summary>
            <div class="commu-office-grid">
                <a class="commu-office-card commu-role-category-link" href="/commulingo/politburo">
                    <span class="commu-office-icon-link" aria-hidden="true"><%- roleIconSvg('hammer-sickle') %></span>
                    <span class="commu-role-category-copy">
                        <h3><%= strings.commuLingoViews.people.theSovietPolitburo %></h3>
                        <p><%= strings.commuLingoViews.people.membership19171991By %></p>
                    </span>
                    <span class="commu-role-category-arrow" aria-hidden="true">→</span>
                </a>
                <% officesList.forEach(function(office) { %>
                <details class="commu-office-card is-<%= office.id %>" id="office-<%= office.id %>">
                    <summary class="commu-office-card-head">
                        <a class="commu-office-icon-link" href="/commulingo/offices/<%= office.id %>" title="<%= office.title %>" aria-label="<%= en ? 'Open ' + office.title + ' page' : office.title + ' 기관 페이지 열기' %>" onclick="event.stopPropagation()"><%- roleIconSvg(office.icon) %></a>
                        <span class="commu-office-range"><%= office.range %></span>
                        <h3><%= office.title %></h3>
                        <p><%= office.blurb %></p>
                    </summary>
                    <ol class="commu-office-rows">
                        <% office.rows.forEach(function(row) { %>
                        <li>
                            <span class="commu-office-years"><%= row.years %></span>
                            <span class="commu-office-main">
                                <% if (row.personId) { %>
                                <a href="#p-<%= row.personId %>"><%= row.name %></a>
                                <% } else { %>
                                <strong><%= row.name %></strong>
                                <% } %>
                                <small><%= row.body %></small>
                                <% if (row.note) { %><em><%= row.note %></em><% } %>
                            </span>
                        </li>
                        <% }) %>
                    </ol>
                    <a class="commu-office-page-link" href="/commulingo/offices/<%= office.id %>"><%= strings.commuLingoViews.people.officePage %></a>
                </details>
                <% }) %>
            </div>
        </details>
        <% } %>

        <%
        // Group shells only — the card grids (~8MB of markup) load per group
        // from /commulingo/people/cards?group=<id> when a group is opened or a
        // search begins. data-people carries the member ids so #p-<id> deep
        // links know which group to fetch; the 「목록으로 보기」 link on each
        // header is the server-rendered page of the same cards
        // (/people/list/<id>), which keeps every person reachable for
        // crawlers and script-less readers.
        // The groups sit on boxed shelves (Soviet era sequence, Chinese era
        // sequence, the world beyond both), which orderedPeopleGroupsMeta
        // returns in shelf order — so each shelf closes where the next opens.
        var shelfTitles = {
            soviet: strings.commuLingoViews.people.peopleOfTheSoviet,
            china: strings.commuLingoViews.people.peopleOfChina,
            world: strings.commuLingoViews.people.peopleBeyondTheSoviet
        };
        var openShelf = '';
        %>
        <% groupsMeta.forEach(function(group) { %>
        <% if (group.shelf !== openShelf) { %>
        <% if (openShelf) { %></section><% } openShelf = group.shelf; %>
        <section class="commu-people-shelf is-shelf-<%= group.shelf %>" aria-labelledby="commu-people-<%= group.shelf %>-title">
        <h2 class="commu-people-shelf-head" id="commu-people-<%= group.shelf %>-title"><%= shelfTitles[group.shelf] || '' %></h2>
        <% } %>
        <details class="commu-people-group is-<%= group.id %>" data-group-id="<%= group.id %>" data-people="<%= group.personIds %>">
            <summary class="commu-people-group-head">
                <span class="commu-people-range"><%= group.range %></span>
                <a class="commu-people-group-list-link" href="/commulingo/people/list/<%= group.id %>" onclick="event.stopPropagation()"><%= strings.commuLingoViews.people.viewAsAList %></a>
                <h2><%= group.title %> <span class="commu-people-group-count"><%= group.count %><%= strings.commuLingoViews.people.text %></span></h2>
                <p><%= group.blurb %></p>
            </summary>
            <div class="commu-people-grid"></div>
        </details>
        <% }) %>
        <% if (openShelf) { %></section><% } %>
    </main>

    <%- include('../partials/footer') %>
    <script src="/js/commulingo-search-utils.js?v=<%= assetVersion %>"></script>
    <script src="/js/commulingo-people.js?v=<%= assetVersion %>"></script>
    <%- include('../partials/commulingo-person-card-click-script') %>
</body>
</html>
