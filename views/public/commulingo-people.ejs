<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>

    <%
    var en = lang === 'en';
    var fateIcons = {
        executed: '✕', assassinated: '✕', murdered: '✕', killed: '✕', suicide: '✕',
        deposed: '↓', exile: '→', natural: '○'
    };
    var roleIconPaths = {
        eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>',
        shield: '<path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3v8Z"/>',
        star: '<path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8-6.2-3.3L5.8 21 7 14.2 2 9.3l6.9-1L12 2Z"/>',
        handshake: '<path d="m11 17 2 2a3 3 0 0 0 4.2 0l3.8-3.8a3 3 0 0 0 0-4.2l-4-4a3 3 0 0 0-4.2 0L12 8"/><path d="m13 7-2-2a3 3 0 0 0-4.2 0L3 8.8a3 3 0 0 0 0 4.2l4 4a3 3 0 0 0 4.2 0l.8-.8"/><path d="m8 12 2 2 4-4"/>',
        megaphone: '<path d="m3 11 18-5v12L3 14v-3Z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>',
        paintbrush: '<path d="m14.6 2.6 6.8 6.8"/><path d="M13 4 4 13a4 4 0 0 0 0 6 4 4 0 0 0 6 0l9-9"/>',
        factory: '<path d="M2 20h20"/><path d="M4 20V10l5 3V8l5 3V6l6 4v10"/><path d="M17 18h1"/><path d="M12 18h1"/><path d="M7 18h1"/>',
        atom: '<circle cx="12" cy="12" r="1"/><path d="M20.2 20.2c-2.5 2.5-8.4.7-13.2-4.1S.4 5.4 2.9 2.9s8.4-.7 13.2 4.1 6.6 10.7 4.1 13.2Z"/><path d="M20.2 3.8c2.5 2.5.7 8.4-4.1 13.2S5.4 23.6 2.9 21.1s-.7-8.4 4.1-13.2 10.7-6.6 13.2-4.1Z"/>',
        wheat: '<path d="M2 22 16 8"/><path d="M8 8c0-3 2-5 5-6 0 4-2 6-5 6Z"/><path d="M10 12c0-3 2-5 5-6 0 4-2 6-5 6Z"/><path d="M6 14c-3 0-5-2-6-5 4 0 6 2 6 5Z"/>',
        landmark: '<path d="M3 21h18"/><path d="M5 21V10"/><path d="M19 21V10"/><path d="M12 3 3 8h18l-9-5Z"/><path d="M9 21V10"/><path d="M15 21V10"/>',
        map: '<path d="M9 18 3 21V6l6-3 6 3 6-3v15l-6 3-6-3Z"/><path d="M9 3v15"/><path d="M15 6v15"/>',
        flag: '<path d="M4 22V4"/><path d="M4 4h13l-1 5 1 5H4"/>',
        folder: '<path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7l-2-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2Z"/>',
        briefcase: '<path d="M16 7V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v3"/><rect x="2" y="7" width="20" height="13" rx="2"/>',
        chart: '<path d="M3 3v18h18"/><path d="M7 16V9"/><path d="M12 16V5"/><path d="M17 16v-4"/>',
        globe: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 0 20"/><path d="M12 2a15.3 15.3 0 0 0 0 20"/>',
        crown: '<path d="m2 6 5 12h10l5-12-6 5-4-7-4 7-6-5Z"/><path d="M7 18h10"/>',
        rose: '<path d="M12 22V12"/><path d="M17 8a5 5 0 0 0-10 0c0 3 5 6 5 6s5-3 5-6Z"/><path d="M7 14c-3 0-5 2-5 5 3 0 5-2 5-5Z"/><path d="M17 14c3 0 5 2 5 5-3 0-5-2-5-5Z"/>',
        dove: '<path d="M4 19c5-1 8-4 10-8"/><path d="M3 7c4 0 7 2 9 6 2-4 5-6 9-6-2 5-5 8-9 10-3-2-6-5-9-10Z"/><path d="M14 7l4-4"/>',
        'circle-help': '<circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 1 1 5.8 1c-.7 1.4-2.9 1.7-2.9 4"/><path d="M12 17h.01"/>'
    };
    function roleIconSvg(icon) {
        var paths = roleIconPaths[icon] || roleIconPaths['circle-help'];
        return '<svg class="commu-role-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">' + paths + '</svg>';
    }
    %>
    <main class="container commulingo-shell commu-people-shell" data-lang="<%= lang %>">
        <a class="commu-back-link" href="/commulingo">← <%= strings.commuLingo.backToBooks %></a>

        <header class="box commulingo-hero commulingo-hero--graph">
            <div>
                <h1><%= en ? 'People of the Revolution and the USSR' : '인물 사전: 혁명과 소련의 사람들' %></h1>
            </div>
        </header>

        <% var officesList = (typeof offices !== 'undefined' && offices) || []; %>
        <% if (officesList.length) { %>
        <details class="commu-office-index" aria-label="<%= en ? 'Soviet institution leadership timelines' : '소련 기관별 지도부 타임라인' %>">
            <summary class="commu-office-index-head">
                <span class="commu-people-range">1917–1991</span>
                <h2><%= en ? 'Soviet Institution Timelines' : '소련 기관별 지도부 타임라인' %></h2>
            </summary>
            <div class="commu-office-grid">
                <% officesList.forEach(function(office) { %>
                <details class="commu-office-card is-<%= office.id %>" id="office-<%= office.id %>">
                    <summary class="commu-office-card-head">
                        <span class="commu-office-range"><%= office.range %></span>
                        <h3><%= office.title %></h3>
                        <p><%= office.blurb %></p>
                    </summary>
                    <ol class="commu-office-rows">
                        <% office.rows.forEach(function(row) { %>
                        <li>
                            <span class="commu-office-years"><%= row.years %></span>
                            <span class="commu-office-main">
                                <% if (row.personId) { %>
                                <a href="#p-<%= row.personId %>"><%= row.name %></a>
                                <% } else { %>
                                <strong><%= row.name %></strong>
                                <% } %>
                                <small><%= row.body %></small>
                                <% if (row.note) { %><em><%= row.note %></em><% } %>
                            </span>
                        </li>
                        <% }) %>
                    </ol>
                </details>
                <% }) %>
            </div>
        </details>
        <% } %>

        <% groups.forEach(function(group) { %>
        <details class="commu-people-group is-<%= group.id %>">
            <summary class="commu-people-group-head">
                <span class="commu-people-range"><%= group.range %></span>
                <h2><%= group.title %></h2>
                <p><%= group.blurb %></p>
            </summary>
            <div class="commu-people-grid">
                <% group.people.forEach(function(person) { %>
                <article class="commu-person-card" id="p-<%= person.id %>">
                    <div class="commu-person-top">
                        <% if (person.role && person.role.officeId) { %>
                        <a class="commu-person-medal is-<%= group.id %>" href="#office-<%= person.role.officeId %>" title="<%= person.role.label %>" aria-label="<%= person.role.label %>"><%- roleIconSvg(person.role.icon) %></a>
                        <% } else { %>
                        <span class="commu-person-medal is-<%= group.id %>" title="<%= person.role && person.role.label ? person.role.label : (en ? 'Context marker' : '맥락 표식') %>" aria-hidden="true"><%- roleIconSvg(person.role ? person.role.icon : 'circle-help') %></span>
                        <% } %>
                        <div class="commu-person-idbox">
                            <h3><%= person.displayName || person.name %></h3>
                            <span class="commu-person-cyr"><%= person.cyrillic %></span>
                        </div>
                        <div class="commu-person-sidebox">
                            <span class="commu-person-years"><%= person.years %></span>
                            <span class="commu-fate is-<%= person.fateKind %>"><%= fateIcons[person.fateKind] || '' %> <%= person.fateLabel %></span>
                        </div>
                    </div>
                    <p class="commu-person-epithet"><%= person.epithet %></p>
                    <p class="commu-person-bio"><%= person.bio %></p>
                    <% if (person.career.length) { %>
                    <details class="commu-person-more">
                        <summary><%= en ? 'Career timeline' : '상세 이력 보기' %></summary>
                        <ul class="commu-person-career">
                            <% person.career.forEach(function(item) { %>
                            <li><span class="commu-career-year"><%= item.y %></span><span class="commu-career-role"><%= item.r %></span></li>
                            <% }) %>
                        </ul>
                    </details>
                    <% } %>
                    <% if (person.scenes.length) { %>
                    <div class="commu-person-scenes">
                        <span class="commu-person-scenes-label"><%= en ? 'Scenes' : '등장 장면' %></span>
                        <% person.scenes.forEach(function(scene) { %>
                        <a class="commu-scene-chip" href="/commulingo/book/<%= scene.bookId %>#<%= scene.episodeId %>" title="<%= scene.bookTitle %>"><%= scene.title %></a>
                        <% }) %>
                    </div>
                    <% } %>
                </article>
                <% }) %>
            </div>
        </details>
        <% }) %>
    </main>

    <%- include('../partials/footer') %>
    <script>
        // Highlight the card targeted by the URL hash (arriving from a book's name link).
        (function() {
            function focusHash() {
                var hash = window.location.hash;
                if (!hash) return;
                if (hash.indexOf('#office-') === 0) {
                    var office = document.getElementById(hash.slice(1));
                    var officeIndex = document.querySelector('details.commu-office-index');
                    if (officeIndex) officeIndex.open = true;
                    if (office && office.tagName === 'DETAILS') {
                        office.open = true;
                        window.requestAnimationFrame(function() {
                            office.scrollIntoView({ block: 'start' });
                        });
                    }
                    return;
                }
                if (hash.indexOf('#p-') !== 0) return;
                var card = document.getElementById(hash.slice(1));
                if (!card) return;
                var group = card.closest('details.commu-people-group');
                if (group) group.open = true;
                document.querySelectorAll('.commu-person-card.is-focused').forEach(function(el) {
                    el.classList.remove('is-focused');
                });
                card.classList.add('is-focused');
                window.requestAnimationFrame(function() {
                    card.scrollIntoView({ block: 'start' });
                });
            }
            window.addEventListener('hashchange', focusHash);
            focusHash();
        })();
    </script>
</body>
</html>
