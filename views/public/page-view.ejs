<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/report.css?v=<%= assetVersion %>">
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <%- include('../partials/library-tabs', { active: 'reports' }) %>
        <article class="post-content">
            <h1><%= pageTitle %></h1>
            <% if (summary) { %>
                <p class="post-summary"><%= summary %></p>
            <% } %>
            <% if (updatedAt) { %>
                <div class="post-meta">
                    <time class="local-date" datetime="<%= updatedAt %>" data-suffix="<%= lang === 'ko' ? '에 업데이트' : ', updated' %>"></time>
                </div>
            <% } %>

            <%# Sanitized on the server (services/static-page-render.js). %>
            <div class="report-body" id="page-content"><%- contentHtml %></div>
        </article>

        <div class="box post-nav">
            <div class="post-nav-left">
                <a href="/">&larr; <%= lang === 'ko' ? '대문으로' : 'Home' %></a>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
