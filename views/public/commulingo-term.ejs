<!DOCTYPE html>
<html lang="<%= lang %>">
<head><%- include('../partials/head') %></head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>
    <% var en = lang === 'en'; %>
    <% var paired = typeof eventPanel !== 'undefined' && eventPanel; %>
    <main class="container commulingo-shell commu-event-page commu-term-page" data-lang="<%= lang %>">
        <a class="commu-back-link" href="/commulingo/terms">← <%= en ? 'Glossary' : '용어 사전' %></a>
        <% if (paired) { %>
        <%- include('../partials/commulingo-pair-tabs', {
                en: en, activePanel: 'term',
                pairTermId: term.id, pairEventId: eventPanel.event.id }) %>
        <div class="commu-pair-panel is-active" data-panel="term">
        <% } %>
        <%- include('../partials/commulingo-term-panel', {
                en: en,
                p: { term: term, definitionHtml: definitionHtml, bodyHtml: bodyHtml,
                     sources: sources, relatedDocs: relatedDocs, relatedReports: relatedReports } }) %>
        <% if (paired) { %>
        </div>
        <div class="commu-pair-panel" data-panel="event" hidden>
            <%- include('../partials/commulingo-event-panel', { en: en, p: eventPanel }) %>
        </div>
        <% } %>
        <a class="commu-back-link commu-person-detail-back" href="/commulingo/terms">← <%= en ? 'Glossary' : '용어 사전' %></a>
    </main>
    <% if (paired) { %><script src="/js/commulingo-pair-tabs.js?v=<%= assetVersion %>" defer></script><% } %>
    <%- include('../partials/footer') %>
</body>
</html>
