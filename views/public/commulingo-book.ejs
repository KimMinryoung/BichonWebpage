<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
</head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>

    <% var isGraph = (typeof bookFormat !== 'undefined' && bookFormat === 'concept-graph'); %>
    <% var isDecision = (typeof bookFormat !== 'undefined' && bookFormat === 'decision-history'); %>
    <main class="container commulingo-shell" data-lang="<%= lang %>">
        <a class="commu-back-link" href="/commulingo">← <%= strings.commuLingo.backToBooks %></a>

        <% if (isDecision) { %>
        <% var timeline = lessons.collections[0].decisionTimeline; %>
        <% var people = (typeof decisionPeople !== 'undefined' && decisionPeople) || []; %>
        <script id="commulingo-decision" type="application/json"><%- JSON.stringify({ bookId: lessons.collections[0].id, timeline: timeline, people: people }).replace(/</g, '\\u003c') %></script>

        <header class="box commulingo-hero commulingo-hero--graph">
            <div>
                <h1><%= bookTitle %></h1>
                <p><%= bookDescription %></p>
                <div class="commu-book-reference-links">
                    <a class="commu-people-cta is-events" href="/commulingo/events"><%= lang === 'en' ? 'Historical events' : '역사 사건' %> →</a>
                    <a class="commu-people-cta" href="/commulingo/people"><%= lang === 'en' ? 'People of this era' : '인물 사전' %> →</a>
                </div>
            </div>
        </header>

        <section class="commu-dc" id="commuDecision" aria-label="<%= bookTitle %>"></section>
        <% } else if (isGraph) { %>
        <% var graph = lessons.collections[0].conceptGraph; %>
        <script id="commulingo-graph" type="application/json"><%- JSON.stringify(graph).replace(/</g, '\\u003c') %></script>

        <header class="box commulingo-hero commulingo-hero--graph">
            <div>
                <h1><%= bookTitle %></h1>
                <p><%= bookDescription %></p>
            </div>
        </header>

        <section class="commu-graph" id="commuGraph" aria-label="<%= bookTitle %>"></section>
        <% } else { %>
        <script id="commulingo-data" type="application/json"><%- JSON.stringify(lessons).replace(/</g, '\\u003c') %></script>

        <header class="box commulingo-hero">
            <div>
                <h1><%= bookTitle %></h1>
                <p><%= bookDescription %></p>
            </div>
            <div class="commulingo-total">
                <span id="commuProgressText">0%</span>
                <small><%= strings.commuLingo.progress %></small>
            </div>
        </header>

        <%# Dictionary entries this book's prose actually names, read off the links
            the linkifier found in its lessons. The chapter list is titles and
            one-line summaries, so without this the page gives no sign that the
            people and glossary entries behind it exist. %>
        <%# Every chip opens in a new tab for the same reason the links inside the
            lessons do: leaving the book loses the reader's place in it. %>
        <% var dict = (typeof dictionaryEntries !== 'undefined' && dictionaryEntries) || { people: [], terms: [], events: [] }; %>
        <% var dictGroups = [
               { items: dict.terms || [], base: '/commulingo/terms/', label: lang === 'en' ? 'Terms' : '용어' },
               { items: dict.people || [], base: '/commulingo/people/', label: lang === 'en' ? 'People' : '인물' },
               { items: dict.events || [], base: '/commulingo/events/', label: lang === 'en' ? 'Historical events' : '역사 사건' }
           ].filter(function(group) { return group.items.length; }); %>
        <% if (dictGroups.length) { %>
        <section class="box commu-book-dictionary" aria-labelledby="book-dictionary">
            <h2 id="book-dictionary"><%= lang === 'en' ? 'Dictionary entries in this book' : '이 책이 다루는 사전 항목' %></h2>
            <% dictGroups.forEach(function(group) { %>
            <h3><%= group.label %></h3>
            <div class="commu-term-chips">
                <% group.items.forEach(function(entry) { %>
                <a class="commu-term-chip" target="_blank" rel="noopener" href="<%= group.base %><%= encodeURIComponent(entry.id) %>"><%= entry.label %></a>
                <% }) %>
            </div>
            <% }) %>
        </section>
        <% } %>

        <section class="commulingo-lessons" id="commuLessonList" aria-label="<%= bookTitle %>"></section>

        <section class="commu-quiz is-hidden" id="commuQuiz" aria-live="polite">
            <div class="commu-quiz-top">
                <button type="button" class="btn btn-secondary" id="commuBackBtn"><%= strings.commuLingo.backToLessons %></button>
                <div class="commu-quiz-meter">
                    <span id="commuQuestionCount"></span>
                    <div class="commu-meter-track"><div id="commuMeterFill"></div></div>
                </div>
            </div>

            <article class="commu-question">
                <p class="commu-lesson-title" id="commuLessonTitle"></p>
                <section class="commu-intro is-hidden" id="commuIntro" aria-label="Concept brief">
                    <h2 id="commuIntroTitle"></h2>
                    <p class="commu-intro-summary" id="commuIntroSummary"></p>
                    <p class="commu-intro-focus" id="commuIntroFocus"></p>
                    <div class="commu-diagram" id="commuDiagram" aria-label="Concept diagram"></div>
                </section>
                <p class="commu-question-focus is-hidden" id="commuFocus"></p>
                <h2 id="commuPrompt"></h2>
                <div class="commu-choices" id="commuChoices"></div>
                <div class="commu-feedback is-hidden" id="commuFeedback"></div>
                <div class="commu-quiz-actions">
                    <button type="button" class="btn btn-primary" id="commuNextBtn" disabled><%= strings.commuLingo.next %></button>
                    <button type="button" class="btn btn-secondary is-hidden" id="commuNextLessonBtn"></button>
                </div>
            </article>
        </section>
        <% } %>
    </main>

    <%- include('../partials/footer') %>
    <script>
        window.COMMULINGO_STRINGS = <%- JSON.stringify(strings.commuLingo).replace(/</g, '\\u003c') %>;
    </script>
    <% if (isDecision) { %>
    <script src="/js/commulingo-decision.js?v=<%= assetVersion %>"></script>
    <% } else if (isGraph) { %>
    <script src="/js/commulingo-graph.js?v=<%= assetVersion %>"></script>
    <% } else { %>
    <script src="/js/commulingo.js?v=<%= assetVersion %>"></script>
    <% } %>
</body>
</html>
