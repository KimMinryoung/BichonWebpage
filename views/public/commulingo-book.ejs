<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
</head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>

    <% var isGraph = (typeof bookFormat !== 'undefined' && bookFormat === 'concept-graph'); %>
    <% var isDecision = (typeof bookFormat !== 'undefined' && bookFormat === 'decision-history'); %>
    <main class="container commulingo-shell" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [{ label: bookTitle }],
            dictJump: true }) %>

        <% if (isDecision) { %>
        <% var timeline = lessons.collections[0].decisionTimeline; %>
        <% var links = (typeof decisionLinks !== 'undefined' && decisionLinks) || { blocked: [], people: [] }; %>
        <script id="commulingo-decision" type="application/json"><%- JSON.stringify({ bookId: lessons.collections[0].id, timeline: timeline, people: links.people || [], blocked: links.blocked || [] }).replace(/</g, '\\u003c') %></script>

        <header class="box commulingo-hero commulingo-hero--graph">
            <div>
                <h1><%= bookTitle %></h1>
                <p><%= bookDescription %></p>
            </div>
        </header>

        <section class="commu-dc" id="commuDecision" aria-label="<%= bookTitle %>"></section>
        <% } else if (isGraph) { %>
        <% var graph = lessons.collections[0].conceptGraph; %>
        <script id="commulingo-graph" type="application/json"><%- JSON.stringify(graph).replace(/</g, '\\u003c') %></script>

        <header class="box commulingo-hero commulingo-hero--graph">
            <div>
                <h1><%= bookTitle %></h1>
                <p><%= bookDescription %></p>
            </div>
        </header>

        <section class="commu-graph" id="commuGraph" aria-label="<%= bookTitle %>"></section>
        <% } else { %>
        <% var commulingoClientBook = Object.assign({}, lessons.collections[0]); delete commulingoClientBook.factionGuide; %>
        <script id="commulingo-data" type="application/json"><%- JSON.stringify({ version: lessons.version, collections: [commulingoClientBook] }).replace(/</g, '\\u003c') %></script>

        <header class="box commulingo-hero">
            <div>
                <h1><%= bookTitle %></h1>
                <p><%= bookDescription %></p>
                <% if (!isDecision && !isGraph) { %>
                <%# Due questions of this book (missed before, scheduled by
                    public/js/commulingo-schedule.js); the script fills the count
                    and hides the button when nothing is due. %>
                <div class="commulingo-review" id="commuReview">
                    <button type="button" class="btn btn-primary is-hidden" id="commuReviewBtn"><%= strings.commuLingo.reviewButton %></button>
                    <small id="commuReviewNote"></small>
                </div>
                <% } %>
            </div>
            <div class="commulingo-total">
                <span id="commuProgressText">0%</span>
                <small><%= strings.commuLingo.progress %></small>
            </div>
        </header>

        <% var factionGuide = lessons.collections[0].factionGuide; %>
        <% var factionText = function(value) { if (typeof value === 'string') return value; return value && (value[lang] || value.ko || value.en) || ''; }; %>
        <% if (factionGuide) { %>
        <section class="box commu-faction-guide" id="faction-guide" aria-labelledby="faction-guide-title">
            <header class="commu-faction-head">
                <p class="commu-faction-eyebrow"><%= factionText(factionGuide.eyebrow) %></p>
                <h2 id="faction-guide-title"><%= factionText(factionGuide.title) %></h2>
                <p class="commu-faction-intro"><%= factionText(factionGuide.intro) %></p>
            </header>
            <p class="commu-faction-caveat"><%= factionText(factionGuide.caveat) %></p>

            <div class="commu-faction-layers">
                <% factionGuide.layers.forEach(function(layer) { %>
                <section class="commu-faction-layer commu-faction-layer--<%= layer.id %>" aria-labelledby="faction-layer-<%= layer.id %>">
                    <header class="commu-faction-layer-head">
                        <span class="commu-faction-step" aria-hidden="true"><%= layer.number %></span>
                        <div>
                            <p class="commu-faction-period"><%= layer.period %></p>
                            <h3 id="faction-layer-<%= layer.id %>"><%= factionText(layer.kind) %></h3>
                            <p><%= factionText(layer.summary) %></p>
                        </div>
                    </header>
                    <% if (layer.axis) { %>
                    <div class="commu-faction-axis" aria-label="<%= lang === 'en' ? 'Left-to-right arrangement' : '왼쪽에서 오른쪽 배치 기준' %>">
                        <span><%= factionText(layer.axis.left) %></span>
                        <span><%= factionText(layer.axis.right) %></span>
                    </div>
                    <% } %>
                    <div class="commu-faction-grid">
                        <% layer.groups.slice().sort(function(a, b) { return (a.order || 0) - (b.order || 0); }).forEach(function(group) { %>
                        <article class="commu-faction-card">
                            <header>
                                <h4><%= factionText(group.name) %></h4>
                                <p><%= factionText(group.alias) %></p>
                            </header>
                            <p class="commu-faction-description"><%= factionText(group.description) %></p>
                            <p class="commu-faction-turn"><strong><%= lang === 'en' ? 'Turning point' : '전환점' %></strong><span><%= factionText(group.turn) %></span></p>
                            <% if (group.people && group.people.length) { %>
                            <div class="commu-faction-people">
                                <span><%= lang === 'en' ? 'People' : '주요 인물' %></span>
                                <ul>
                                    <% group.people.forEach(function(entry) { %>
                                    <li>
                                        <% if (entry.personId) { %><a target="_blank" rel="noopener" href="/commulingo/people/<%= encodeURIComponent(entry.personId) %>"><%= factionText(entry.label) %></a><% } else { %><%= factionText(entry.label) %><% } %>
                                    </li>
                                    <% }) %>
                                </ul>
                            </div>
                            <% } %>
                        </article>
                        <% }) %>
                    </div>
                </section>
                <% }) %>
            </div>

            <section class="commu-faction-timeline" aria-labelledby="faction-timeline-title">
                <h3 id="faction-timeline-title"><%= factionText(factionGuide.timelineTitle) %></h3>
                <ol>
                    <% factionGuide.timeline.forEach(function(item) { %>
                    <li>
                        <time><%= item.date %></time>
                        <strong><%= factionText(item.title) %></strong>
                        <span><%= factionText(item.text) %></span>
                    </li>
                    <% }) %>
                </ol>
            </section>

            <footer class="commu-faction-sources">
                <strong><%= lang === 'en' ? 'Sources for this map' : '관계도 근거' %></strong>
                <ul>
                    <% factionGuide.sources.forEach(function(source) { %>
                    <li><a href="<%= source.href %>" target="_blank" rel="noopener"><%= factionText(source.label) %></a></li>
                    <% }) %>
                </ul>
            </footer>
        </section>
        <% } %>

        <%# Dictionary entries this book's prose actually names, read off the links
            the linkifier found in its lessons. The chapter list is titles and
            one-line summaries, so without this the page gives no sign that the
            people and glossary entries behind it exist. %>
        <%# Every chip opens in a new tab for the same reason the links inside the
            lessons do: leaving the book loses the reader's place in it. %>
        <% var dict = (typeof dictionaryEntries !== 'undefined' && dictionaryEntries) || { people: [], terms: [], events: [] }; %>
        <% var dictGroups = [
               { items: dict.terms || [], base: '/commulingo/terms/', label: lang === 'en' ? 'Terms' : '용어' },
               { items: dict.people || [], base: '/commulingo/people/', label: lang === 'en' ? 'People' : '인물' },
               { items: dict.events || [], base: '/commulingo/events/', label: lang === 'en' ? 'Historical events' : '역사 사건' },
               { items: dict.docs || [], base: '/commulingo/docs/', label: lang === 'en' ? 'Reference texts' : '참고 문헌' }
           ].filter(function(group) { return group.items.length; }); %>
        <% if (dictGroups.length) { %>
        <section class="box commu-book-dictionary" aria-labelledby="book-dictionary">
            <h2 id="book-dictionary"><%= lang === 'en' ? 'Dictionary entries in this book' : '이 책이 다루는 사전 항목' %></h2>
            <% dictGroups.forEach(function(group) { %>
            <h3><%= group.label %></h3>
            <div class="commu-term-chips">
                <% group.items.forEach(function(entry) { %>
                <a class="commu-term-chip" target="_blank" rel="noopener" href="<%= group.base %><%= encodeURIComponent(entry.id) %>"><%= factionText(entry.label) %></a>
                <% }) %>
            </div>
            <% }) %>
        </section>
        <% } %>

        <section class="commulingo-lessons" id="commuLessonList" aria-label="<%= bookTitle %>"></section>

        <section class="commu-quiz is-hidden" id="commuQuiz" aria-live="polite">
            <div class="commu-quiz-top">
                <button type="button" class="btn btn-secondary" id="commuBackBtn"><%= strings.commuLingo.backToLessons %></button>
                <div class="commu-quiz-meter">
                    <span id="commuQuestionCount"></span>
                    <div class="commu-meter-track"><div id="commuMeterFill"></div></div>
                </div>
            </div>

            <article class="commu-question">
                <p class="commu-lesson-title" id="commuLessonTitle"></p>
                <section class="commu-intro is-hidden" id="commuIntro" aria-label="Concept brief">
                    <h2 id="commuIntroTitle"></h2>
                    <p class="commu-intro-summary" id="commuIntroSummary"></p>
                    <p class="commu-intro-focus" id="commuIntroFocus"></p>
                    <div class="commu-diagram" id="commuDiagram" aria-label="Concept diagram"></div>
                </section>
                <p class="commu-question-focus is-hidden" id="commuFocus"></p>
                <h2 id="commuPrompt"></h2>
                <div class="commu-choices" id="commuChoices"></div>
                <div class="commu-feedback is-hidden" id="commuFeedback"></div>
                <div class="commu-quiz-actions">
                    <button type="button" class="btn btn-primary" id="commuNextBtn" disabled><%= strings.commuLingo.next %></button>
                    <button type="button" class="btn btn-secondary is-hidden" id="commuNextLessonBtn"></button>
                </div>
            </article>
        </section>
        <% } %>
        <% if (!isGraph && !isDecision) { %><%- include('../partials/commulingo-measurement') %><% } %>
    </main>

    <%- include('../partials/footer') %>
    <script>
        window.COMMULINGO_STRINGS = <%- JSON.stringify(strings.commuLingo).replace(/</g, '\\u003c') %>;
    </script>
    <% if (isDecision) { %>
    <script src="/js/commulingo-name-context.js?v=<%= assetVersion %>"></script>
    <script src="/js/commulingo-decision.js?v=<%= assetVersion %>"></script>
    <% } else if (isGraph) { %>
    <script src="/js/commulingo-graph.js?v=<%= assetVersion %>"></script>
    <% } else { %>
    <script src="/js/commulingo-schedule.js?v=<%= assetVersion %>"></script>
    <script src="/js/commulingo.js?v=<%= assetVersion %>"></script>
    <% } %>
</body>
</html>
