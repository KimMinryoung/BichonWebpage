<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>

    <% var en = lang === 'en'; %>
    <main class="container commulingo-shell commu-person-hub-page" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [
                { label: en ? 'People' : '인물 사전', href: '/commulingo/people' },
                { label: label },
            ],
            dictJump: 'people' }) %>

        <header class="commu-hub-head commu-role-hub-head">
            <div>
                <h1><%= label %></h1>
                <p><%= note %></p>
            </div>
        </header>

        <section class="commu-hub-section" aria-labelledby="retired-role-links">
            <h2 id="retired-role-links"><%= en ? 'Find them here' : '여기서 찾기' %></h2>
            <div class="commu-office-grid">
            <% links.forEach(function(link) { %>
                <a class="commu-office-card commu-role-category-link" href="<%= link.href %>">
                    <span class="commu-office-icon" aria-hidden="true"><%- roleIconSvg(link.icon) %></span>
                    <span class="commu-role-category-copy"><h3><%= link.label %></h3></span>
                    <span aria-hidden="true">→</span>
                </a>
            <% }) %>
            </div>
        </section>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
