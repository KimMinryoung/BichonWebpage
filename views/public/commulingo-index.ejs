<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
</head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>

    <main class="container commulingo-shell" data-lang="<%= lang %>">
        <script id="commulingo-books" type="application/json"><%- JSON.stringify(books).replace(/</g, '\\u003c') %></script>

        <header class="box commulingo-hero">
            <div>
                <h1><%= strings.commuLingo.title %></h1>
                <p><%= strings.commuLingo.description %></p>
            </div>
            <div class="commulingo-total">
                <span id="commuProgressText">0%</span>
                <small><%= strings.commuLingo.progress %></small>
            </div>
        </header>

        <a class="commulingo-resume is-hidden" id="commuResume" href="#"></a>

        <%
        // One tile per dictionary/library section, mirroring the five-tab
        // switcher inside the dictionary pages.
        var dictTiles = [
            { href: '/commulingo/people', icon: 'user', label: strings.commuLingo.dictPeople, short: strings.commuLingo.dictPeopleShort },
            { href: '/commulingo/events', icon: 'flag', label: strings.commuLingo.dictEvents, short: strings.commuLingo.dictEventsShort },
            { href: '/commulingo/terms', icon: 'book-open', label: strings.commuLingo.dictTerms, short: strings.commuLingo.dictTermsShort },
            { href: '/commulingo/genealogy', icon: 'git-branch', label: strings.commuLingo.dictGenealogy, short: strings.commuLingo.dictGenealogyShort },
            { href: '/commulingo/docs', icon: 'landmark', label: strings.commuLingo.dictDocs, short: strings.commuLingo.dictDocsShort },
        ];
        %>
        <section class="commu-dict-section" aria-label="<%= strings.commuLingo.dictSectionTitle %>">
            <div class="commu-dict-section-head">
                <h2><%= strings.commuLingo.dictSectionTitle %></h2>
                <p><%= strings.commuLingo.dictSectionHint %></p>
            </div>
            <div class="commu-dict-tiles">
                <% dictTiles.forEach(function(tile) { %>
                <a class="commu-dict-tile" href="<%= tile.href %>">
                    <%- roleIconSvg(tile.icon) %>
                    <span class="commu-dict-tile-label" data-short="<%= tile.short %>"><%= tile.label %></span>
                </a>
                <% }) %>
            </div>
        </section>

        <section class="commulingo-books-head" aria-hidden="true">
            <h2><%= strings.commuLingo.chooseBook %></h2>
            <p><%= strings.commuLingo.chooseBookHint %></p>
        </section>

        <section class="commulingo-book-groups" id="commuBookList" aria-label="<%= strings.commuLingo.chooseBook %>"></section>
    </main>

    <%- include('../partials/footer') %>
    <script>
        window.COMMULINGO_STRINGS = <%- JSON.stringify(strings.commuLingo).replace(/</g, '\\u003c') %>;
    </script>
    <script src="/js/commulingo-index.js?v=<%= assetVersion %>"></script>
</body>
</html>
