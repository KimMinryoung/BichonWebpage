<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>

    <main class="container commulingo-shell commulingo-home" data-lang="<%= lang %>">
        <header class="box commulingo-hero commulingo-hero--home">
            <div class="commulingo-hero-main">
                <h1><%= strings.commuLingo.title %></h1>
            </div>
            <p class="commulingo-home-description"><%= strings.commuLingo.description %></p>
            <div class="commulingo-hero-dict">
                <span class="commulingo-hero-dict-label"><%= strings.commuLingo.learn %></span>
                <%- include('../partials/commulingo-learn-nav', { active: null }) %>
            </div>
            <div class="commulingo-hero-dict">
                <span class="commulingo-hero-dict-label"><%= strings.commuLingo.dictSectionTitle %></span>
                <%- include('../partials/commulingo-dict-nav', { active: null }) %>
                <%- include('../partials/site-search-form', { searchForm: { scope: 'commulingo', mode: 'inline' } }) %>
            </div>
        </header>

        <%- include('../partials/commulingo-course-preview', { bookGroups }) %>

        <%- include('../partials/commulingo-updates', { updateGroups }) %>
    </main>

    <%- include('../partials/footer') %>
    <script defer src="/js/commulingo-index.js?v=<%= assetVersion %>"></script>
</body>
</html>
