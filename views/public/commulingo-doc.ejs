<!doctype html>
<html lang="<%= docLang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= pageTitle %> | <%= strings.siteName %></title>
<meta name="description" content="<%= pageDescription %>">
<link rel="icon" href="https://assets.cyber-lenin.com/favicon.ico" type="image/x-icon">
<link rel="preload" href="/fonts/pretendard/PretendardVariable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/ibm-plex/ibm-plex-sans-400.ttf" as="font" type="font/ttf" crossorigin>
<link rel="preload" href="/fonts/ibm-plex/ibm-plex-sans-600.ttf" as="font" type="font/ttf" crossorigin>
<script>
(function(){
    var t = 'dark';
    try {
        t = localStorage.getItem('theme') || t;
    } catch (e) {}
    if (t !== 'light' && t !== 'dark') t = 'dark';
    document.documentElement.setAttribute('data-theme', t);
})();
</script>
<link rel="stylesheet" href="/css/palette.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/commulingo-doc.css?v=<%= assetVersion %>">
</head>
<body class="nav-collapsed">
<% var en = lang === 'en'; %>
<header class="doc-topbar">
    <a href="/commulingo/docs">← <%= en ? 'Reference Library' : '참고 문헌' %></a>
    <%# 인물·용어·사건은 새 탭으로 — 긴 문서를 읽던 자리를 잃지 않도록. 위의 목록
        복귀 링크와 아래 목차·페이저는 읽기 흐름 안의 이동이라 같은 탭을 유지한다. %>
    <% doc.people.forEach(function(person) { %>
    <a href="/commulingo/people/<%= person.id %>" target="_blank" rel="noopener"><%= person.name %> →</a>
    <% }) %>
    <% doc.terms.forEach(function(term) { %>
    <a href="/commulingo/terms/<%= term.id %>" target="_blank" rel="noopener"><%= term.name %> →</a>
    <% }) %>
    <% doc.events.forEach(function(event) { %>
    <a href="/commulingo/events/<%= event.id %>" target="_blank" rel="noopener"><%= event.name %> →</a>
    <% }) %>
</header>
<div class="doc-nav-group" id="docNavGroup">
    <%- include('../partials/nav') %>
</div>
<main class="book">
<% if (pagination) { %>
<script>
// Anchor arrivals on a paginated document land on whichever page was
// requested; if the target section lives on another page, hop there before
// the reader starts scrolling.
(function () {
    var map = <%- JSON.stringify(idToPage) %>;
    var hash = window.location.hash.slice(1);
    if (hash && map[hash] && map[hash] !== <%= pagination.current %>) {
        window.location.replace('?p=' + map[hash] + '#' + hash);
    }
})();
</script>
<% } %>
<%- bodyTopHtml %>
<%
// On a paginated document the TOC is the hub: entries link to the page that
// holds their section (plus the anchor); on a single-scroll document they
// stay plain fragment links.
var tocHref = function(id) {
    if (!pagination || !idToPage || !idToPage[id] || idToPage[id] === pagination.current) return '#' + id;
    return '?p=' + idToPage[id] + '#' + id;
};
%>
<%# 스크롤을 따라오는 컨트롤 바. 목차만 따라오고 메뉴 버튼은 맨 위에 남아
    있으면, 문서 중간에서 메뉴를 열려고 꼭대기까지 올라가야 한다. 둘을 한 줄에
    묶어 왼쪽 메뉴 / 오른쪽 목차로 둔다. 목차가 없는 문서에서도 바는 남는다. %>
<nav class="doc-toc" aria-label="<%= en ? 'Document controls' : '문서 도구' %>">
<button
    type="button"
    class="doc-nav-toggle"
    id="docNavToggle"
    aria-expanded="false"
    aria-controls="docNavGroup"
    aria-label="<%= strings.siteName %>"
>
    <span class="doc-nav-toggle-icon" aria-hidden="true"></span>
</button>
<% if (toc.length) { %>
<details>
<summary><%= en ? 'Table of contents' : '목차' %><% if (pagination) { %> <span class="doc-toc-pos"><%= pagination.current %>/<%= pagination.total %></span><% } %></summary>
<ol class="doc-toc-parts">
    <% toc.forEach(function(part) { %>
    <li>
        <% if (part.id) { %><a class="doc-toc-part" href="<%= tocHref(part.id) %>"><%= part.text %></a><% } %>
        <% if (part.chapters.length) { %>
        <ol class="doc-toc-chapters">
            <% part.chapters.forEach(function(chapter) { %>
            <li><a href="<%= tocHref(chapter.id) %>"><%= chapter.text %></a></li>
            <% }) %>
        </ol>
        <% } %>
    </li>
    <% }) %>
</ol>
</details>
<% } %>
</nav>
<%- bodyRestHtml %>
<% if (pagination) { %>
<nav class="doc-pager" aria-label="<%= en ? 'Pages' : '페이지 이동' %>">
    <% if (pagination.current > 1) { %>
    <a class="doc-pager-prev" href="?p=<%= pagination.current - 1 %>">← <%= pagination.prevHeading || (en ? 'Previous' : '이전') %></a>
    <% } else { %><span class="doc-pager-gap"></span><% } %>
    <span class="doc-pager-pos"><%= pagination.current %> / <%= pagination.total %></span>
    <% if (pagination.current < pagination.total) { %>
    <a class="doc-pager-next" href="?p=<%= pagination.current + 1 %>"><%= pagination.nextHeading || (en ? 'Next' : '다음') %> →</a>
    <% } else { %><span class="doc-pager-gap"></span><% } %>
</nav>
<% } %>
<footer class="doc-colophon">
    <% if (doc.source) { %><p><%= en ? 'Source' : '원전' %>: <%= doc.source %></p><% } %>
    <p><a href="/commulingo/docs"><%= en ? 'CommuLingo Reference Library' : '공산링고 참고 문헌' %></a></p>
</footer>
</main>
<% if (toc.length) { %>
<script>
// Collapse the contents panel when a reader picks an entry. It is a sticky
// <nav>, so leaving it open pins a full-height panel over the section just
// jumped to. Closing it here, synchronously in the click, shrinks the layout
// before the browser resolves the fragment, so the heading lands where the
// reader expects it.
(function () {
    var details = document.querySelector('.doc-toc details');
    if (!details) return;
    details.addEventListener('click', function (event) {
        var link = event.target.closest('a[href^="#"]');
        if (link) details.open = false;
    });
})();
</script>
<% } %>
<script>
// 접이식 상단 메뉴. 상태 클래스는 body에 둔다 — 래퍼를 새로 씌우면 .book의
// 폭·여백 계산이 흔들린다.
// 이 스크립트는 문서 끝에 있어야 한다. 버튼이 sticky 컨트롤 바(본문 뒤) 안에
// 있으므로, 앞쪽에서 실행하면 getElementById가 null을 받고 조용히 빠져나가
// 클릭이 먹지 않는다.
(function () {
    var toggle = document.getElementById('docNavToggle');
    if (!toggle) return;
    toggle.addEventListener('click', function () {
        var collapsed = document.body.classList.toggle('nav-collapsed');
        toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
    });
})();
</script>
</body>
</html>
