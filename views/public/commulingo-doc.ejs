<!doctype html>
<html lang="<%= docLang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= pageTitle %> | <%= strings.siteName %></title>
<meta name="description" content="<%= pageDescription %>">
<% const seoUrlLang = urlLanguage === 'en' ? 'en' : 'ko'; %>
<% const koUrl = siteOrigin + languageUrl(pagePath, 'ko'); %>
<% const enUrl = siteOrigin + languageUrl(pagePath, 'en'); %>
<% const canonicalUrl = seoUrlLang === 'en' ? enUrl : koUrl; %>
<link rel="canonical" href="<%= canonicalUrl %>">
<meta name="robots" content="<%= noindex ? 'noindex, follow' : 'index, follow' %>">
<link rel="alternate" hreflang="ko" href="<%= koUrl %>">
<% if (alternates.en) { %><link rel="alternate" hreflang="en" href="<%= enUrl %>"><% } %>
<link rel="alternate" hreflang="x-default" href="<%= koUrl %>">
<link rel="alternate" type="application/rss+xml" title="Cyber-Lenin RSS Feed" href="<%= languageUrl('/rss.xml', seoUrlLang) %>">
<link rel="alternate" type="application/atom+xml" title="Cyber-Lenin Atom Feed" href="<%= languageUrl('/atom.xml', seoUrlLang) %>">
<meta property="og:type" content="article">
<meta property="og:title" content="<%= pageTitle %> | <%= strings.siteName %>">
<meta property="og:description" content="<%= pageDescription %>">
<meta property="og:url" content="<%= canonicalUrl %>">
<meta property="og:site_name" content="<%= strings.siteName %>">
<meta property="og:image" content="https://assets.cyber-lenin.com/og-image.jpg">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= pageTitle %> | <%= strings.siteName %>">
<meta name="twitter:description" content="<%= pageDescription %>">
<% if (jsonLd) { %>
<script type="application/ld+json"><%- jsonLdScript(jsonLd) %></script>
<% } %>
<link rel="preconnect" href="https://assets.cyber-lenin.com">
<link rel="icon" href="https://assets.cyber-lenin.com/favicon.ico" type="image/x-icon">
<link rel="apple-touch-icon" href="https://assets.cyber-lenin.com/apple-touch-icon.png">
<%- include('../partials/theme-init') %>
<% if (docLang === 'ko') { %><link rel="preload" href="/fonts/pretendard/PretendardVariable.common.woff2" as="font" type="font/woff2" crossorigin><% } %>
<link rel="stylesheet" href="/css/palette.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/site-core.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/site-prose.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/ui.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/commulingo-crumb.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/commulingo-doc.css?v=<%= assetVersion %>">
</head>
<%# 이 리더는 자체 <head>를 갖지만 몸통은 나머지 공산링고와 같은 차림이다:
    맨 위에 사이트 툴바와 주 메뉴, 그 아래 공통 크럼 바. 예전에는 둘 다 없이
    컨트롤 바 안의 ☰ 버튼이 메뉴를 오버레이로 열었는데, 로고·테마·언어·주
    메뉴가 다른 모든 페이지와 같은 자리에 있으면 그 버튼은 필요가 없다. %>
<%# 건너뛰기 링크는 끈다: 그 스타일은 ui.css에 있고 이 리더는 그 파일을 싣지
    않아, 켜 두면 숨지 않고 화면 왼쪽 위에 그대로 찍힌다. %>
<body class="commulingo-page">
<%- include('../partials/nav', { showSkipLink: false }) %>
<% var en = lang === 'en'; %>
<%# 리더의 스크립트(public/js/commulingo-doc.js)가 읽는 문자열: 주석·인물명 팝오버, 이어 읽기. %>
<main class="book" data-doc-strings="<%= JSON.stringify({ note: strings.commuLingoViews.doc.note, seeInNotes: strings.commuLingoViews.doc.seeInNotes, historicalFigure: strings.commuLingoViews.doc.historicalFigure, resume: strings.commuLingoViews.doc.resume, resumePage: strings.commuLingoViews.doc.resumePage, resumeHeading: strings.commuLingoViews.doc.resumeHeading }) %>">
<%# 분할 문헌의 id → 쪽 지도. 앵커로 도착한 독자를 그 앵커가 있는 쪽으로 보내는 일은
    본문이 그려지기 전에 해야 하므로, 리더 스크립트는 여기서 동기로 싣는다(defer 없음).
    팝오버·목차·전환·이어 읽기는 그 스크립트 안에서 DOM이 준비된 뒤 돈다. %>
<% if (pagination) { %>
<script type="application/json" id="doc-page-map"><%- JSON.stringify(idToPage).replace(/</g, '\\u003c') %></script>
<% } %>
<script src="/js/commulingo-doc.js?v=<%= assetVersion %>"></script>
<%
// On a paginated document the TOC is the hub: entries link to the page that
// holds their section (plus the anchor); on a single-scroll document they
// stay plain fragment links.
var tocHref = function(id) {
    if (!pagination || !idToPage || !idToPage[id] || idToPage[id] === pagination.current) return '#' + id;
    return '?p=' + idToPage[id] + '#' + id;
};
%>
<%# 스크롤을 따라오는 컨트롤 바. 왼쪽은 나머지 공산링고와 똑같은 크럼 파셜이고
    오른쪽 한 칸이 목차다. 크럼은 이 페이지에서도 사전 상세 페이지와 같은 자리,
    같은 모양으로 따라온다. 목차가 없는 문서에서도 바는 크럼만으로 남는다. %>
<div class="doc-toc">
<%- include('../partials/commulingo-crumb', {
    trail: [
        { label: strings.commuLingoViews.doc.referenceLibrary, href: '/commulingo/docs' },
        { label: doc.title },
    ] }) %>
<% if (toc.length) { %>
<nav class="doc-toc-nav" aria-label="<%= strings.commuLingoViews.doc.tableOfContents %>">
<details>
<summary><%= strings.commuLingoViews.doc.contents %><% if (pagination) { %> <span class="doc-toc-pos"><%= pagination.current %>/<%= pagination.total %></span><% } %></summary>
<div class="doc-toc-panel">
<% if (pagination) { %><%- include('../partials/commulingo-doc-page-numbers') %><% } %>
<ol class="doc-toc-parts">
    <% toc.forEach(function(part) { %>
    <li>
        <% if (part.id) { %><a class="doc-toc-part" href="<%= tocHref(part.id) %>"><%= part.text %></a><% } %>
        <% if (part.chapters.length) { %>
        <ol class="doc-toc-chapters">
            <% part.chapters.forEach(function(chapter) { %>
            <li<% if (chapter.level > 2) { %> class="doc-toc-level-<%= chapter.level %>"<% } %>><a href="<%= tocHref(chapter.id) %>"><%= chapter.text %></a></li>
            <% }) %>
        </ol>
        <% } %>
    </li>
    <% }) %>
</ol>
</div>
</details>
</nav>
<% } %>
<%# 문헌 안 키워드 검색: 긴 문헌은 페이지로 나뉘어 브라우저 찾기가 지금 페이지만
    본다. 패널은 서버(/search)가 모든 페이지를 뒤진 결과를 페이지별로 보여 주고,
    고른 곳으로 가면 public/js/commulingo-doc-search.js가 본문(.doc-body)의 일치를
    표시한다. 짧은 문헌도 같은 패널을 쓴다. %>
<% if (!readingOriginal) { %>
<div class="doc-search" data-doc-search
     data-endpoint="<%= languageUrl('/commulingo/docs/' + doc.id + '/search', urlLanguage === 'en' ? 'en' : 'ko') %>"
     data-page="<%= pagination ? pagination.current : 1 %>"
     data-total-pages="<%= pagination ? pagination.total : 1 %>"
     data-strings="<%= JSON.stringify(strings.commuLingoViews.doc.searchUi) %>">
<details>
<summary><svg class="doc-search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg><span><%= strings.commuLingoViews.doc.searchUi.label %></span></summary>
<div class="doc-search-panel">
    <form class="doc-search-form" role="search">
        <input type="search" name="q" maxlength="100" autocomplete="off" enterkeyhint="search"
               placeholder="<%= strings.commuLingoViews.doc.searchUi.placeholder %>" aria-label="<%= strings.commuLingoViews.doc.searchUi.placeholder %>">
        <button type="submit"><%= strings.commuLingoViews.doc.searchUi.submit %></button>
    </form>
    <p class="doc-search-status" aria-live="polite"></p>
    <div class="doc-search-results"></div>
</div>
</details>
</div>
<% } %>
<%# 번역과 원문 사이를 오가는 칸. 원문이 공개된 문헌에만 있다(commulingo_doc_originals).
    원문 쪽에는 검색 칸이 없다 — 검색은 번역 본문을 뒤진다. %>
<% if (switchTo) { %>
<a class="doc-version-switch" href="<%= languageUrl(switchTo.href, urlLanguage === 'en' ? 'en' : 'ko') %>" lang="<%= lang %>" data-anchors="<%= JSON.stringify(switchTo.anchors) %>"><%= switchTo.original ? strings.commuLingoViews.doc.original : strings.commuLingoViews.doc.translation %></a>
<% } %>
</div>
<%- bodyTopHtml %>
<%# 이 문헌이 어느 사전 항목에 속하는지 알리는 한 줄. 제목 바로 아래 산문으로
    두는 편이 상단 칩 줄보다 조용하다 — 읽으러 온 사람의 첫 화면은 제목과 본문
    이어야 하고, 이 줄은 필요할 때만 눈에 들어오면 된다. 링크는 새 탭으로 —
    긴 문서를 읽던 자리를 잃지 않도록. 아래 목차·페이저는 읽기 흐름 안의
    이동이라 같은 탭을 유지한다. %>
<%
var refGroups = [
    { label: strings.commuLingoViews.doc.people, path: 'people', items: doc.people || [] },
    { label: strings.commuLingoViews.doc.terms, path: 'terms', items: doc.terms || [] },
    { label: strings.commuLingoViews.doc.events, path: 'events', items: doc.events || [] },
    { label: strings.commuLingoViews.doc.genealogy, path: 'genealogy',
      items: (doc.genealogies || []).map(function(chart) { return { id: chart.id, name: chart.title }; }) },
].filter(function(group) { return group.items.length; });
var docCourses = doc.courses || [];
%>
<% if (refGroups.length || docCourses.length) { %>
<p class="doc-refs">
    <% refGroups.forEach(function(group) { %>
    <span class="doc-refs-group"><span class="doc-refs-label"><%= group.label %></span><% group.items.forEach(function(item, i) { %><a href="/commulingo/<%= group.path %>/<%= item.id %>" target="_blank" rel="noopener"><%= item.name %></a><%= i < group.items.length - 1 ? ', ' : '' %><% }) %></span>
    <% }) %>
    <% if (docCourses.length) { %>
    <span class="doc-refs-group"><span class="doc-refs-label"><%= strings.commuLingoViews.doc.learn %></span><% docCourses.forEach(function(chapter, i) { %><% if (i === 0 || docCourses[i - 1].bookId !== chapter.bookId) { %><%= chapter.bookTitle %> · <% } %><a href="/commulingo/book/<%= chapter.bookId %>#lesson=<%= encodeURIComponent(chapter.lessonId) %>" target="_blank" rel="noopener"><%= strings.commuLingoViews.practice.chapter.replace('{n}', chapter.chapterNumber) %> <%= chapter.chapterTitle %></a><%= i < docCourses.length - 1 ? ', ' : '' %><% }) %></span>
    <% } %>
</p>
<% } %>
<%# 이어 읽기: 읽던 쪽·절이 브라우저에 남아 있으면 스크립트가 채워 보여 준다. %>
<p class="doc-resume" data-doc-resume data-last-page="<%= pagination ? pagination.total : 1 %>" hidden>
    <a class="doc-resume-link" href="#"></a>
    <button type="button" class="doc-resume-dismiss" aria-label="<%= strings.commuLingoViews.doc.resumeDismiss %>">✕</button>
</p>
<div class="doc-body"><%
// Existing editions carry some of these notes in their editorial box already.
// Keep those in place and show only metadata notes absent from that box.
var editorialText = ((bodyTopHtml || '') + (bodyRestHtml || ''))
    .match(/<aside\b[^>]*class="doc-editorial"[^>]*>[\s\S]*?<\/aside>/g);
var normalizeEditorial = function(text) {
    return text.replace(/<[^>]*>/g, '').replace(/[–—~〜]/g, '-').replace(/\s+/g, ' ');
};
editorialText = normalizeEditorial((editorialText || []).join(' '));
var extraEditorialNotes = (doc.editorialNotes || '').split(/(?<!No\.)(?<=[.!?])\s+/)
    .filter(function(sentence) { return sentence && !editorialText.includes(normalizeEditorial(sentence)); }).join(' ');
var showEditorialNotes = extraEditorialNotes && !readingOriginal && (!pagination || pagination.current === 1);
// The opening 해제 box carries its own folded 번역·편집 정보; the notes join it
// there instead of opening a second box.
var restHtml = bodyRestHtml || '';
var editionAt = restHtml.search(/<details class="doc-edition"><summary>[^<]*<\/summary>/);
var firstHeading = restHtml.search(/<h[12][\s>]/);
if (showEditorialNotes && editionAt !== -1 && (firstHeading === -1 || editionAt < firstHeading)) {
    var summaryEnd = restHtml.indexOf('</summary>', editionAt) + '</summary>'.length;
    var escaped = extraEditorialNotes.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    restHtml = restHtml.slice(0, summaryEnd) + '<p>' + escaped + '</p>' + restHtml.slice(summaryEnd);
    showEditorialNotes = false;
}
%>
<% if (showEditorialNotes) { %>
<aside class="doc-editorial">
    <details class="doc-edition">
        <summary><%= en ? 'Translation and editing' : '번역·편집 정보' %></summary>
        <p><%= extraEditorialNotes %></p>
    </details>
</aside>
<% } %>
<%- restHtml %></div>
<%# 이 쪽이 부르는데 다른 쪽에 있는 주석(docs-store pageNotes). 화면에는 나오지 않고
    주석 번호 위의 팝오버가 여기서 본문을 가져간다. 한 쪽짜리 문헌은 주석이 같은
    화면에 있어 비어 있다. %>
<% if (inlineNotes) { %>
<template class="doc-notes-inline"><ol class="notes-list"><%- inlineNotes %></ol></template>
<% } %>
<% if (pagination) { %>
<nav class="doc-pager" aria-label="<%= strings.commuLingoViews.doc.pages %>">
    <%
    /* The direction word is always printed, not only as a fallback. With a
       chapter heading available the link used to read as just that heading
       with an arrow, so nothing on it said it moved the reader a page. */
    %>
    <% if (pagination.current > 1) { %>
    <a class="doc-pager-prev" href="?p=<%= pagination.current - 1 %>">
        <span class="doc-pager-dir">← <%= strings.commuLingoViews.doc.previous %></span>
        <% if (pagination.prevHeading) { %><span class="doc-pager-heading"><%= pagination.prevHeading %></span><% } %>
    </a>
    <% } %>
    <% if (pagination.current < pagination.total) { %>
    <a class="doc-pager-next" href="?p=<%= pagination.current + 1 %>">
        <span class="doc-pager-dir"><%= strings.commuLingoViews.doc.next %> →</span>
        <% if (pagination.nextHeading) { %><span class="doc-pager-heading"><%= pagination.nextHeading %></span><% } %>
    </a>
    <% } %>
    <%- include('../partials/commulingo-doc-page-numbers') %>
</nav>
<% } %>
<% if (doc.source) { %>
<footer class="doc-colophon">
    <p><%= strings.commuLingoViews.doc.source %>: <%= doc.source %></p>
</footer>
<% } %>
</main>
<%# 주석·인물명 팝오버, 목차 접기, 원문/번역 전환, 이어 읽기는 main 머리에서 실은
    public/js/commulingo-doc.js에 있다. %>
<div class="doc-find" data-doc-find hidden>
    <span class="doc-find-query"></span>
    <span class="doc-find-pos"></span>
    <button type="button" data-find="prev" aria-label="<%= strings.commuLingoViews.doc.searchUi.previous %>">↑</button>
    <button type="button" data-find="next" aria-label="<%= strings.commuLingoViews.doc.searchUi.next %>">↓</button>
    <button type="button" data-find="close" aria-label="<%= strings.commuLingoViews.doc.searchUi.close %>">✕</button>
</div>
<script src="/js/commulingo-doc-search.js?v=<%= assetVersion %>" defer></script>
<%# 테마 토글(#themeToggle) 핸들러는 common.js에 있다. 이 리더는 partials/head를
    쓰지 않고 자체 head를 갖는 탓에 스크립트를 하나도 싣지 않아, nav 파셜이
    가져오는 nav.js(언어 드롭다운)만 동작하고 테마 전환은 죽어 있었다. %>
<script src="/js/common.js?v=<%= assetVersion %>"></script>
</body>
</html>
