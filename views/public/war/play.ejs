<%# The play screen of a war game (public/js/war/ui/game.js fills it).
    Locals: war = { id, map (services/war-map.js), scenario (its data) }. %>
    <div id="cwPlay" data-scenario="<%= war.id %>" hidden>
      <div class="cw-hud">
        <div class="cw-season"><p id="cwDate" class="games-kicker"></p><h2 id="cwTitle"></h2><ol id="cwCalendar" class="cw-calendar" aria-label="<%= war.scenario.ui.aria.calendar %>"></ol></div>
        <dl id="cwStats" class="cw-stats" aria-label="<%= war.scenario.ui.aria.stats %>"></dl>
        <section id="cwArmy" class="cw-army" aria-label="<%= war.scenario.ui.aria.army %>" hidden></section>
      </div>

      <section id="cwCampaign" class="cw-campaign">
        <div id="cwBrief" class="cw-brief"></div>
        <div class="cw-board">
          <section class="cw-map-panel" aria-label="작전 지도">
            <div class="cw-map-heading"><span>작전 지도</span><span id="cwMapCaption"></span><button type="button" id="cwHistoryToggle" class="cw-history-toggle" aria-pressed="false">역사의 세력 범위</button></div>
            <div class="cw-map-frame" id="cwMap" data-points="<%= JSON.stringify(war.map.points) %>" data-phases="<%= JSON.stringify(war.map.phases) %>"><%- war.map.svg %></div>
            <details class="cw-map-key" id="cwMapKey" open><summary>범례</summary><div id="cwMapLegend" class="cw-map-legend"></div></details>
          </section>
          <section id="cwFronts" class="cw-fronts" aria-labelledby="cwFrontsTitle"></section>
        </div>
        <div id="cwUnveil" class="cw-unveil" hidden></div>
        <section id="cwIncident" class="cw-choice cw-incident" aria-labelledby="cwIncidentTitle" hidden></section>
        <section id="cwChoice" class="cw-choice" aria-labelledby="cwChoiceTitle"></section>
        <section id="cwCards" class="cw-cards" aria-labelledby="cwCardsTitle"></section>
        <div class="cw-command" id="cwCommand"><div id="cwTodo" class="cw-todo" aria-label="이 시기에 할 일"></div><p id="cwCommandNote" aria-live="polite"></p><button type="button" id="cwSettle" class="cw-primary">이 시기를 보낸다 →</button></div>
        <section id="cwReview" class="cw-review" hidden aria-labelledby="cwReviewTitle"></section>
      </section>

      <section id="cwBattle" class="cw-battle" hidden aria-labelledby="cwBattleTitle"></section>
      <section id="cwOutcome" class="cw-outcome" hidden aria-labelledby="cwOutcomeTitle"></section>
    </div>
    <p id="cwAnnouncement" class="cw-sr" role="status" aria-live="polite"></p>
