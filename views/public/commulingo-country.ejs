<!DOCTYPE html>
<html lang="<%= lang %>">
<head><%- include('../partials/head') %></head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>
    <% var en = lang === 'en'; var copy = strings.commuLingoViews.worldMap; var orgCount = country.affiliations.reduce(function(sum, group) { return sum + group.rows.length; }, 0); %>
    <main class="container commulingo-shell commu-person-hub-page commu-country-page" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [{ label: copy.title, href: '/commulingo/map' }, { label: country.label }], dictJump: 'map' }) %>

        <header class="commu-hub-head commu-nationality-hub-head">
            <span class="commu-nationality-hub-flag" aria-hidden="true"><%- flagImg(country.code, country.label) %></span>
            <div>
                <span class="commu-nationality-kind"><%= country.kind === 'historical' ? copy.historical : (country.kind === 'region' ? copy.region : copy.country) %></span>
                <h1><%= country.label %></h1>
                <p><%= copy.events %> <%= country.eventCount %> · <%= copy.citizenship %> <%= country.citizenshipCount %> · <%= copy.background %> <%= country.originCount %></p>
            </div>
        </header>

        <section class="commu-world-map-panel is-country" aria-label="<%= country.label %>">
            <%- include('../partials/commulingo-world-map-controls', { copy: copy }) %>
            <div class="commu-world-map" data-world-map><%- mapSvg %></div>
            <p class="commu-world-map-note"><%= country.kind === 'modern' ? copy.boundaryNote : copy.historicalNote %></p>
        </section>

        <% if (country.lineage.length) { %>
        <section class="commu-country-lineage" aria-labelledby="country-lineage">
            <h2 id="country-lineage"><%= copy.lineage %></h2>
            <ol>
                <% country.lineage.forEach(function(row) { var phrase = copy.lineageEvents[row.kind + '.' + row.role].split('{x}'); %>
                <li class="commu-country-lineage-row">
                    <span class="commu-country-lineage-year"><%= row.year %></span>
                    <span class="commu-country-lineage-text"><% if (phrase[0].trim()) { %><span><%= phrase[0].trim() %></span><% } %><% row.countries.forEach(function(item) { %><a href="<%= item.href %>"><%- flagImg(item.code, item.label) %><span><%= item.label %></span></a><% }) %><% if (phrase[1].trim()) { %><span<%- /^\s/.test(phrase[1]) ? '' : ' class="is-attached"' %>><%= phrase[1].trim() %></span><% } %></span>
                </li>
                <% }) %>
            </ol>
        </section>
        <% } %>

        <nav class="commu-country-sections" aria-label="<%= copy.sectionNav %>">
            <a href="#country-events"><span><%= copy.events %></span><strong><%= country.eventCount %></strong></a>
            <a href="#country-organizations"><span><%= copy.organizations %></span><strong><%= orgCount %></strong></a>
            <a href="#country-citizenship"><span><%= copy.citizenship %></span><strong><%= country.citizenshipCount %></strong></a>
            <a href="#country-origin"><span><%= copy.background %></span><strong><%= country.originCount %></strong></a>
        </nav>

        <section class="commu-hub-section" aria-labelledby="country-events">
            <h2 id="country-events" class="commu-country-section-head"><a href="/commulingo/events?country=<%= encodeURIComponent(country.code) %>"><span><%= copy.relatedEvents %> <small><%= country.eventCount %></small></span><span class="commu-country-section-action"><%= en ? 'View all' : '전체보기' %> <span aria-hidden="true">→</span></span></a></h2>
            <% if (country.events.length) { %><ol class="commu-country-timeline">
                <% country.events.forEach(function(event) { %><li><a href="/commulingo/events/<%= encodeURIComponent(event.id) %>"><span class="commu-country-timeline-period"><%= event.period %></span><span class="commu-country-timeline-body"><strong><%= event.title %></strong><% if (event.lead) { %><span><%= event.lead %></span><% } %></span></a></li><% }) %>
            </ol><% } else { %><p class="commu-country-empty"><%= copy.noEvents %></p><% } %>
        </section>
        <section class="commu-hub-section" aria-labelledby="country-organizations">
            <h2 id="country-organizations" class="commu-country-section-head"><span><%= copy.organizations %> <small><%= orgCount %></small></span></h2>
            <%- include('../partials/commulingo-affiliation-groups', { groups: country.affiliations, copy: copy, en: en }) %>
        </section>

        <section class="commu-hub-section" aria-labelledby="country-citizenship">
            <h2 id="country-citizenship" class="commu-country-section-head"><a href="/commulingo/people/citizenship/<%= encodeURIComponent(country.code) %>"><span><%= copy.citizenshipPeople %> <small><%= country.citizenshipCount %></small></span><span class="commu-country-section-action"><%= en ? 'View all' : '전체보기' %> <span aria-hidden="true">→</span></span></a></h2>
            <% if (country.citizenshipPreview.length) { %><div class="commu-people-grid">
                <% country.citizenshipPreview.forEach(function(person) { %><%- include('../partials/commulingo-person-card', { person: person, en: en, roleIconSvg: roleIconSvg, roleHubHref: roleHubHref, flagImg: flagImg, personFlagHref: personFlagHref }) %><% }) %>
            </div><% } else { %><p class="commu-country-empty"><%= copy.noPeople %></p><% } %>
        </section>

        <section class="commu-hub-section" aria-labelledby="country-origin">
            <h2 id="country-origin" class="commu-country-section-head"><a href="/commulingo/people/national-origin/<%= encodeURIComponent(country.code) %>"><span><%= copy.backgroundPeople %> <small><%= country.originCount %></small></span><span class="commu-country-section-action"><%= en ? 'View all' : '전체보기' %> <span aria-hidden="true">→</span></span></a></h2>
            <% if (country.originPreview.length) { %><div class="commu-people-grid">
                <% country.originPreview.forEach(function(person) { %><%- include('../partials/commulingo-person-card', { person: person, en: en, roleIconSvg: roleIconSvg, roleHubHref: roleHubHref, flagImg: flagImg, personFlagHref: personFlagHref }) %><% }) %>
            </div><% } else { %><p class="commu-country-empty"><%= copy.noPeople %></p><% } %>
        </section>

    </main>
    <%- include('../partials/footer') %>
    <%- include('../partials/commulingo-person-card-click-script') %>
    <script src="/js/commulingo-world-map.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
