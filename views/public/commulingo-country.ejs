<!DOCTYPE html>
<html lang="<%= lang %>">
<head><%- include('../partials/head') %></head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>
    <% var en = lang === 'en'; var copy = strings.commuLingoViews.worldMap; %>
    <main class="container commulingo-shell commu-person-hub-page commu-country-page" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [{ label: copy.title, href: '/commulingo/map' }, { label: country.label }], dictJump: 'map' }) %>

        <header class="commu-hub-head commu-nationality-hub-head">
            <span class="commu-nationality-hub-flag" aria-hidden="true"><%- flagImg(country.code, country.label) %></span>
            <div>
                <span class="commu-nationality-kind"><%= country.kind === 'historical' ? copy.historical : (country.kind === 'region' ? copy.region : copy.country) %></span>
                <h1><%= country.label %></h1>
                <p><%= copy.citizenship %> <%= country.citizenshipCount %> · <%= copy.background %> <%= country.originCount %> · <%= copy.events %> <%= country.eventCount %></p>
            </div>
        </header>

        <section class="commu-world-map-panel is-country" aria-label="<%= country.label %>">
            <%- include('../partials/commulingo-world-map-controls', { copy: copy }) %>
            <div class="commu-world-map" data-world-map><%- mapSvg %></div>
            <p class="commu-world-map-note"><%= country.kind === 'modern' ? copy.boundaryNote : copy.historicalNote %></p>
        </section>

        <nav class="commu-country-sections" aria-label="<%= copy.sectionNav %>">
            <a href="#country-citizenship"><span><%= copy.citizenship %></span><strong><%= country.citizenshipCount %></strong></a>
            <a href="#country-origin"><span><%= copy.background %></span><strong><%= country.originCount %></strong></a>
            <a href="#country-events"><span><%= copy.events %></span><strong><%= country.eventCount %></strong></a>
        </nav>

        <section class="commu-hub-section" aria-labelledby="country-citizenship">
            <div class="commu-country-section-head"><h2 id="country-citizenship"><%= copy.citizenshipPeople %> <span><%= country.citizenshipCount %></span></h2></div>
            <% if (country.citizenshipPreview.length) { %><div class="commu-people-grid">
                <% country.citizenshipPreview.forEach(function(person) { %><%- include('../partials/commulingo-person-card', { person: person, groupId: person.groupId, en: en, roleIconSvg: roleIconSvg, roleHubHref: roleHubHref, flagImg: flagImg, nationalityHubHref: nationalityHubHref }) %><% }) %>
            </div><% if (country.citizenshipCount > previewLimit) { %><a class="commu-country-view-all" href="/commulingo/people/citizenship/<%= encodeURIComponent(country.code) %>"><span><%= copy.viewAll %></span><span aria-hidden="true">→</span></a><% } %><% } else { %><p class="commu-country-empty"><%= copy.noPeople %></p><% } %>
        </section>

        <section class="commu-hub-section" aria-labelledby="country-origin">
            <div class="commu-country-section-head"><h2 id="country-origin"><%= copy.backgroundPeople %> <span><%= country.originCount %></span></h2></div>
            <% if (country.originPreview.length) { %><div class="commu-people-grid">
                <% country.originPreview.forEach(function(person) { %><%- include('../partials/commulingo-person-card', { person: person, groupId: person.groupId, en: en, roleIconSvg: roleIconSvg, roleHubHref: roleHubHref, flagImg: flagImg, nationalityHubHref: nationalityHubHref }) %><% }) %>
            </div><% if (country.originCount > previewLimit) { %><a class="commu-country-view-all" href="/commulingo/people/national-origin/<%= encodeURIComponent(country.code) %>"><span><%= copy.viewAll %></span><span aria-hidden="true">→</span></a><% } %><% } else { %><p class="commu-country-empty"><%= copy.noPeople %></p><% } %>
        </section>

        <section class="commu-hub-section" aria-labelledby="country-events">
            <div class="commu-country-section-head"><h2 id="country-events"><%= copy.relatedEvents %> <span><%= country.eventCount %></span></h2></div>
            <% if (country.events.length) { %><div class="commu-event-grid">
                <% country.events.forEach(function(event) { %><a class="commu-event-card" href="/commulingo/events/<%= encodeURIComponent(event.id) %>"><div class="commu-event-meta"><span class="commu-event-period"><%= event.period %></span></div><h3><%= event.title %></h3><p><%= event.summary %></p></a><% }) %>
            </div><% } else { %><p class="commu-country-empty"><%= copy.noEvents %></p><% } %>
        </section>
    </main>
    <%- include('../partials/footer') %>
    <%- include('../partials/commulingo-person-card-click-script') %>
    <script src="/js/commulingo-world-map.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
