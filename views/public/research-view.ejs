<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/report.css?v=<%= assetVersion %>">
    <link rel="alternate" type="text/markdown" href="<%= markdownUrl %>">
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <article class="post-content">
            <% if (typeof isPrivate !== 'undefined' && isPrivate) { %>
                <div class="report-task-label"><%= lang === 'ko' ? '비공개 보고서' : 'Private report' %></div>
            <% } %>
            <h1><%= pageTitle %></h1>
            <div class="post-meta">
                <a href="<%= markdownUrl %>">Markdown</a>
            </div>
            <% if (seriesNav && seriesNav.items && seriesNav.items.length > 1) { %>
                <nav class="research-series-nav" aria-label="<%= lang === 'ko' ? '연재 회차' : 'Series episodes' %>">
                    <div class="research-series-header">
                        <div>
                            <div class="research-series-label"><%= lang === 'ko' ? '연재' : 'Series' %></div>
                            <h2><%= seriesNav.title %></h2>
                        </div>
                        <div class="research-series-actions">
                            <% if (seriesNav.previous) { %>
                                <a href="<%= seriesNav.previous.href %>">&larr; <%= lang === 'ko' ? '이전' : 'Prev' %></a>
                            <% } %>
                            <% if (seriesNav.next) { %>
                                <a href="<%= seriesNav.next.href %>"><%= lang === 'ko' ? '다음' : 'Next' %> &rarr;</a>
                            <% } %>
                        </div>
                    </div>
                    <ol class="research-series-list">
                        <% seriesNav.items.forEach(function(item) { %>
                            <li class="<%= item.current ? 'current' : '' %>">
                                <% if (item.current) { %>
                                    <span>
                                        <span class="research-series-episode"><%= item.episode %></span>
                                        <%= item.title %>
                                    </span>
                                <% } else { %>
                                    <a href="<%= item.href %>">
                                        <span class="research-series-episode"><%= item.episode %></span>
                                        <%= item.title %>
                                    </a>
                                <% } %>
                            </li>
                        <% }) %>
                    </ol>
                </nav>
            <% } %>
            <div class="report-body" id="report-content"><%- htmlBody %></div>

            <%
            var relEvents = typeof relatedEvents !== 'undefined' && relatedEvents ? relatedEvents : [];
            var relPeople = typeof relatedPeople !== 'undefined' && relatedPeople ? relatedPeople : [];
            var relTopics = typeof relatedTopics !== 'undefined' && relatedTopics ? relatedTopics : [];
            var relTerms = typeof relatedTerms !== 'undefined' && relatedTerms ? relatedTerms : [];
            var relDocs = typeof relatedDocs !== 'undefined' && relatedDocs ? relatedDocs : [];
            %>
            <% if (relEvents.length || relPeople.length || relTopics.length || relTerms.length || relDocs.length) { %>
            <aside class="report-related" aria-label="<%= lang === 'ko' ? '연관 사전 항목' : 'Related encyclopedia entries' %>">
                <h2 class="report-related-title"><%= lang === 'ko' ? '연관 사전 항목' : 'Related entries' %></h2>
                <% if (relEvents.length) { %>
                <div class="report-related-events">
                    <% relEvents.forEach(function(event) { %>
                    <a class="report-related-event" href="/commulingo/events/<%= encodeURIComponent(event.id) %>">
                        <span class="report-related-kicker"><%= lang === 'ko' ? '역사 사건' : 'Historical event' %></span>
                        <strong><%= event.title %></strong>
                        <span class="report-related-period"><%= event.period %></span>
                    </a>
                    <% }) %>
                </div>
                <% } %>
                <% if (relTerms.length) { %>
                <div class="report-related-people">
                    <span class="report-related-kicker"><%= lang === 'ko' ? '용어 사전' : 'Glossary' %></span>
                    <% relTerms.forEach(function(term) { %>
                    <a class="report-related-person" href="<%= term.href %>"<% if (term.original) { %> title="<%= term.original %>"<% } %>><%= term.label %></a>
                    <% }) %>
                </div>
                <% } %>
                <% if (relTopics.length) { %>
                <div class="report-related-people">
                    <span class="report-related-kicker"><%= lang === 'ko' ? '분류 · 기관' : 'Categories' %></span>
                    <% relTopics.forEach(function(topic) { %>
                    <a class="report-related-person" href="<%= topic.href %>"><%= topic.label %></a>
                    <% }) %>
                </div>
                <% } %>
                <% if (relDocs.length) { %>
                <div class="report-related-people">
                    <span class="report-related-kicker"><%= lang === 'ko' ? '참고 문헌' : 'Reference library' %></span>
                    <% relDocs.forEach(function(doc) { %>
                    <a class="report-related-person" href="<%= doc.href %>"<% if (doc.note) { %> title="<%= doc.note %>"<% } %>><%= doc.label %></a>
                    <% }) %>
                </div>
                <% } %>
                <% if (relPeople.length) { %>
                <div class="report-related-people">
                    <span class="report-related-kicker"><%= lang === 'ko' ? '인물 사전' : 'People' %></span>
                    <% relPeople.forEach(function(person) { %>
                    <a class="report-related-person" href="/commulingo/people/<%= encodeURIComponent(person.id) %>"<% if (person.epithet) { %> title="<%= person.epithet %>"<% } %>><%= person.displayName || person.name %></a>
                    <% }) %>
                </div>
                <% } %>
            </aside>
            <% } %>
        </article>

        <div class="box post-nav">
            <div class="post-nav-left">
                <a href="/reports">&larr; <%= strings.public.backToList %></a>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
