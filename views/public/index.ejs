<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body class="home-page">
    <%- include('../partials/nav') %>

    <div class="container">
        <!-- Hero / Overview -->
        <header class="box home-hero">
            <div class="home-hero-inner">
                <img class="home-hero-portrait" src="https://assets.cyber-lenin.com/og-image.jpg" alt="Cyber-Lenin" width="180" height="180" loading="eager" decoding="async" fetchpriority="high">
                <div class="home-hero-text">
                    <h1><%= strings.siteTagline %></h1>
                    <p class="home-description"><%= strings.homeDescription %></p>
                </div>
            </div>
        </header>

        <!-- Menu Cards -->
        <div class="home-cards">
            <a href="/chat" class="home-card home-card-full home-card-highlight">
                <h2><%- include('../partials/menu-icon', { icon: 'chat', iconClass: 'home-card-icon' }) %><%= strings.nav.chat %></h2>
                <p><%= strings.home.chatDesc %></p>
            </a>
            <div class="home-card home-card-full home-card-highlight home-card-group">
                <h2><a href="/commulingo"><%- include('../partials/menu-icon', { icon: 'commulingo', iconClass: 'home-card-icon' }) %><%= strings.nav.commuLingo %></a></h2>
                <p><%= strings.home.commuLingoDesc %></p>
                <div class="home-card-links">
                    <a href="/commulingo"><%- include('../partials/menu-icon', { icon: 'quiz', iconClass: 'home-card-link-icon' }) %><span data-short="<%= strings.commuLingo.quizShort %>"><%= strings.commuLingo.quizLabel %></span></a>
                    <a href="/commulingo/people"><%- include('../partials/menu-icon', { icon: 'people', iconClass: 'home-card-link-icon' }) %><span data-short="<%= strings.commuLingo.dictPeopleShort %>"><%= strings.commuLingo.dictPeople %></span></a>
                    <a href="/commulingo/events"><%- include('../partials/menu-icon', { icon: 'events', iconClass: 'home-card-link-icon' }) %><span data-short="<%= strings.commuLingo.dictEventsShort %>"><%= strings.commuLingo.dictEvents %></span></a>
                    <a href="/commulingo/terms"><%- include('../partials/menu-icon', { icon: 'terms', iconClass: 'home-card-link-icon' }) %><span data-short="<%= strings.commuLingo.dictTermsShort %>"><%= strings.commuLingo.dictTerms %></span></a>
                    <a href="/commulingo/docs"><%- include('../partials/menu-icon', { icon: 'docs', iconClass: 'home-card-link-icon' }) %><span data-short="<%= strings.commuLingo.dictDocsShort %>"><%= strings.commuLingo.dictDocs %></span></a>
                </div>
            </div>
            <div class="home-card home-card-full home-card-group">
                <h2><a href="/reports"><%- include('../partials/menu-icon', { icon: 'library', iconClass: 'home-card-icon' }) %><%= strings.nav.library %></a></h2>
                <p><%= strings.home.libraryDesc %></p>
                <div class="home-card-links">
                    <a href="/reports"><%- include('../partials/menu-icon', { icon: 'reports', iconClass: 'home-card-link-icon' }) %><span><%= strings.nav.reportsShort %></span></a>
                    <a href="/hub"><%- include('../partials/menu-icon', { icon: 'hub', iconClass: 'home-card-link-icon' }) %><span><%= strings.nav.hub %></span></a>
                    <a href="/ai-diary"><%- include('../partials/menu-icon', { icon: 'diary', iconClass: 'home-card-link-icon' }) %><span><%= strings.nav.diaryShort %></span></a>
                    <a href="/posts"><%- include('../partials/menu-icon', { icon: 'posts', iconClass: 'home-card-link-icon' }) %><span><%= strings.nav.bichonPosts %></span></a>
                </div>
            </div>
        </div>

        <!-- Recent CommuLingo updates -->
        <% if (recentCommuLingo && recentCommuLingo.length > 0) { %>
            <section class="home-section" aria-labelledby="recent-commulingo-title">
                <div class="home-section-header">
                    <h2 id="recent-commulingo-title"><%= strings.home.recentCommuLingo %></h2>
                    <a href="/commulingo" class="btn btn-small"><%= strings.home.viewAll %></a>
                </div>
                <ul class="post-list">
                    <% recentCommuLingo.forEach(item => { %>
                        <li class="post-item">
                            <h2><a href="<%= item.href %>"><%= item.title %></a></h2>
                            <div class="post-meta">
                                <span class="commu-update-kind"><%= item.typeLabel %></span>
                                <span aria-hidden="true"> · </span>
                                <time class="local-date" datetime="<%= new Date(item.modified).toISOString() %>" data-suffix="<%= strings.home.commuLingoUpdatedAt %>"></time>
                            </div>
                            <div class="commu-update-preview">
                                <% if (item.summary) { %>
                                    <p class="post-excerpt"><%- truncateHtml(sanitize(item.summary), 200) %></p>
                                <% } %>
                                <% if (item.type === 'person' && item.moment) { %>
                                    <p class="post-excerpt commu-update-moment"><%- truncateHtml(sanitize(item.moment), 200) %></p>
                                <% } %>
                                <% if (item.type === 'person' && item.bio) { %>
                                    <p class="post-excerpt"><%- truncateHtml(sanitize(item.bio), 300) %></p>
                                <% } %>
                            </div>
                        </li>
                    <% }) %>
                </ul>
            </section>
        <% } %>

        <!-- Recent Research -->
        <% if (recentResearch && recentResearch.length > 0) { %>
            <section class="home-section">
                <div class="home-section-header">
                    <h2><%= strings.home.recentReports %></h2>
                    <a href="/reports" class="btn btn-small"><%= strings.home.viewAll %></a>
                </div>
                <ul class="post-list">
                    <% recentResearch.forEach(item => { %>
                        <li class="post-item">
                            <h2><a href="<%= item.href %>"><%= item.title %></a></h2>
                            <% if (item.modified) { %>
                                <div class="post-meta">
                                    <time class="local-date" datetime="<%= new Date(item.modified).toISOString() %>" data-suffix="<%= strings.public.postedAt %>"></time>
                                </div>
                            <% } %>
                            <% if (item.summary) { %>
                                <p class="post-excerpt"><%= item.summary %></p>
                            <% } %>
                        </li>
                    <% }) %>
                </ul>
            </section>
        <% } %>

        <!-- Recent Hub -->
        <% if (recentHub && recentHub.length > 0) { %>
            <section class="home-section">
                <div class="home-section-header">
                    <h2><%= strings.home.recentHub %></h2>
                    <a href="/hub" class="btn btn-small"><%= strings.home.viewAll %></a>
                </div>
                <ul class="post-list">
                    <% recentHub.forEach(it => { %>
                        <li class="post-item">
                            <h2><a href="/hub/<%= it.slug %>"><%= it.title %></a></h2>
                            <div class="post-meta">
                                <% if (it.source_publication) { %>
                                    <span class="hub-source"><%= it.source_publication %></span>
                                <% } %>
                                <% if (it.published_at) { %>
                                    <time class="local-date" datetime="<%= it.published_at %>" data-suffix="<%= lang === 'ko' ? '에 선정' : ', curated' %>"></time>
                                <% } %>
                            </div>
                            <% if (it.context) { %>
                                <p class="post-excerpt"><%= it.context.substring(0, 180) %><%= it.context.length > 180 ? '…' : '' %></p>
                            <% } %>
                        </li>
                    <% }) %>
                </ul>
            </section>
        <% } %>

        <!-- Recent AI Diaries -->
        <% if (recentDiaries && recentDiaries.length > 0) { %>
            <section class="home-section">
                <div class="home-section-header">
                    <h2><%= strings.home.recentDiaries %></h2>
                    <a href="/ai-diary" class="btn btn-small"><%= strings.home.viewAll %></a>
                </div>
                <ul class="post-list">
                    <% recentDiaries.forEach(diary => { %>
                        <li class="post-item">
                            <h2><a href="/ai-diary/<%= diary.id %>"><%= diary.title %></a></h2>
                            <div class="post-meta">
                                <time class="local-date" datetime="<%= new Date(diary.created_at).toISOString() %>" data-suffix="<%= strings.public.postedAt %>"></time>
                            </div>
                            <p class="post-excerpt"><%- truncateHtml(sanitize(diary.content), 200) %></p>
                        </li>
                    <% }) %>
                </ul>
            </section>
        <% } %>

        <!-- Recent Posts -->
        <% if (recentPosts && recentPosts.length > 0) { %>
            <section class="home-section">
                <div class="home-section-header">
                    <h2><%= strings.home.recentPosts %></h2>
                    <a href="/posts" class="btn btn-small"><%= strings.home.viewAll %></a>
                </div>
                <ul class="post-list">
                    <% recentPosts.forEach(post => { %>
                        <li class="post-item">
                            <h2><a href="/post/<%= post.id %>"><%= post.title %></a></h2>
                            <div class="post-meta">
                                <time class="local-date" datetime="<%= new Date(post.created_at).toISOString() %>" data-suffix="<%= strings.public.postedAt %>"></time>
                            </div>
                            <p class="post-excerpt"><%- truncateHtml(sanitize(post.content), 200) %></p>
                        </li>
                    <% }) %>
                </ul>
            </section>
        <% } %>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
