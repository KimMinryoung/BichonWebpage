<!DOCTYPE html>
<html lang="ko">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <header class="box">
            <h1><%= strings.siteTagline %></h1>
        </header>

        <% if (posts && posts.length > 0) { %>
            <ul class="post-list">
                <% posts.forEach(post => { %>
                    <li class="post-item">
                        <h2><a href="/post/<%= post.id %>"><%= post.title %></a></h2>
                        <div class="post-meta">
                            <%= new Date(post.created_at).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' }) %><%= strings.public.postedAt %>
                        </div>
                        <p class="post-excerpt">
                            <%- truncateHtml(post.content, 200) %>
                        </p>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <div class="box">
                <p><%= strings.public.noPosts %></p>
            </div>
        <% } %>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
