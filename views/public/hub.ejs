<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <%- include('../partials/library-tabs', { active: 'hub' }) %>

        <% if (items && items.length > 0) { %>
            <ul class="post-list">
                <% items.forEach(it => { %>
                    <li class="post-item">
                        <div>
                            <h2><a href="/hub/<%= it.slug %>"><%= it.title %></a></h2>
                            <div class="post-meta">
                                <% if (it.source_publication) { %>
                                    <span class="hub-source"><%= it.source_publication %></span>
                                <% } %>
                                <% if (it.source_author) { %>
                                    <span class="hub-author"><%= it.source_author %></span>
                                <% } %>
                                <% if (it.published_at) { %>
                                    <time class="local-date" datetime="<%= it.published_at %>" data-suffix="<%= lang === 'ko' ? '에 선정' : ', curated' %>"></time>
                                <% } %>
                            </div>
                            <% if (it.context) { %>
                                <p class="post-excerpt"><%= it.context.substring(0, 220) %><%= it.context.length > 220 ? '…' : '' %></p>
                            <% } %>
                            <% if (it.tags && it.tags.length > 0) { %>
                                <div class="hub-tags">
                                    <% it.tags.forEach(tag => { %>
                                        <span class="hub-tag">#<%= tag %></span>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>
                    </li>
                <% }) %>
            </ul>

            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <%- include('../partials/pagination', {
                    currentPage: currentPage,
                    totalPages: totalPages,
                    baseUrl: paginationBase
                }) %>
            <% } %>
        <% } else { %>
            <div class="box">
                <p><%= lang === 'ko' ? '아직 큐레이션이 없습니다.' : 'No curations yet.' %></p>
            </div>
        <% } %>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
