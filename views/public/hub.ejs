<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <%- include('../partials/library-tabs', { active: 'hub' }) %>

        <%- include('../partials/library-search', { section: 'hub' }) %>
        <% if (typeof loadFailed !== 'undefined' && loadFailed) { %>
            <div class="box"><p><%= strings.public.listUnavailable %></p></div>
        <% } else { %>
            <% if (items.length === 0 && !searchValue) { %>
                <div class="box"><p><%= lang === 'ko' ? '아직 큐레이션이 없습니다.' : 'No curations yet.' %></p></div>
            <% } %>
            <ul class="post-list library-list" id="library-list" data-search-endpoint="/hub/search" data-page="<%= pagination.current %>">
                <%- include('../partials/library-hub-items', { items: items }) %>
            </ul>
            <%- include('../partials/commulingo-list-pager', { pagination: pagination, target: '#library-list' }) %>
        <% } %>
    </div>

    <%- include('../partials/footer') %>
    <script src="/js/commulingo-search-utils.js?v=<%= assetVersion %>"></script>
    <script src="/js/commulingo-dict-search.js?v=<%= assetVersion %>"></script>
</body>
</html>
