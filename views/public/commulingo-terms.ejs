<!DOCTYPE html>
<html lang="<%= lang %>">
<head><%- include('../partials/head') %></head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>
    <% var en = lang === 'en'; %>
    <main class="container commulingo-shell commu-terms-page" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [{ label: strings.commuLingoViews.terms.glossary }],
            dictJump: 'terms' }) %>
        <h1 class="commu-sr-only"><%= strings.commuLingoViews.terms.glossary %></h1>
        <div class="commu-dict-toolbar">
            <nav class="commu-dict-sort" aria-label="<%= strings.commuLingoViews.terms.sortOrder %>">
                <a href="/commulingo/terms" class="<%= sort === 'name' ? 'is-active' : '' %>"
                    <% if (sort === 'name') { %>aria-current="true"<% } %>><%= strings.commuLingoViews.terms.aZ %></a>
                <a href="/commulingo/terms?sort=chrono" class="<%= sort === 'chrono' ? 'is-active' : '' %>"
                    <% if (sort === 'chrono') { %>aria-current="true"<% } %>><%= strings.commuLingoViews.terms.chronological %></a>
            </nav>
        </div>
        <%- include('../partials/commulingo-dict-search', {
            target: '#commu-term-list',
            placeholder: strings.commuLingoViews.terms.searchByTermOriginal,
            ariaLabel: strings.commuLingoViews.terms.searchGlossary,
            clearLabel: strings.commuLingoViews.terms.clearSearch,
            resultOne: strings.commuLingoViews.terms.termFound,
            resultMany: strings.commuLingoViews.terms.termsFound,
            emptyLabel: strings.commuLingoViews.terms.noGlossaryTermsFound
        }) %>
        <div class="commu-dict-chips" data-commu-dict-chips data-target="#commu-term-list"
            role="group" aria-label="<%= strings.commuLingoViews.terms.filterByCategory %>">
            <button type="button" class="commu-dict-chip is-active" data-category="" aria-pressed="true"><%= strings.commuLingoViews.terms.all %></button>
            <% categories.forEach(function(category) { %>
            <button type="button" class="commu-dict-chip" data-category="<%= category.id || '__none__' %>" aria-pressed="false"><%= category.label %> <span><%= category.count %></span></button>
            <% }) %>
        </div>
        <% if (groups.length > 1) { %>
        <nav class="commu-dict-index" aria-label="<%= strings.commuLingoViews.terms.jumpToGroup %>">
            <% groups.forEach(function(group) { %>
            <a href="#<%= group.id %>"><%= group.label %></a>
            <% }) %>
        </nav>
        <% } %>
        <%
        // Shell only: group headings render now, the first group's cards come
        // inlined (memoized server-side), and the rest are fetched from
        // /commulingo/terms/cards as the reader browses a group. Search has
        // its own paginated endpoint and does not need those fragments. The <noscript> lists keep every term
        // reachable for crawlers and script-less readers.
        %>
        <section class="commu-event-grid" id="commu-term-list" data-lazy data-search-endpoint="/commulingo/terms/search" data-sort="<%= sort %>"
            aria-label="<%= strings.commuLingoViews.terms.glossaryTerms %>">
            <% groups.forEach(function(group) { %>
            <h2 class="commu-term-group-head" id="<%= group.id %>"
                <% if (group.id !== firstGroupId) { %>data-pending<% } %>><%= group.label %></h2>
            <% if (group.id === firstGroupId) { %>
            <%- firstGroupHtml %>
            <% } else { %>
            <noscript>
                <ul class="commu-people-noscript-list">
                    <% group.terms.forEach(function(term) { %>
                    <li><a href="/commulingo/terms/<%= term.id %>"><%= term.term %></a></li>
                    <% }) %>
                </ul>
            </noscript>
            <% } %>
            <% }) %>
        </section>
    </main>
    <%- include('../partials/footer') %>
    <script src="/js/commulingo-term-groups.js?v=<%= assetVersion %>"></script>
    <script src="/js/commulingo-search-utils.js?v=<%= assetVersion %>"></script>
    <script src="/js/commulingo-dict-search.js?v=<%= assetVersion %>"></script>
</body>
</html>
