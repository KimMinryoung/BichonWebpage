<!DOCTYPE html>
<html lang="<%= lang %>">
<head><%- include('../partials/head') %></head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>
    <main class="container commulingo-shell commu-genealogy-page" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [{ label: strings.commuLingoViews.genealogies.genealogy }],
            dictJump: 'genealogy' }) %>
        <h1 class="commu-sr-only"><%= strings.commuLingoViews.genealogies.genealogyCharts %></h1>
        <section class="commu-event-grid" id="commu-genealogy-list" aria-label="<%= strings.commuLingoViews.genealogies.genealogyCharts2 %>">
            <% groups.forEach(function(group) { %>
            <% if (group.label) { %><h2 class="commu-term-group-head" id="<%= group.id %>"><%= group.label %></h2><% } %>
            <% group.charts.forEach(function(chart) { %>
            <a class="commu-event-card" href="/commulingo/genealogy/<%= chart.id %>">
                <span class="commu-event-period"><%= chart.period %></span>
                <h3><%= chart.title %></h3>
                <p><%= chart.description %></p>
            </a>
            <% }) %>
            <% }) %>
        </section>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
