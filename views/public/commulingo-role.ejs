<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>

    <% var en = lang === 'en'; %>
    <main class="container commulingo-shell commu-person-hub-page" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [
                { label: strings.commuLingoViews.role.people, href: '/commulingo/people' },
                { label: category.label },
            ],
            dictJump: 'people' }) %>

        <header class="commu-hub-head commu-role-hub-head">
            <span class="commu-person-medal" aria-hidden="true"><%- roleIconSvg(category.icon) %></span>
            <div>
                <h1><%= category.label %></h1>
                <p><%= people.length %> <%= en ? (people.length === 1 ? 'person' : 'people') : '명' %></p>
            </div>
        </header>

        <section class="commu-hub-section" aria-labelledby="role-people">
            <h2 id="role-people"><%= strings.commuLingoViews.role.people2 %></h2>
            <div class="commu-people-grid">
                <% people.forEach(function(person) { %>
                <%- include('../partials/commulingo-person-card', { person: person, groupId: person.groupId, en: en, roleIconSvg: roleIconSvg, roleHubHref: roleHubHref, flagImg: flagImg }) %>
                <% }) %>
            </div>
        </section>

        <% if (typeof relatedReports !== 'undefined' && relatedReports && relatedReports.length) { %>
        <section class="commu-hub-section commu-related-reports" aria-labelledby="related-reports">
            <h2 id="related-reports"><%= strings.commuLingoViews.role.relatedReports %></h2>
            <ul class="commu-related-report-list">
                <% relatedReports.forEach(function(report) { %>
                <li><a href="<%= report.href %>"><span><%= report.dateLabel || (strings.commuLingoViews.role.report) %></span><strong><%= report.title %></strong></a></li>
                <% }) %>
            </ul>
        </section>
        <% } %>
    </main>

    <%- include('../partials/footer') %>
    <%- include('../partials/commulingo-person-card-click-script') %>
</body>
</html>
