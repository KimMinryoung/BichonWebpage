<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>

    <% var en = lang === 'en'; %>
    <main class="container commulingo-shell commu-person-hub-page" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [
                { label: strings.commuLingoViews.office.lineages, href: '/commulingo/offices' },
                { label: office.title },
            ],
            dictJump: 'people' }) %>

        <header class="commu-hub-head commu-role-hub-head">
            <span class="commu-person-medal" aria-hidden="true"><%- roleIconSvg(office.icon) %></span>
            <div>
                <span class="commu-office-range"><%= office.range %></span>
                <h1><%= office.title %></h1>
                <p><%= office.blurb %></p>
                <p><a class="btn btn-small" href="/commulingo/people?affiliation=state-soviet&amp;office=<%= office.id %>"><%= en ? 'People who worked in this line' : '이 기관 계열에서 활동한 인물' %> →</a></p>
            </div>
        </header>

        <% if (office.lineage && office.lineage.length) { %>
        <section class="commu-hub-section" aria-labelledby="office-lineage">
            <h2 id="office-lineage"><%= strings.commuLingoViews.office.organizationalLineage %></h2>
            <ol class="commu-office-lineage">
                <% office.lineage.forEach(function(step) { %>
                <li class="commu-lineage-step">
                    <div class="commu-lineage-node">
                        <strong><% if (step.termHref) { %><a href="<%= step.termHref %>"><%= step.name %></a><% } else { %><%= step.name %><% } %></strong>
                        <span class="commu-office-years"><%= step.period %></span>
                    </div>
                    <p><%= step.body %></p>
                </li>
                <% }) %>
            </ol>
        </section>
        <% } %>

        <% if (rosters && rosters.length) { %>
        <section class="commu-hub-section" aria-labelledby="office-rosters">
            <h2 id="office-rosters"><%= strings.commuLingoViews.office.rosters %></h2>
            <%- include('../partials/commulingo-office-index', { bodies: rosters, offices: [] }) %>
        </section>
        <% } %>

        <% office.tracks.forEach(function(track, index) { %>
        <section class="commu-hub-section" aria-labelledby="office-track-<%= index %>">
            <h2 id="office-track-<%= index %>"><%= track.title || strings.commuLingoViews.office.leadershipTimeline %></h2>
            <% if (track.blurb) { %><p class="commu-office-track-blurb"><%= track.blurb %></p><% } %>
            <ol class="commu-office-rows commu-hub-office-rows">
                <% track.rows.forEach(function(row) { %>
                <li>
                    <<%= row.personId ? 'a' : 'div' %> class="commu-office-row"<% if (row.personId) { %> href="/commulingo/people/<%= row.personId %>"<% } %>>
                        <span class="commu-office-years"><%= row.years %></span>
                        <span class="commu-office-main">
                            <strong><%= row.displayName || row.name %></strong>
                            <small><%= row.body %></small>
                            <% if (row.note) { %><em><%= row.note %></em><% } %>
                        </span>
                    </<%= row.personId ? 'a' : 'div' %>>
                </li>
                <% }) %>
            </ol>
        </section>
        <% }) %>

        <% if (typeof relatedReports !== 'undefined' && relatedReports && relatedReports.length) { %>
        <section class="commu-hub-section commu-related-reports" aria-labelledby="related-reports">
            <h2 id="related-reports"><%= strings.commuLingoViews.office.relatedReports %></h2>
            <ul class="commu-related-report-list">
                <% relatedReports.forEach(function(report) { %>
                <li><a href="<%= report.href %>"><span><%= report.dateLabel || (strings.commuLingoViews.office.report) %></span><strong><%= report.title %></strong></a></li>
                <% }) %>
            </ul>
        </section>
        <% } %>
    </main>

    <%- include('../partials/footer') %>
    <%- include('../partials/commulingo-person-card-click-script') %>
</body>
</html>
