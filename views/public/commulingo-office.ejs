<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>

    <% var en = lang === 'en'; %>
    <main class="container commulingo-shell commu-person-hub-page" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [
                { label: en ? 'People' : '인물 사전', href: '/commulingo/people' },
                { label: office.title },
            ],
            dictJump: 'people' }) %>

        <header class="commu-hub-head commu-role-hub-head">
            <span class="commu-person-medal" aria-hidden="true"><%- roleIconSvg(office.icon) %></span>
            <div>
                <span class="commu-office-range"><%= office.range %></span>
                <h1><%= office.title %></h1>
                <p><%= office.blurb %></p>
            </div>
        </header>

        <% if (office.lineage && office.lineage.length) { %>
        <section class="commu-hub-section" aria-labelledby="office-lineage">
            <h2 id="office-lineage"><%= en ? 'Organizational Lineage' : '조직 변천' %></h2>
            <ol class="commu-office-lineage">
                <% office.lineage.forEach(function(step) { %>
                <li class="commu-lineage-step">
                    <div class="commu-lineage-node">
                        <strong><%= step.name %></strong>
                        <span class="commu-office-years"><%= step.period %></span>
                    </div>
                    <p><%= step.body %></p>
                </li>
                <% }) %>
            </ol>
        </section>
        <% } %>

        <section class="commu-hub-section" aria-labelledby="office-timeline">
            <h2 id="office-timeline"><%= en ? 'Leadership Timeline' : '지도부 타임라인' %></h2>
            <ol class="commu-office-rows commu-hub-office-rows">
                <% office.rows.forEach(function(row) { %>
                <li>
                    <span class="commu-office-years"><%= row.years %></span>
                    <span class="commu-office-main">
                        <% if (row.personId) { %>
                        <a href="/commulingo/people/<%= row.personId %>"><%= row.displayName || row.name %></a>
                        <% } else { %>
                        <strong><%= row.displayName || row.name %></strong>
                        <% } %>
                        <small><%= row.body %></small>
                        <% if (row.note) { %><em><%= row.note %></em><% } %>
                    </span>
                </li>
                <% }) %>
            </ol>
        </section>

        <section class="commu-hub-section" aria-labelledby="office-people">
            <h2 id="office-people"><%= en ? 'People' : '소속 인물' %></h2>
            <div class="commu-people-grid">
                <% people.forEach(function(person) { %>
                <%- include('../partials/commulingo-person-card', { person: person, groupId: person.groupId, en: en, roleIconSvg: roleIconSvg, roleHubHref: roleHubHref, flagImg: flagImg }) %>
                <% }) %>
            </div>
        </section>

        <% if (typeof relatedReports !== 'undefined' && relatedReports && relatedReports.length) { %>
        <section class="commu-hub-section commu-related-reports" aria-labelledby="related-reports">
            <h2 id="related-reports"><%= en ? 'Related reports' : '관련 보고서' %></h2>
            <ul class="commu-related-report-list">
                <% relatedReports.forEach(function(report) { %>
                <li><a href="<%= report.href %>"><span><%= report.dateLabel || (en ? 'Report' : '보고서') %></span><strong><%= report.title %></strong></a></li>
                <% }) %>
            </ul>
        </section>
        <% } %>
    </main>

    <%- include('../partials/footer') %>
    <%- include('../partials/commulingo-person-card-click-script') %>
</body>
</html>
