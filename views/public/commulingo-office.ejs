<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('../partials/head') %>
</head>
<body class="commulingo-page">
    <%- include('../partials/nav') %>

    <% var en = lang === 'en'; %>
    <main class="container commulingo-shell commu-person-hub-page" data-lang="<%= lang %>">
        <%- include('../partials/commulingo-crumb', {
            trail: [
                { label: strings.commuLingoViews.office.lineages, href: '/commulingo/offices' },
                { label: office.title },
            ],
            dictJump: 'people' }) %>

        <%- include('../partials/commulingo-office-head', { title: office.title, range: office.range, description: office.blurb, peopleHref: officePeopleHref, glossary: glossary }) %>

        <% if (office.lineage && office.lineage.length) { %>
        <section class="commu-hub-section" aria-labelledby="office-lineage">
            <h2 id="office-lineage"><%= strings.commuLingoViews.office.organizationalLineage %></h2>
            <ol class="commu-office-lineage">
                <% office.lineage.forEach(function(step) { %>
                <li class="commu-lineage-step">
                    <div class="commu-lineage-node">
                        <strong><% if (step.termHref) { %><a href="<%= step.termHref %>"><%= step.name %></a><% } else { %><%= step.name %><% } %></strong>
                        <span class="commu-office-years"><%= step.period %></span>
                    </div>
                    <p><%= step.body %></p>
                    <% (step.structures || []).forEach(function(structure) { %>
                    <details class="commu-lineage-structure">
                        <summary><span class="commu-office-years"><%= structure.date %></span> <%= structure.title %> · <%= structure.units.length %><%= strings.commuLingoViews.office.structureUnits %></summary>
                        <ol class="commu-structure-units">
                            <% structure.units.forEach(function(unit) { var href = unit.holder && unit.holder.personId ? '/commulingo/people/' + unit.holder.personId : ''; %>
                            <li>
                                <<%= href ? 'a' : 'div' %> class="commu-structure-unit"<% if (href) { %> href="<%= href %>"<% } %>>
                                    <strong><%= unit.name %></strong>
                                    <% if (unit.role) { %><small><%= unit.role %></small><% } %>
                                    <% if (unit.holder) { %><em<% if (unit.holder.vacant) { %> class="commu-structure-vacant"<% } %>><%= unit.holder.vacant ? strings.commuLingoViews.office.structureVacant : unit.holder.name %><% if (unit.holder.note) { %> (<%= unit.holder.note %>)<% } %></em><% } %>
                                </<%= href ? 'a' : 'div' %>>
                            </li>
                            <% }) %>
                        </ol>
                    </details>
                    <% }) %>
                </li>
                <% }) %>
            </ol>
        </section>
        <% } %>

        <% if (rosters && rosters.length) { %>
        <section class="commu-hub-section" aria-labelledby="office-rosters">
            <h2 id="office-rosters"><%= strings.commuLingoViews.office.rosters %></h2>
            <%- include('../partials/commulingo-office-index', { bodies: rosters, offices: [] }) %>
        </section>
        <% } %>

        <% var officeRow = function(row) { %>
                <li>
                    <<%= row.personId ? 'a' : 'div' %> class="commu-office-row"<% if (row.personId) { %> href="/commulingo/people/<%= row.personId %>"<% } %>>
                        <span class="commu-office-years"><%= row.years %></span>
                        <span class="commu-office-main">
                            <strong><%= row.displayName || row.name %></strong>
                            <small><%= row.body %></small>
                            <% if (row.note) { %><em><%= row.note %></em><% } %>
                        </span>
                    </<%= row.personId ? 'a' : 'div' %>>
                </li>
        <% }; %>
        <% var trackPicker = office.trackDisplay === 'numbered' || (office.trackDisplay === 'picker' && office.tracks.length > 1) || (office.trackDisplay === 'auto' && office.tracks.length > 2); var trackNumbers = office.trackDisplay === 'numbered'; %>
        <% if (trackPicker) { %>
        <% var trackButton = function(track, index, number) { %>
                <button type="button" class="commu-office-track-option" data-office-track="<%= index %>" aria-pressed="false"><% if (number) { %><span class="commu-office-track-number"><%= number %></span><% } %><%= track.title || strings.commuLingoViews.office.leadershipTimeline %></button>
        <% }; %>
        <div class="commu-office-track-picker" role="group" aria-label="<%= strings.commuLingoViews.office.trackPicker %>" hidden>
            <% if (office.tracks.some(function(track) { return track.lead; })) { %>
            <div class="commu-office-track-row commu-office-track-lead">
                <% office.tracks.forEach(function(track, index) { if (track.lead) trackButton(track, index); }) %>
            </div>
            <% } %>
            <div class="commu-office-track-row">
                <% var trackNumber = 0; office.tracks.forEach(function(track, index) { if (!track.lead) trackButton(track, index, trackNumbers ? ++trackNumber : 0); }) %>
            </div>
        </div>
        <% } %>
        <% office.tracks.forEach(function(track, index) { var columns = track.columns; %>
        <section class="commu-hub-section" id="track-<%= track.id || index %>" aria-labelledby="office-track-<%= index %>"<% if (trackPicker) { %> data-office-track-panel="<%= index %>"<% } %>>
            <h2 id="office-track-<%= index %>"><%= track.title || strings.commuLingoViews.office.leadershipTimeline %></h2>
            <% if (!columns || columns.loose.length) { %>
            <ol class="commu-office-rows commu-hub-office-rows">
                <% (columns ? columns.loose : track.rows).forEach(officeRow) %>
            </ol>
            <% } %>
            <% if (columns) { %>
            <div class="commu-office-seats">
                <div class="commu-office-seats-head" aria-hidden="true"><span><%= strings.commuLingoViews.office.seatState %></span><span><%= strings.commuLingoViews.office.seatGovernment %></span></div>
                <table class="commu-office-seat-grid">
                    <% columns.lines.forEach(function(line) { %>
                    <tr>
                        <% ['state', 'government'].forEach(function(seat) { var cell = line[seat]; if (!cell) return; %>
                        <td class="commu-office-seat-<%= seat %>"<% if (cell.span > 1) { %> rowspan="<%= cell.span %>"<% } %>><% if (cell.rows.length) { %><ol class="commu-office-rows" aria-label="<%= seat === 'state' ? strings.commuLingoViews.office.seatState : strings.commuLingoViews.office.seatGovernment %>"><% cell.rows.forEach(officeRow) %></ol><% } %></td>
                        <% }) %>
                    </tr>
                    <% }) %>
                </table>
            </div>
            <% } %>
        </section>
        <% }) %>
        <% if (trackPicker) { %>
        <script>
        (function () {
            var picker = document.querySelector('.commu-office-track-picker');
            var buttons = picker.querySelectorAll('[data-office-track]');
            var panels = document.querySelectorAll('[data-office-track-panel]');
            function show(index, scroll) {
                buttons.forEach(function (b) { var on = b.dataset.officeTrack === index; b.classList.toggle('is-active', on); b.setAttribute('aria-pressed', on ? 'true' : 'false'); });
                panels.forEach(function (p) { p.hidden = p.dataset.officeTrackPanel !== index; });
                var panel = document.querySelector('[data-office-track-panel="' + index + '"]');
                if (scroll && panel) history.replaceState(null, '', '#' + panel.id);
            }
            var start = '0';
            if (location.hash) {
                var target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
                if (target && target.dataset.officeTrackPanel) start = target.dataset.officeTrackPanel;
            }
            picker.hidden = false;
            show(start, false);
            buttons.forEach(function (b) { b.addEventListener('click', function () { show(b.dataset.officeTrack, true); }); });
        })();
        </script>
        <% } %>

        <% if (typeof relatedReports !== 'undefined' && relatedReports && relatedReports.length) { %>
        <section class="commu-hub-section" aria-labelledby="related-reports">
            <h2 id="related-reports"><%= strings.commuLingoViews.office.relatedReports %></h2>
            <ul class="commu-link-list">
                <% relatedReports.forEach(function(report) { %>
                <li><a href="<%= report.href %>"><span><%= report.dateLabel || (strings.commuLingoViews.office.report) %></span><strong><%= report.title %></strong></a></li>
                <% }) %>
            </ul>
        </section>
        <% } %>
    </main>

    <%- include('../partials/footer') %>
    <%- include('../partials/commulingo-person-card-click-script') %>
</body>
</html>
