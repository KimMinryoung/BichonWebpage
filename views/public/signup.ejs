<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <% pageTitle = strings.userAuth.signupTitle %>
    <%- include('../partials/head') %>
    <meta name="csrf-token" content="<%= csrfToken %>">
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="login-container">
        <div class="login-box">
            <h1><%= strings.userAuth.signupTitle %></h1>

            <p class="message message-info">
                <%= strings.userAuth.signupHintLine1 %><br>
                <%= strings.userAuth.signupHintLine2 %>
            </p>

            <div id="auth-message" class="message" style="display:none;"></div>

            <form id="password-signup-form">
                <div class="form-group">
                    <label for="username"><%= strings.userAuth.username %></label>
                    <input type="text" id="username" name="username" autocomplete="username" required>
                    <small style="display:block;margin-top:4px;color:var(--clr-text-soft,#888);">
                        <%= strings.userAuth.usernameHint %>
                    </small>
                </div>

                <div class="form-group">
                    <label for="password"><%= strings.userAuth.password %></label>
                    <input type="password" id="password" name="password" autocomplete="new-password" minlength="1" maxlength="128" required>
                    <small style="display:block;margin-top:4px;color:var(--clr-text-soft,#888);">
                        <%= strings.userAuth.passwordHint %>
                    </small>
                </div>

                <button type="submit" class="btn btn-primary" id="signup-btn" style="width:100%;">
                    <%= strings.userAuth.signUp %>
                </button>
            </form>

            <p style="margin-top:20px; text-align:center;">
                <%= strings.userAuth.haveAccount %>
                <a href="/auth/login"><%= strings.userAuth.signInLink %></a>
            </p>
        </div>
    </div>

    <script>
    (function () {
        const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
        const msg = document.getElementById('auth-message');
        const signupForm = document.getElementById('password-signup-form');
        const signupBtn = document.getElementById('signup-btn');
        const S = {
            failed: <%- JSON.stringify(strings.login.failed) %>,
            usernameRequired: <%- JSON.stringify(strings.login.usernameRequired) %>,
            registered: <%- JSON.stringify(strings.login.registered) %>,
            usernameInvalid: <%- JSON.stringify(strings.userAuth.usernameInvalid) %>,
            usernameTaken: <%- JSON.stringify(strings.userAuth.usernameTaken) %>,
            passwordInvalid: <%- JSON.stringify(strings.userAuth.passwordInvalid) %>,
            signupFailed: <%- JSON.stringify(strings.userAuth.signupFailed) %>,
        };

        function showMessage(text, kind) {
            msg.textContent = text;
            msg.className = 'message message-' + (kind || 'info');
            msg.style.display = 'block';
        }

        async function jsonFetch(url, body) {
            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
                body: JSON.stringify(body || {}),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || ('HTTP ' + res.status));
            return data;
        }

        function friendlyError(err) {
            const message = err && err.message ? err.message : '';
            if (message === 'invalid username') return S.usernameInvalid;
            if (message === 'username taken') return S.usernameTaken;
            if (message === 'password must be 1-128 characters') return S.passwordInvalid;
            if (message === 'signup failed') return S.signupFailed;
            return message || S.failed;
        }

        function currentFingerprint() {
            try { return localStorage.getItem('cl_user_id'); } catch { return null; }
        }

        signupForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            const username = document.getElementById('username').value.trim();
            const password = document.getElementById('password').value;
            if (!username) {
                showMessage(S.usernameRequired, 'error');
                return;
            }
            signupBtn.disabled = true;
            try {
                const result = await jsonFetch('/auth/password/signup', {
                    username,
                    password,
                    fingerprint: currentFingerprint(),
                });
                if (result.ok) {
                    showMessage(S.registered, 'success');
                    window.location.href = result.redirect || '/';
                    return;
                }
                showMessage(S.failed, 'error');
            } catch (err) {
                showMessage(friendlyError(err), 'error');
            } finally {
                signupBtn.disabled = false;
            }
        });
    })();
    </script>

    <%- include('../partials/footer') %>
</body>
</html>
