<%
/* The integrated search page (routes/search.js): one view for both scopes.
   CommuLingo's scope sits in its shell under the crumb bar; the site scope in
   the plain container. The form is a plain GET so it works without script. */
var s = strings.search;
var en = lang === 'en';
var inCommuLingo = scope === 'commulingo';
var action = scopes[scope].path;
var q = result.query;
var scopeHref = function(key) { return scopes[key].path + (q ? '?q=' + encodeURIComponent(q) : ''); };
%>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head><%- include('../partials/head') %></head>
<body class="<%= inCommuLingo ? 'commulingo-page' : 'search-page' %>">
    <%- include('../partials/nav') %>
    <main class="container site-search<%= inCommuLingo ? ' commulingo-shell commu-dict-shell' : '' %>" data-lang="<%= lang %>">
        <% if (inCommuLingo) { %>
        <%- include('../partials/commulingo-crumb', { trail: [{ label: s.title }], dictJump: true }) %>
        <% } %>
        <h1 class="visually-hidden"><%= s.title %></h1>
        <nav class="ui-tabs site-search-scopes" aria-label="<%= s.scopeLabel %>">
            <% [['all', s.siteScope], ['commulingo', s.commuLingoScope]].forEach(function(item) { %>
            <a class="ui-tab<%= scope === item[0] ? ' is-active' : '' %>" href="<%= scopeHref(item[0]) %>"<% if (scope === item[0]) { %> aria-current="page"<% } %>><%= item[1] %></a>
            <% }) %>
        </nav>
        <form class="site-search-form" action="<%= action %>" method="get" role="search">
            <%- include('../partials/site-search-box', { value: q, placeholder: inCommuLingo ? s.placeholderCommuLingo : s.placeholderSite, autofocus: !q }) %>
        </form>

        <% if (!q) { %>
        <p class="site-search-status"><%= s.prompt %></p>
        <% } else { %>
            <%- include('../partials/site-search-results', { result: result }) %>
        <% } %>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
