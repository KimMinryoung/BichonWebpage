<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <% pageTitle = strings.userAuth.accountTitle %>
    <%- include('../partials/head') %>
    <meta name="csrf-token" content="<%= csrfToken %>">
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container">
        <div class="admin-header">
            <h1>@<%= currentUser.username %> · <%= strings.userAuth.accountTitle %></h1>
        </div>

        <div class="box">
            <h2><%= strings.userAuth.accountLogoutSection %></h2>
            <form action="/auth/logout" method="POST" class="ui-section-gap">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn"><%= strings.userAuth.logout %></button>
            </form>
        </div>

        <div class="box">
            <h2><%= strings.userAuth.passwordSection %></h2>
            <p class="ui-muted ui-section-gap">
                <%= strings.userAuth.passwordLoginHint %>
            </p>
            <p>
                <strong><%= strings.userAuth.loginUsernameLabel %>:</strong>
                <code><%= currentUser.username %></code>
            </p>
            <div id="password-message" class="message" role="status" aria-live="polite"></div>
            <form id="password-form" class="ui-section-gap">
                <div class="form-group" id="current-password-group" hidden>
                    <label for="current-password"><%= strings.userAuth.currentPassword %></label>
                    <input type="password" id="current-password" autocomplete="current-password">
                </div>
                <div class="form-group">
                    <label for="new-password"><%= strings.userAuth.newPassword %></label>
                    <input type="password" id="new-password" autocomplete="new-password" minlength="1" maxlength="128" required>
                    <small class="form-hint">
                        <%= strings.userAuth.passwordHint %>
                    </small>
                </div>
                <button type="submit" class="btn btn-primary" id="password-btn">
                    <%= strings.userAuth.setPassword %>
                </button>
            </form>
        </div>

        <div class="box">
            <h2><%= strings.admin.passkeys %></h2>
            <p><%= strings.admin.passkeysHint %></p>
            <div id="passkey-list" class="ui-section-gap"></div>
        </div>

        <div class="box">
            <h2><%= strings.admin.addPasskey %></h2>
            <div id="add-message" class="message" role="status" aria-live="polite"></div>
            <div class="form-group">
                <label for="add-device"><%= strings.login.deviceName %></label>
                <input type="text" id="add-device" placeholder="<%= strings.login.deviceNamePlaceholder %>">
            </div>
            <button type="button" class="btn btn-primary" id="add-btn">
                <%= strings.admin.addPasskey %>
            </button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@simplewebauthn/browser@13/dist/bundle/index.umd.min.js"></script>
    <script>
    (function () {
        const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
        const list = document.getElementById('passkey-list');
        const addBtn = document.getElementById('add-btn');
        const msg = document.getElementById('add-message');
        const passwordForm = document.getElementById('password-form');
        const passwordBtn = document.getElementById('password-btn');
        const passwordMsg = document.getElementById('password-message');
        const currentPasswordGroup = document.getElementById('current-password-group');
        const strings = {
            added: <%- JSON.stringify(strings.admin.passkeyAdded) %>,
            deleteConfirm: <%- JSON.stringify(strings.admin.passkeyDeleteConfirm) %>,
            empty: <%- JSON.stringify(strings.admin.passkeysEmpty) %>,
            cancelled: <%- JSON.stringify(strings.login.cancelled) %>,
            failed: <%- JSON.stringify(strings.login.failed) %>,
            unnamed: <%- JSON.stringify(strings.admin.passkeyUnnamed) %>,
            created: <%- JSON.stringify(strings.admin.passkeyCreated) %>,
            lastUsed: <%- JSON.stringify(strings.admin.passkeyLastUsed) %>,
            never: <%- JSON.stringify(strings.admin.passkeyNever) %>,
            delete: <%- JSON.stringify(strings.admin.delete) %>,
            setPassword: <%- JSON.stringify(strings.userAuth.setPassword) %>,
            updatePassword: <%- JSON.stringify(strings.userAuth.updatePassword) %>,
            passwordSaved: <%- JSON.stringify(strings.userAuth.passwordSaved) %>,
        };

        function showMessage(text, kind) {
            msg.textContent = text;
            msg.className = 'message message-' + (kind || 'info');
            msg.style.display = 'block';
        }

        function showPasswordMessage(text, kind) {
            passwordMsg.textContent = text;
            passwordMsg.className = 'message message-' + (kind || 'info');
            passwordMsg.style.display = 'block';
        }

        async function jsonFetch(url, body) {
            const res = await fetch(url, {
                method: body ? 'POST' : 'GET',
                headers: {
                    'Content-Type': 'application/json',
                    'x-csrf-token': csrfToken,
                },
                body: body ? JSON.stringify(body) : undefined,
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || ('HTTP ' + res.status));
            return data;
        }

        function formatDate(iso) {
            if (!iso) return strings.never;
            try { return new Date(iso).toLocaleString(); } catch { return iso; }
        }

        async function load() {
            list.innerHTML = '';
            const { passkeys } = await jsonFetch('/auth/webauthn/passkeys');
            if (!passkeys.length) {
                list.innerHTML = '<p>' + strings.empty + '</p>';
                return;
            }
            const table = document.createElement('table');
            table.className = 'posts-table';
            table.innerHTML = '<thead><tr><th>Device</th><th>' + strings.created + '</th><th>' + strings.lastUsed + '</th><th></th></tr></thead><tbody></tbody>';
            const tbody = table.querySelector('tbody');
            passkeys.forEach((p) => {
                const tr = document.createElement('tr');
                const name = document.createElement('td');
                name.textContent = p.device_name || strings.unnamed;
                const created = document.createElement('td');
                created.textContent = formatDate(p.created_at);
                const used = document.createElement('td');
                used.textContent = formatDate(p.last_used_at);
                const actions = document.createElement('td');
                const btn = document.createElement('button');
                btn.className = 'btn btn-small btn-danger';
                btn.textContent = strings.delete;
                btn.addEventListener('click', async () => {
                    if (!confirm(strings.deleteConfirm)) return;
                    try {
                        await jsonFetch('/auth/webauthn/passkeys/' + p.id + '/delete', {});
                        await load();
                    } catch (err) {
                        showMessage(err.message || strings.failed, 'error');
                    }
                });
                actions.appendChild(btn);
                tr.append(name, created, used, actions);
                tbody.appendChild(tr);
            });
            list.appendChild(table);
        }

        async function loadPasswordStatus() {
            const status = await jsonFetch('/auth/password/status');
            currentPasswordGroup.hidden = !status.hasPassword;
            document.getElementById('current-password').required = !!status.hasPassword;
            passwordBtn.textContent = status.hasPassword ? strings.updatePassword : strings.setPassword;
        }

        passwordForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            passwordBtn.disabled = true;
            passwordMsg.style.display = 'none';
            try {
                await jsonFetch('/auth/password/set', {
                    currentPassword: document.getElementById('current-password').value,
                    newPassword: document.getElementById('new-password').value,
                });
                document.getElementById('current-password').value = '';
                document.getElementById('new-password').value = '';
                showPasswordMessage(strings.passwordSaved, 'success');
                await loadPasswordStatus();
            } catch (err) {
                showPasswordMessage(err.message || strings.failed, 'error');
            } finally {
                passwordBtn.disabled = false;
            }
        });

        addBtn.addEventListener('click', async () => {
            const deviceName = document.getElementById('add-device').value.trim();
            addBtn.disabled = true;
            msg.style.display = 'none';
            try {
                const options = await jsonFetch('/auth/webauthn/add/options', {});
                const attestation = await window.SimpleWebAuthnBrowser.startRegistration({ optionsJSON: options });
                await jsonFetch('/auth/webauthn/add/verify', {
                    response: attestation,
                    deviceName: deviceName || null,
                });
                document.getElementById('add-device').value = '';
                showMessage(strings.added, 'success');
                await load();
            } catch (err) {
                const isCancel = err && (err.name === 'NotAllowedError' || /cancel/i.test(err.message || ''));
                showMessage(isCancel ? strings.cancelled : (err.message || strings.failed), 'error');
            } finally {
                addBtn.disabled = false;
            }
        });

        loadPasswordStatus().catch((err) => {
            showPasswordMessage(err.message || strings.failed, 'error');
        });

        load().catch((err) => {
            const p = document.createElement('p');
            p.className = 'message message-error';
            p.textContent = err.message || strings.failed;
            list.replaceChildren(p);
        });
    })();
    </script>

    <%- include('../partials/footer') %>
</body>
</html>
