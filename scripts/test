#!/usr/bin/env bash
# scripts/test — the test entry point (npm test, scripts/deploy). The runner
# and the test layout are tests/run.js and tests/README.md; options pass
# through (--browser, --db, --all, --list, name filters).
#
# The app targets Node 24 (package.json engines, Dockerfile) and some deps are
# ESM-only, which an older host node cannot require(). On an older node the
# whole run moves into the pinned image the deploy builds from, with the repo
# mounted read-only (tests never write into it). Without a usable docker (a
# cloud session) it stays on the host and says so.
set -u
cd "$(dirname "$0")/.."

NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
if [[ "${NODE_MAJOR:-0}" -lt 24 && -z "${TEST_IN_DOCKER:-}" ]]; then
    if timeout 5 docker info >/dev/null 2>&1; then
        echo "[test] host node $(node -v 2>/dev/null || echo missing) < 24; running in node:24.22.1-alpine" >&2
        exec docker run --rm -u "$(id -u):$(id -g)" -e TEST_IN_DOCKER=1 -e HOME=/tmp \
            -v "$PWD:/app:ro" -w /app node:24.22.1-alpine sh scripts/test "$@"
    fi
    echo "[test] host node $(node -v 2>/dev/null || echo missing) < 24 and no usable docker; running on the host (the app targets Node 24)" >&2
fi

exec node tests/run.js "$@"
