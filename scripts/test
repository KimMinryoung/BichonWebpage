#!/usr/bin/env bash
# scripts/test — the host-side test set (no DB, no container; parallel, ~8 s).
#
#   check-ui.js         compiles every EJS view + asserts the base CSS links
#   test-seo.js         head.ejs SEO output + language resolution
#   test-error-page.js  error page renders without the locals middleware
#   smoke-commulingo-*  pure-function policy tests (linkify, names, nationality…)
#   validate-commulingo.js  course content gate (shape + quality rules, baseline-tolerated)
#   audit-commulingo-quality.js  heuristic content audit (fails only on fatal kinds)
#
# Any non-zero exit fails the run. Wired to `npm test` and to scripts/deploy.
set -u
cd "$(dirname "$0")/.."

# The app targets Node 24 (package.json engines, Dockerfile) and some deps are
# ESM-only, which an older host node cannot require(). When the host node is
# too old, re-run this whole script inside the same pinned image the deploy
# builds from, with the repo mounted read-only (tests never write into it).
NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
if [[ "${NODE_MAJOR:-0}" -lt 24 && -z "${TEST_IN_DOCKER:-}" ]]; then
    # Needs git, which the image lacks; plain CommonJS, so the host node runs it.
    node scripts/check-commulingo-question-ids.js || { echo "tests failed"; exit 1; }
    echo "[test] host node $(node -v 2>/dev/null || echo missing) < 24; running in node:24.21.0-alpine" >&2
    exec docker run --rm -u "$(id -u):$(id -g)" -e TEST_IN_DOCKER=1 -e HOME=/tmp \
        -v "$PWD:/app:ro" -w /app node:24.21.0-alpine sh scripts/test "$@"
fi

# Tests are independent (ephemeral ports, mkdtemp scratch), so they run in
# parallel up to one per CPU; results print in list order once all finish.
logs="$(mktemp -d)"
trap 'rm -rf "$logs"' EXIT
max="$(nproc 2>/dev/null || echo 4)"
count=0
running=""
run() {
    count=$((count + 1))
    local id name="$1"
    id="$(printf '%03d' "$count")"
    shift
    printf '%s\n' "$name" > "$logs/$id.name"
    ( "$@" > "$logs/$id.log" 2>&1; echo $? > "$logs/$id.status" ) &
    running="$running $!"
    set -- $running
    if [ "$#" -ge "$max" ]; then
        wait "$1"
        shift
        running="$*"
    fi
}

run css-releases    node scripts/test-css-releases.js
run check-ui        node scripts/check-ui.js
run test-seo        node scripts/test-seo.js
run evidence-count  node scripts/test-commulingo-evidence-count.js
run test-strike     node scripts/test-strike.js
run test-nonogram   node scripts/test-nonogram.js
run test-error-page node scripts/test-error-page.js
run test-visitor-hash node scripts/test-visitor-hash.js
run test-access-boundaries node scripts/test-access-boundaries.js
run static-page-sanitize node scripts/smoke-static-page-sanitize.js
run question-ids    node scripts/check-commulingo-question-ids.js
run menu-views      node scripts/smoke-menu-views.js
for f in scripts/smoke-commulingo-*.js; do
    run "$(basename "$f" .js)" node "$f"
done
run validate-commulingo       node scripts/validate-commulingo.js
run audit-commulingo-quality  node scripts/audit-commulingo-quality.js

# Lint runs here only when eslint is installed locally (the docker fallback in
# scripts/lint is too slow for every test run); `npm run lint` always works.
if [[ -x node_modules/.bin/eslint ]]; then
    run lint node_modules/.bin/eslint .
fi
wait

fail=0
for name_file in "$logs"/*.name; do
    id="${name_file%.name}"
    name="$(cat "$name_file")"
    if [ "$(cat "$id.status" 2>/dev/null)" = 0 ]; then
        echo "ok   $name"
    else
        echo "FAIL $name"
        sed 's/^/     /' "$id.log" | tail -20
        fail=1
    fi
done

if [[ $fail -ne 0 ]]; then
    echo "tests failed"
    exit 1
fi
echo "all tests passed"
