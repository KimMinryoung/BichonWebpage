#!/usr/bin/env bash
# scripts/test — the test entry point (npm test, scripts/deploy). The runner
# and the test layout are tests/run.js and tests/README.md; options pass
# through (--browser, --db, --all, --list, name filters).
#
# The app targets Node 24 (package.json engines, Dockerfile) and some deps are
# ESM-only, which an older host node cannot require(). On an older node the
# whole run moves into the pinned image the deploy builds from, with the repo
# mounted read-only (tests never write into it) and a cache directory
# beside it. Without a usable docker (a
# cloud session) it stays on the host and says so.
set -u
cd "$(dirname "$0")/.."

NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
if [[ "${NODE_MAJOR:-0}" -lt 24 && -z "${TEST_IN_DOCKER:-}" ]]; then
    if timeout 5 docker info >/dev/null 2>&1; then
        echo "[test] host node $(node -v 2>/dev/null || echo missing) < 24; running in docker" >&2
        # DB tests reach the database by its container name (DB_HOST in
        # .env), which resolves only on the compose network.
        # (Plain sh syntax: the container reruns this file with busybox sh.)
        NETWORK=--network=bridge
        if [[ " $* " == *" --db "* || " $* " == *" --all "* ]]; then
            DB_NETWORK="${TEST_DB_NETWORK:-leninbot_default}"
            docker network inspect "$DB_NETWORK" >/dev/null 2>&1 && NETWORK="--network=$DB_NETWORK"
        fi
        IMAGE=node:24.22.1-alpine RUN_SHELL=sh
        # Browser tests need Chromium, which alpine cannot run: use the
        # Playwright image (tests/browser.Dockerfile), built once per
        # Playwright version.
        # (A name filter `browser/…` selects browser tests too, tests/run.js.)
        if [[ " $* " == *" --browser "* || " $* " == *" --all "* || " $* " == *" browser/"* ]]; then
            PW="$(node -p 'require("./package-lock.json").packages["node_modules/playwright"].version' 2>/dev/null)"
            IMAGE="leninbot-frontend-test-browser:pw-$PW" RUN_SHELL=bash
            if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
                echo "[test] building $IMAGE (once per Playwright version)" >&2
                docker build -q -t "$IMAGE" --build-arg "PLAYWRIGHT_VERSION=$PW" - < tests/browser.Dockerfile >/dev/null || exit 1
            fi
        fi
        # The one writable mount: caches that outlive the container (ESLint's).
        CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/leninbot-frontend-test"
        mkdir -p "$CACHE_DIR"
        exec docker run --rm -u "$(id -u):$(id -g)" -e TEST_IN_DOCKER=1 -e HOME=/tmp -e TEST_CACHE_DIR=/cache "$NETWORK" \
            -v "$PWD:/app:ro" -v "$CACHE_DIR:/cache" -w /app "$IMAGE" "$RUN_SHELL" scripts/test "$@"
    fi
    echo "[test] host node $(node -v 2>/dev/null || echo missing) < 24 and no usable docker; running on the host (the app targets Node 24)" >&2
fi

exec node tests/run.js "$@"
