#!/usr/bin/env bash
# apply-migration — apply a SQL migration to leninbot-pg as postgres (the
# frontend role cannot CREATE) and record it in schema_migrations.
#
#   scripts/apply-migration scripts/migrations/196_x.sql [--force]
#   scripts/apply-migration --status      # files never recorded, or changed since
#   scripts/apply-migration --baseline    # record every current file without running it
#
# A file already recorded with the same hash is skipped; one recorded with a
# different hash (edited after it ran) is refused unless --force. Data-only
# SQL under scripts/migrations/data/ is tracked the same way, and after it runs
# the work directories are archived to R2 (scripts/archive-work-r2.js).
set -euo pipefail
cd "$(dirname "$0")/.."
PG_CONTAINER="${PG_CONTAINER:-leninbot-pg}"
psql_pg() { docker exec -i "$PG_CONTAINER" psql -U postgres -d leninbot -v ON_ERROR_STOP=1 -qAt "$@"; }
sql_quote() { printf "'%s'" "${1//\'/\'\'}"; }
who="${USER:-unknown}"

recorded() { psql_pg -c "SELECT filename || ' ' || sha256 FROM schema_migrations"; }
files() { ls scripts/migrations/*.sql scripts/migrations/data/*.sql 2>/dev/null | sort; }

case "${1:-}" in
    --status)
        declare -A have
        while read -r name hash; do [ -n "$name" ] && have["$name"]="$hash"; done < <(recorded)
        missing=0
        for f in $(files); do
            h=$(sha256sum "$f" | cut -d' ' -f1)
            if [ -z "${have[$f]:-}" ]; then echo "not applied: $f"; missing=1
            elif [ "${have[$f]}" != "$h" ]; then echo "changed since applied: $f"; missing=1; fi
        done
        [ $missing -eq 0 ] && echo "all $(files | wc -l) migration files recorded and unchanged"
        exit $missing ;;
    --baseline)
        n=0
        for f in $(files); do
            h=$(sha256sum "$f" | cut -d' ' -f1)
            psql_pg -c "INSERT INTO schema_migrations (filename, sha256, applied_by, note) VALUES ($(sql_quote "$f"), '$h', $(sql_quote "$who"), 'baseline: recorded without running') ON CONFLICT (filename) DO NOTHING" >/dev/null
            n=$((n+1))
        done
        echo "baseline: $n file(s) considered"; exit 0 ;;
    ''|-h|--help)
        sed -n 2,12p "$0"; exit 2 ;;
esac

file="$1"; force="${2:-}"
[ -f "$file" ] || { echo "no such file: $file" >&2; exit 2; }
hash=$(sha256sum "$file" | cut -d' ' -f1)
prev=$(psql_pg -c "SELECT sha256 FROM schema_migrations WHERE filename = $(sql_quote "$file")")
if [ -n "$prev" ] && [ "$prev" = "$hash" ]; then echo "already applied: $file"; exit 0; fi
if [ -n "$prev" ] && [ "$force" != "--force" ]; then
    echo "refused: $file changed since it was applied (recorded $prev, now $hash); rerun with --force if intended" >&2; exit 1
fi
psql_pg < "$file"
psql_pg -c "INSERT INTO schema_migrations (filename, sha256, applied_by) VALUES ($(sql_quote "$file"), '$hash', $(sql_quote "$who"))
            ON CONFLICT (filename) DO UPDATE SET sha256 = EXCLUDED.sha256, applied_at = now(), applied_by = EXCLUDED.applied_by, note = 'reapplied'" >/dev/null
echo "applied: $file"
case "$file" in
    scripts/migrations/data/*|./scripts/migrations/data/*)
        node scripts/archive-work-r2.js || echo "warning: R2 archive failed; rerun node scripts/archive-work-r2.js" >&2 ;;
esac
