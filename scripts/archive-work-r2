#!/usr/bin/env bash
# archive-work-r2 — run scripts/archive-work-r2.js with the R2 key pair from the
# systemd credstore, the same encrypted credentials and bucket leninbot's backup
# units use (r2_s3_access_key_id / r2_s3_secret_access_key, cyber-lenin-backups).
# Objects go under commulingo-work/; r2_retention only prunes dated *.dump keys
# under the DB backup prefixes, so nothing here is ever deleted.
#
#   scripts/archive-work-r2 [--dry-run | --list | --get <key> [out]]
#
# Decrypting the credentials needs the system manager, hence sudo. Without a
# terminal and without cached sudo (agent sessions) an upload is skipped with
# exit 0: the hourly commulingo-work-archive.timer uploads the files, so there
# is nothing to retry. --list and --get still fail loudly.
set -euo pipefail
cd "$(dirname "$0")/.."
SUDO=()
if [ "$(id -u)" -ne 0 ]; then
    if [ -t 0 ]; then SUDO=(sudo); else SUDO=(sudo -n); fi
    if [ ! -t 0 ] && ! sudo -n true 2>/dev/null; then
        case "${1:-}" in
            --list|--get) echo "archive-work-r2: $1 needs sudo; run it from a terminal" >&2; exit 1 ;;
            *) echo "archive-work-r2: no sudo here; skipped — the hourly commulingo-work-archive.timer uploads it"; exit 0 ;;
        esac
    fi
fi
CRED=/etc/credstore.encrypted
exec "${SUDO[@]}" systemd-run --quiet --wait --pipe --collect \
    --uid=grass --gid=grass \
    -p WorkingDirectory="$PWD" \
    -p EnvironmentFile=/home/grass/leninbot/.env \
    -p Environment=R2_BUCKET=cyber-lenin-backups \
    -p LoadCredentialEncrypted=r2_s3_access_key_id:$CRED/r2_s3_access_key_id.cred \
    -p LoadCredentialEncrypted=r2_s3_secret_access_key:$CRED/r2_s3_secret_access_key.cred \
    /usr/bin/node scripts/archive-work-r2.js "$@"
