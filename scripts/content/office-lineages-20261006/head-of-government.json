{
  "officeId": "head-of-government",
  "title": {
    "ko": "정부 수반",
    "en": "Heads of government"
  },
  "blurb": {
    "ko": "러시아 공화국과 소련의 인민위원회의 의장, 소련 각료회의 의장, 소련 총리, 그리고 1991년 8월 이후 정부 기능을 맡은 과도 경제기구의 수장.",
    "en": "The chairmen of the Council of People's Commissars of the RSFSR and the USSR, the chairmen of the USSR Council of Ministers, the Prime Minister of the USSR, and the heads of the interim economic bodies that took over government functions after August 1991."
  },
  "range": "1917–1991",
  "tracks": [
    {
      "id": "sovnarkom-rsfsr",
      "title": {
        "ko": "러시아 공화국 인민위원회의 의장",
        "en": "Chairman of the Council of People's Commissars of the RSFSR"
      },
      "blurb": {
        "ko": "10월 혁명으로 수립된 소비에트 정부의 수반. 1923년 소련 인민위원회의가 생긴 뒤에는 공화국 정부직이 되었으므로 레닌까지만 싣는다.",
        "en": "Head of the Soviet government formed in the October Revolution. Once the USSR Council of People's Commissars existed in 1923 it became a republican post, so only Lenin is listed."
      }
    },
    {
      "id": "sovnarkom-ussr",
      "title": {
        "ko": "소련 인민위원회의 의장",
        "en": "Chairman of the Council of People's Commissars of the USSR"
      },
      "blurb": {
        "ko": "1923년 7월부터 1946년 3월 각료회의로 개편될 때까지의 연방 정부 수반.",
        "en": "Head of the union government from July 1923 until the council became the Council of Ministers in March 1946."
      }
    },
    {
      "id": "council-of-ministers",
      "title": {
        "ko": "소련 각료회의 의장",
        "en": "Chairman of the Council of Ministers of the USSR"
      },
      "blurb": {
        "ko": "1946년 3월부터 1991년 1월 내각 체제로 바뀔 때까지의 정부 수반.",
        "en": "Head of government from March 1946 until the switch to a cabinet system in January 1991."
      }
    },
    {
      "id": "prime-minister",
      "title": {
        "ko": "소련 총리",
        "en": "Prime Minister of the USSR"
      },
      "blurb": {
        "ko": "1991년 1월 대통령 아래 신설된 내각의 수반. 8월 쿠데타 중 제1부총리 도구지예프가 내각 업무를 맡았고, 8월 28일 내각이 총사퇴했다.",
        "en": "Head of the Cabinet of Ministers created under the president in January 1991. During the August coup First Deputy Prime Minister Doguzhiev ran the cabinet, which resigned as a whole on 28 August."
      }
    },
    {
      "id": "interim-economic-bodies",
      "title": {
        "ko": "1991년 과도 경제기구",
        "en": "Interim economic bodies of 1991"
      },
      "blurb": {
        "ko": "내각 사퇴 뒤 정부 기능을 넘겨받은 국민경제 운영관리위원회와, 공화국간 경제위원회(11월부터 국가간 경제위원회). 셋 모두 실라예프가 이끌었다.",
        "en": "After the cabinet resigned, government functions passed to the Committee for the Operational Management of the National Economy and to the Inter-republican Economic Committee (from November the Interstate Economic Committee), all headed by Silayev."
      }
    }
  ],
