{
 "officeId": "culture-literature",
 "title": {
  "ko": "문화 · 문학예술 통제",
  "en": "Culture and literary control"
 },
 "blurb": {
  "ko": "러시아 공화국 교육인민위원(1917~1946), 소련 문화장관(1953~1991), 소련 작가동맹 지도자(1934~1991).",
  "en": "People’s Commissar of Education of the RSFSR (1917–1946), Minister of Culture of the USSR (1953–1991) and the head of the Union of Soviet Writers (1934–1991)."
 },
 "range": "1917–1991",
 "tracks": [
  {
   "id": "narkompros",
   "title": {
    "ko": "교육인민위원",
    "en": "People’s Commissar of Education"
   },
   "blurb": {
    "ko": "러시아 공화국 교육인민위원부(나르콤프로스)의 수장. 학교, 학술, 출판, 예술을 함께 관할했다. 1946년 3월 교육부로 바뀌었다.",
    "en": "Head of the RSFSR People’s Commissariat of Education (Narkompros), which ran schools, scholarship, publishing and the arts. It became a ministry in March 1946."
   }
  },
  {
   "id": "minkult",
   "title": {
    "ko": "소련 문화장관",
    "en": "Minister of Culture of the USSR"
   },
   "blurb": {
    "ko": "1953년 3월 문화 관련 부처들을 합쳐 만든 소련 문화부의 장관. 1991년 11월 문화위원회로 개편되었다.",
    "en": "Minister of the USSR Ministry of Culture, formed by merging the cultural agencies in March 1953 and turned into a committee in November 1991."
   }
  },
  {
   "id": "writers",
   "title": {
    "ko": "소련 작가동맹 지도자",
    "en": "Head of the Union of Soviet Writers"
   },
   "blurb": {
    "ko": "1934년 규약상 지도자는 이사회 의장이었으나 실무는 서기장·제1서기가 이끌었고, 1977년 규약부터는 이사회 제1서기가 지도자였다. 그래서 1971~1977년에는 의장과 제1서기가 겹친다. 직함은 당시 것이다.",
    "en": "Under the 1934 statute the head was the Chairman of the Board, though the General or First Secretary ran the Union’s work; from the 1977 statute the First Secretary of the Board was the head, so the Chairman and the First Secretary overlap in 1971–1977. Titles are those of the time."
   }
  }
 ],
