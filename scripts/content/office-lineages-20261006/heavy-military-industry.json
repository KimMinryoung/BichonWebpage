{
 "officeId": "heavy-military-industry",
 "title": {
  "ko": "중공업 · 군수공업",
  "en": "Heavy industry and military industry"
 },
 "blurb": {
  "ko": "최고국민경제회의 의장, 중공업인민위원, 국방공업인민위원, 각료회의 군수공업위원회 의장.",
  "en": "Chairmen of the Supreme Council of the National Economy (VSNKh), People's Commissars of Heavy Industry and of Defence Industry, and chairmen of the Council of Ministers' Military-Industrial Commission."
 },
 "range": "1917–1991",
 "tracks": [
  {
   "id": "vsnkh",
   "title": {
    "ko": "최고국민경제회의 의장",
    "en": "Chairman of the VSNKh"
   },
   "blurb": {
    "ko": "1923년 7월까지는 러시아 공화국 최고국민경제회의, 그 뒤로는 소련 최고국민경제회의의 의장이다. 1932년 1월 중공업·경공업·임업 인민위원부로 나뉘며 폐지됐다.",
    "en": "Chairmen of the VSNKh of the RSFSR until July 1923, then of the VSNKh of the USSR, which was abolished in January 1932 when it was split into the commissariats of heavy, light and timber industry."
   }
  },
  {
   "id": "heavy-industry",
   "title": {
    "ko": "중공업인민위원",
    "en": "People's Commissar of Heavy Industry"
   },
   "blurb": {
    "ko": "최고국민경제회의를 이어받은 중공업인민위원부는 1939년 1월 여러 업종별 인민위원부로 쪼개지며 없어졌다.",
    "en": "The People's Commissariat of Heavy Industry, heir to the VSNKh, ceased to exist in January 1939 when it was broken up into several branch commissariats."
   }
  },
  {
   "id": "defence-industry",
   "title": {
    "ko": "국방공업인민위원",
    "en": "People's Commissar of Defence Industry"
   },
   "blurb": {
    "ko": "1936년 12월 중공업인민위원부에서 떨어져 나와 1939년 1월 항공·조선·탄약·무기 인민위원부로 나뉘었다.",
    "en": "Split off from the heavy-industry commissariat in December 1936 and divided in January 1939 into the commissariats of aviation, shipbuilding, ammunition and armament."
   }
  },
  {
   "id": "vpk",
   "title": {
    "ko": "군수공업위원회 의장",
    "en": "Chairman of the Military-Industrial Commission (VPK)"
   },
   "blurb": {
    "ko": "1957년 12월 각료회의 간부회 산하에 세워져 1985년 각료회의 국가위원회, 1991년 내각 국가군수공업위원회가 됐다. 의장은 각료회의 부의장을 겸했다.",
    "en": "Set up under the Presidium of the Council of Ministers in December 1957, it became a State Commission of the Council of Ministers in 1985 and the State Military-Industrial Commission of the Cabinet of Ministers in 1991; its chairman was also a deputy chairman of the government."
   }
  }
 ],
