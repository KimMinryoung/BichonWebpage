{
 "officeId": "economic-management",
 "title": {
  "ko": "경제 운영",
  "en": "Economic management"
 },
 "blurb": {
  "ko": "러시아 공화국과 소련의 재무인민위원·재무장관, 국가은행 이사회 의장, 대외무역인민위원·대외무역장관.",
  "en": "People's Commissars and Ministers of Finance of the RSFSR and the USSR, chairmen of the State Bank, and People's Commissars and Ministers of Foreign Trade."
 },
 "range": "1917–1991",
 "tracks": [
  {
   "id": "finance",
   "title": {
    "ko": "재무인민위원·재무장관",
    "en": "People's Commissar / Minister of Finance"
   },
   "blurb": {
    "ko": "1923년 7월까지는 러시아 공화국 재무인민위원, 그 뒤로는 소련 재무인민위원과 1946년 3월부터의 재무장관이다.",
    "en": "People's Commissars of Finance of the RSFSR until July 1923, then of the USSR, and Ministers of Finance from March 1946."
   }
  },
  {
   "id": "gosbank",
   "title": {
    "ko": "국가은행 이사회 의장",
    "en": "Chairman of the State Bank"
   },
   "blurb": {
    "ko": "1921년 10월 러시아 공화국 국가은행으로 출범해 1923년 소련 국가은행(고스방크)이 된 중앙은행의 이사회 의장.",
    "en": "Chairmen of the Board of the central bank, founded as the State Bank of the RSFSR in October 1921 and turned into the State Bank of the USSR (Gosbank) in 1923."
   }
  },
  {
   "id": "foreign-trade",
   "title": {
    "ko": "대외무역인민위원·대외무역장관",
    "en": "People's Commissar / Minister of Foreign Trade"
   },
   "blurb": {
    "ko": "1925년 11월부터 1930년 11월까지와 1953년 3~8월에는 대외무역이 국내무역과 한 부처로 묶였고, 1988년 1월 대외무역부는 대외경제관계부로 통합됐다.",
    "en": "Foreign trade shared a single commissariat or ministry with domestic trade from November 1925 to November 1930 and from March to August 1953; in January 1988 the Ministry of Foreign Trade was merged into the Ministry of Foreign Economic Relations."
   }
  }
 ],
