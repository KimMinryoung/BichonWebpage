{
 "officeId": "central-planning",
 "title": {
  "ko": "중앙계획 기관",
  "en": "Central planning agencies"
 },
 "blurb": {
  "ko": "러시아 공화국과 소련의 고스플란 의장, 1955~1957년 분리된 국가경제위원회 의장, 1991년 고스플란을 이은 경제·예측장관.",
  "en": "The chairmen of Gosplan of the RSFSR and the USSR, the chairmen of the separate State Economic Commission of 1955–1957, and the 1991 Minister of Economics and Forecasting who succeeded Gosplan."
 },
 "range": "1921–1991",
 "tracks": [
  {
   "id": "gosplan-chairman",
   "title": {
    "ko": "고스플란 의장",
    "en": "Chairman of Gosplan"
   },
   "blurb": {
    "ko": "1921년 노동국방회의 산하 국가총계획위원회로 출발해 1923년 연방 기관이 되었고, 1948년 위원회(Committee)로 격상되었다. 1955~1957년에는 장기계획만 맡은 국가장기계획위원회가 고스플란이라는 이름을 이었다. 1991년 4월 경제·예측부로 개편되었고 5월 셰르바코프가 임명될 때까지 장관은 공석이었다.",
    "en": "Began in 1921 as the State General Planning Commission under the RSFSR Council of Labour and Defence, became a union body in 1923 and a state committee in 1948. In 1955–1957 the long-term planning commission kept the Gosplan name. In April 1991 it became the Ministry of Economics and Forecasting, whose minister was appointed only in May."
   }
  },
  {
   "id": "gosekonomkomissiya",
   "title": {
    "ko": "국가경제위원회 의장 (1955~1957)",
    "en": "Chairman of the State Economic Commission (1955–1957)"
   },
   "blurb": {
    "ko": "1955년 5월 국가계획위원회를 둘로 나누면서 생긴 당면(연간) 계획 기관. 1957년 5월 폐지되었다.",
    "en": "The current (annual) planning body created when the State Planning Committee was split in May 1955; abolished in May 1957."
   }
  }
 ],
