#!/usr/bin/env bash
# dev-preview - Run a bind-mounted frontend preview on the Tailscale interface.
#
# Usage:
#   scripts/dev-preview [start|stop|restart|status|logs]
#
# The preview is off by default: start it for a development session and stop
# it afterwards (it polls the DB like production and holds ~350 MB). It does
# not come back after a reboot, and stops by itself DEV_PREVIEW_TTL after
# start (default 4h; 0 keeps it running until `stop`).
#
# Defaults:
#   DEV_PORT=3001
#   DEV_PREVIEW_TTL=4h
#   DEV_TAILSCALE_IFACE=tailscale0
#   DEV_CONTAINER_NAME=leninbot-frontend-dev

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
FRONTEND_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
CONTAINER_NAME="${DEV_CONTAINER_NAME:-leninbot-frontend-dev}"
IMAGE_NAME="${DEV_IMAGE_NAME:-leninbot-frontend}"
NETWORK="${DEV_DOCKER_NETWORK:-leninbot_default}"
IPV6_NETWORK="${DEV_DOCKER_IPV6_NETWORK:-leninbot_ipv6}"
TAILSCALE_IFACE="${DEV_TAILSCALE_IFACE:-tailscale0}"
TAILSCALE_IP="${DEV_TAILSCALE_IP:-}"
DEV_PORT="${DEV_PORT:-3001}"
TTL="${DEV_PREVIEW_TTL:-4h}"

log() { printf '[dev-preview] %s\n' "$*"; }
err() { printf '[dev-preview] %s\n' "$*" >&2; }

detect_tailscale_ip() {
    ip -o -4 addr show "$TAILSCALE_IFACE" | awk '{ split($4, a, "/"); print a[1]; exit }'
}

ensure_tailscale_ip() {
    if [[ -z "$TAILSCALE_IP" ]]; then
        TAILSCALE_IP="$(detect_tailscale_ip)"
    fi
    if [[ -z "$TAILSCALE_IP" ]]; then
        err "Could not detect an IPv4 address on ${TAILSCALE_IFACE}."
        err "Set DEV_TAILSCALE_IP explicitly and retry."
        exit 1
    fi
}

stop_container() {
    docker stop "$CONTAINER_NAME" >/dev/null 2>&1 || true
    docker rm "$CONTAINER_NAME" >/dev/null 2>&1 || true
}

start_container() {
    ensure_tailscale_ip

    if ! docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        log "Image ${IMAGE_NAME} not found; building it once."
        docker build -t "$IMAGE_NAME" "$FRONTEND_DIR"
    fi

    stop_container

    # The image holds dependencies only, so the working tree is the code. The
    # empty tmpfs hides the host's node_modules (installed by the host's node)
    # and lets Node fall through to the image's /node_modules.
    log "Starting ${CONTAINER_NAME} at http://${TAILSCALE_IP}:${DEV_PORT}"
    docker run -d \
        --name "$CONTAINER_NAME" \
        --user "$(stat -c '%u:%g' "$FRONTEND_DIR/data")" \
        --add-host=host.docker.internal:host-gateway \
        -p "${TAILSCALE_IP}:${DEV_PORT}:3000" \
        --env-file "$FRONTEND_DIR/.env" \
        -e NODE_ENV=development \
        -e DEV_MODE=1 \
        -e PORT=3000 \
        -e ASSET_VERSION=dev \
        -e REPORT_RENDER_CACHE_PATH=/app/data/cache/report-renders.dev.json \
        -e COMMULINGO_DRILLS_CACHE_PATH=/app/data/cache/drills.dev.json \
        -v "$FRONTEND_DIR:/app" \
        --mount type=tmpfs,destination=/app/node_modules \
        "$IMAGE_NAME" \
        node --watch server.js

    docker network connect "$NETWORK" "$CONTAINER_NAME" >/dev/null 2>&1 || true
    if docker network inspect "$IPV6_NETWORK" >/dev/null 2>&1; then
        docker network connect "$IPV6_NETWORK" "$CONTAINER_NAME" >/dev/null 2>&1 || true
    fi

    schedule_stop
}

# Stop this container (by id, so a later restart is left alone) after TTL.
schedule_stop() {
    [[ "$TTL" == "0" ]] && return
    local id
    id="$(docker inspect -f '{{.Id}}' "$CONTAINER_NAME")"
    setsid nohup bash -c "sleep '$TTL'; docker stop '$id' >/dev/null 2>&1; docker rm '$id' >/dev/null 2>&1" \
        >/dev/null 2>&1 < /dev/null &
    log "Stops automatically in ${TTL} (DEV_PREVIEW_TTL=0 to keep it; scripts/dev-preview stop when done)."
}

case "${1:-start}" in
    start)
        start_container
        ;;
    restart)
        start_container
        ;;
    stop)
        stop_container
        ;;
    status)
        if docker ps -q --filter "name=^/${CONTAINER_NAME}$" | grep -q .; then
            docker ps --filter "name=^/${CONTAINER_NAME}$"
        else
            log "stopped (scripts/dev-preview start to run it)"
        fi
        ;;
    logs)
        docker logs -f "$CONTAINER_NAME"
        ;;
    *)
        err "Usage: scripts/dev-preview [start|stop|restart|status|logs]"
        exit 2
        ;;
esac
