#!/usr/bin/env node
// mcp-token — make a CommuLingo admin MCP client token.
//
// Usage: scripts/mcp-token <client> <scope,scope> [--force]
//   Writes the token to ~/.config/commulingo-mcp/<client>.token (0600) and
//   prints the COMMULINGO_MCP_CLIENTS entry (hash only) to add to .env.
//   Scopes: read, edit, ops (dev_docs/commulingo-admin-mcp.md).
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const { randomBytes } = require('node:crypto');
const { parseClients, hashToken } = require('../mcp/auth');

const [name, scopes, flag] = process.argv.slice(2);
if (!name || !scopes || (flag && flag !== '--force')) {
    console.error('Usage: scripts/mcp-token <client> <scope,scope> [--force]');
    process.exit(2);
}
const token = randomBytes(32).toString('base64url');
const entry = `${name}:${scopes}:${hashToken(token).toString('hex')}`;
parseClients(entry); // rejects a bad name or scope before anything is written
const dir = path.join(os.homedir(), '.config', 'commulingo-mcp');
const file = path.join(dir, `${name}.token`);
if (fs.existsSync(file) && flag !== '--force') {
    console.error(`${file} exists; pass --force to replace it`);
    process.exit(1);
}
fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
fs.writeFileSync(file, `${token}\n`, { mode: 0o600 });
fs.chmodSync(file, 0o600);
console.error(`token written to ${file}`);
console.log(entry);
