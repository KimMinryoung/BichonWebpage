#!/usr/bin/env bash
# deploy — Frontend deploy script
#
# Usage:
#   deploy [--restart] [--restart-chat]
#       Pull latest code, extract it as a read-only code release, and replace
#       the container. The image holds only Node and dependencies and is
#       rebuilt only when Dockerfile/package*.json change. Skips when nothing
#       the app reads changed (docs, host scripts) unless --restart is passed.
#       A CSS-only change is faster with scripts/deploy-assets publish.
#       The chat gateway container (chat-gateway.js) is replaced only when a
#       file it loads changed (scripts/lib/chat-gateway-paths.js), it is not
#       running, or --restart-chat is passed; it drains streaming answers first.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
FRONTEND_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
# A clean release worktree can reuse the enduring production data mount.
FRONTEND_DATA_DIR="${FRONTEND_DATA_DIR:-$FRONTEND_DIR/data}"
if [[ "$FRONTEND_DATA_DIR" != /* || ! -d "$FRONTEND_DATA_DIR" ]]; then
    echo "FRONTEND_DATA_DIR must be an existing absolute directory" >&2
    exit 2
fi
CONTAINER_NAME="leninbot-frontend"
# The new image is first started, checked and warmed as a standby on
# STANDBY_PORT, which nginx lists as the backup upstream; it answers while the
# primary container on port 3000 is replaced, so a deploy has no 502 window
# and the deploy's own checks never compete with visitors on the primary.
STANDBY_NAME="leninbot-frontend-standby"
STANDBY_PORT=3002
MCP_PORT=3100
# The chat/writer/A2A streams run in their own container so an app deploy
# never cuts an answer; nginx falls back to the app while it restarts.
GATEWAY_NAME="leninbot-frontend-chat"
GATEWAY_PORT=3003
# chat-gateway.js lets answers in progress finish for up to this long.
GATEWAY_DRAIN_S=300
NGINX_SITE="/etc/nginx/sites-available/leninbot-frontend"
IMAGE_NAME="leninbot-frontend"
NETWORK="leninbot_default"
REVISION_LABEL="com.cyber-lenin.frontend.git-revision"
# Run as the owner of the data mount, not whoever invoked this script: a root
# invocation must not produce a root container writing root-owned data files.
RUN_AS_UID_GID="$(stat -c '%u:%g' "$FRONTEND_DATA_DIR")"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log()  { echo -e "${GREEN}[deploy]${NC} $*"; }
warn() { echo -e "${YELLOW}[deploy]${NC} $*"; }
err()  { echo -e "${RED}[deploy]${NC} $*" >&2; }
warm() {
    local path="$1" port="${2:-3000}"
    if curl -fsS --max-time 20 "http://localhost:${port}${path}" > /dev/null 2>&1; then
        log "Warmed ${path}"
    else
        warn "Warm-up failed for ${path}"
    fi
}
commulingo_version() {
    curl -fsS --max-time 10 "http://localhost:3000/commulingo/catalog.json" 2>/dev/null \
        | node -e "let s=''; process.stdin.on('data', d => s += d); process.stdin.on('end', () => { try { process.stdout.write(JSON.parse(s).version || ''); } catch (err) {} });" \
        || true
}

FORCE_RESTART=0
FORCE_CHAT=0
for arg in "$@"; do
    case "$arg" in
        --restart|-r) FORCE_RESTART=1 ;;
        --restart-chat) FORCE_CHAT=1 ;;
        --help|-h)
            echo "Usage: deploy [--restart] [--restart-chat]"
            echo "  --restart, -r    Rebuild and restart even when no new commits."
            echo "  --restart-chat   Also replace the chat gateway (drains answers in progress)."
            exit 0
            ;;
        *)
            err "Unknown option: $arg"
            exit 2
            ;;
    esac
done

cd "$FRONTEND_DIR"
export CSS_RELEASE_HOST_DIR="${CSS_RELEASE_HOST_DIR:-$(dirname "$FRONTEND_DATA_DIR")/.css-releases}"
[[ "$CSS_RELEASE_HOST_DIR" == /* ]] || { echo "CSS_RELEASE_HOST_DIR must be absolute" >&2; exit 2; }
mkdir -p "$CSS_RELEASE_HOST_DIR"
# One read-only directory per deployed commit, mounted at /app.
APP_RELEASE_HOST_DIR="${APP_RELEASE_HOST_DIR:-$(dirname "$FRONTEND_DATA_DIR")/.app-releases}"
[[ "$APP_RELEASE_HOST_DIR" == /* ]] || { echo "APP_RELEASE_HOST_DIR must be absolute" >&2; exit 2; }
mkdir -p "$APP_RELEASE_HOST_DIR"
exec 9>"$CSS_RELEASE_HOST_DIR/deploy.lock"
flock -n 9 || { err "Another app/CSS deployment is running."; exit 1; }

# Shared by the app and chat gateway steps; defined before any early exit.
# Runtime image (dependencies only), tagged by the files that define it
# (hashed after the pull, so a dependency change in it counts).
ensure_runtime_image() {
    DEPS_HASH="$(cat Dockerfile .dockerignore package.json package-lock.json | sha256sum | cut -c1-16)"
    RUNTIME_IMAGE="$IMAGE_NAME:deps-$DEPS_HASH"
    if docker image inspect "$RUNTIME_IMAGE" > /dev/null 2>&1; then
        log "Dependencies unchanged; reusing image $RUNTIME_IMAGE."
    else
        log "Building runtime image $RUNTIME_IMAGE (Dockerfile or dependencies changed)..."
        docker build -t "$RUNTIME_IMAGE" .
    fi
    # scripts/dev-preview runs the untagged name.
    docker tag "$RUNTIME_IMAGE" "$IMAGE_NAME"
}
# Code release: the committed tree minus host-only directories and data/
# (mounted). Extracted once per commit, then reused by restarts.
ensure_code_release() {
    APP_DIR="$APP_RELEASE_HOST_DIR/$LOCAL"
    if [[ -d "$APP_DIR" ]]; then
        log "Reusing code release $APP_DIR."
        touch "$APP_DIR"
        return 0
    fi
    log "Extracting code release $LOCAL..."
    local excludes=(':(exclude)data') dir stage
    for dir in $(node -p "require('./scripts/lib/runtime-paths').RELEASE_EXCLUDES.join(' ')"); do
        excludes+=(":(exclude)$dir")
    done
    stage="$(mktemp -d "$APP_RELEASE_HOST_DIR/.staging-XXXXXX")"
    chmod 755 "$stage"
    if ! git archive "$LOCAL" -- . "${excludes[@]}" | tar -x -C "$stage"; then
        rm -rf "$stage"
        err "Could not extract code release $LOCAL."
        exit 1
    fi
    # Mount points inside the read-only /app.
    mkdir "$stage/data" "$stage/css-releases"
    mv "$stage" "$APP_DIR"
}
# /ready answers 200 only when the container reaches Postgres; /health would
# pass a process that renders empty lists. Redis is not required (the site
# then runs anonymous-only with a sign-in outage notice) but is reported.
wait_ready() {
    local port="$1" elapsed=0 body=""
    while (( elapsed < 45 )); do
        if body="$(curl -sf --max-time 5 "http://localhost:${port}/ready" 2>/dev/null)"; then
            # Postgres answers first; the Redis client connects a moment after
            # boot, so give it a few seconds before calling it an outage.
            local redis_wait=0
            while [[ "$body" == *'"redis":false'* ]] && (( redis_wait < 10 )); do
                sleep 1
                redis_wait=$((redis_wait + 1))
                body="$(curl -s --max-time 5 "http://localhost:${port}/ready" 2>/dev/null || true)"
            done
            if [[ "$body" == *'"redis":false'* ]]; then
                warn "Port ${port}: Redis unreachable — sign-in is down, public pages are served anonymously."
            fi
            return 0
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
    body="$(curl -s --max-time 5 "http://localhost:${port}/ready" 2>/dev/null || true)"
    err "Readiness on port ${port} never passed: ${body:-no response}"
    return 1
}

# Chat gateway: why it must be replaced now, or nothing when it may keep
# running its revision (no file it loads changed since).
chat_gateway_reason() {
    local deployed changed
    if [[ "$(docker inspect -f '{{.State.Running}}' "$GATEWAY_NAME" 2>/dev/null)" != "true" ]]; then
        echo "not running"; return
    fi
    (( FORCE_CHAT )) && { echo "--restart-chat"; return; }
    deployed="$(docker inspect -f "{{ index .Config.Labels \"$REVISION_LABEL\" }}" "$GATEWAY_NAME" 2>/dev/null || true)"
    [[ "$deployed" == "$LOCAL" ]] && return
    # An unknown deployed revision (diff fails) counts as a change.
    changed="$(node scripts/lib/chat-gateway-paths.js "$deployed" "$LOCAL" 2>/dev/null || echo '?')"
    [[ -n "$changed" ]] && echo "changed: $(tr '\n' ' ' <<< "$changed")"
    return 0
}
# Returns non-zero when the new gateway does not come up; chat then keeps
# working through the app (nginx backup), so callers report rather than abort.
deploy_chat_gateway() {
    local reason code
    reason="$(chat_gateway_reason)"
    if [[ -z "$reason" ]]; then
        log "Chat gateway unchanged; it keeps running (no file it loads changed)."
        return 0
    fi
    log "Replacing the chat gateway ($reason)."
    ensure_runtime_image
    ensure_code_release
    if docker inspect "$GATEWAY_NAME" > /dev/null 2>&1; then
        # It stops accepting at once (nginx sends new requests to the app) and
        # exits when the answers it is streaming end, or after the drain time.
        log "Draining the chat gateway (answers in progress may take up to ${GATEWAY_DRAIN_S} s)..."
        docker stop -t $((GATEWAY_DRAIN_S + 15)) "$GATEWAY_NAME" > /dev/null 2>&1 || true
        docker rm "$GATEWAY_NAME" > /dev/null 2>&1 || true
    fi
    docker run -d \
        --name "$GATEWAY_NAME" \
        --user "$RUN_AS_UID_GID" \
        --label "$REVISION_LABEL=$LOCAL" \
        --add-host=host.docker.internal:host-gateway \
        -p "127.0.0.1:${GATEWAY_PORT}:3000" \
        -e "GIT_SHA=$LOCAL" \
        -e "CHAT_GATEWAY_DRAIN_MS=$((GATEWAY_DRAIN_S * 1000))" \
        --stop-timeout $((GATEWAY_DRAIN_S + 15)) \
        --restart unless-stopped \
        --env-file "$FRONTEND_DIR/.env" \
        -v "$APP_DIR:/app:ro" \
        "$RUNTIME_IMAGE" node chat-gateway.js > /dev/null || { err "Chat gateway could not start."; return 1; }
    docker network connect "$NETWORK" "$GATEWAY_NAME" \
        || { err "Could not connect $GATEWAY_NAME to the $NETWORK network."; return 1; }
    wait_ready "$GATEWAY_PORT" || return 1
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "http://localhost:${GATEWAY_PORT}/api/proxy/sessions")"
    [[ "$code" == "200" ]] || { err "Chat gateway /api/proxy/sessions -> ${code}"; return 1; }
    log "Chat gateway is ready on port ${GATEWAY_PORT}."
}
gateway_failed() {
    err "Chat gateway failed; chat is served by the app (nginx backup). Logs: docker logs $GATEWAY_NAME"
}
# Used by the early exits, where the app itself needs no deploy.
finish_with_chat_gateway() {
    deploy_chat_gateway || { gateway_failed; exit 1; }
    exit 0
}

# 1. Check source and deployed revisions
git fetch origin
LOCAL=$(git rev-parse HEAD)
REMOTE=$(git rev-parse origin/master)

if [[ "$LOCAL" != "$REMOTE" ]]; then
    log "Changes detected: $LOCAL -> $REMOTE"
    git log "$LOCAL..$REMOTE" --oneline
    git pull origin master
    LOCAL=$(git rev-parse HEAD)
else
    log "Local source is up-to-date with origin/master ($LOCAL)."
fi

# The release is `git archive` of the commit, so untracked files never ship:
# only uncommitted changes to tracked files block a deploy.
if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
    err "Working tree has uncommitted changes; refusing to deploy a dirty tree."
    err "Commit and push the changes first, then run deploy again."
    git status --short --untracked-files=no >&2
    exit 1
fi
UNTRACKED="$(git status --porcelain --untracked-files=normal | grep '^??' || true)"
[[ -z "$UNTRACKED" ]] || log "Untracked files are not part of the release: $(wc -l <<<"$UNTRACKED") path(s)."

DEPLOYED=$(docker inspect -f "{{ index .Config.Labels \"$REVISION_LABEL\" }}" "$CONTAINER_NAME" 2>/dev/null || true)
OLD_COMMULINGO_VERSION=""
if [[ -n "$DEPLOYED" ]]; then
    OLD_COMMULINGO_VERSION="$(commulingo_version)"
fi

if [[ "$FORCE_RESTART" -eq 0 && "$LOCAL" == "$DEPLOYED" ]]; then
    log "Already deployed ($LOCAL). Use --restart to force."
    finish_with_chat_gateway
fi

if [[ "$FORCE_RESTART" -eq 0 && -n "$DEPLOYED" ]]; then
    # An unknown deployed revision (diff fails) counts as a runtime change.
    RUNTIME_CHANGES="$(node scripts/lib/runtime-paths.js "$DEPLOYED" "$LOCAL" 2>/dev/null || echo '?')"
    if [[ -z "$RUNTIME_CHANGES" ]]; then
        log "Only host-side files (docs, host scripts) changed since $DEPLOYED; the running app is unaffected."
        log "Nothing to deploy. Use --restart to deploy $LOCAL anyway."
        finish_with_chat_gateway
    fi
    if ! grep -qvE '^public/css/.+\.css$' <<< "$RUNTIME_CHANGES"; then
        warn "Only CSS changed: scripts/deploy-assets publish would skip the restart. Deploying fully."
    fi
fi

if [[ -z "$DEPLOYED" ]]; then
    warn "No deployed revision label found; rebuilding ${LOCAL}."
elif [[ "$LOCAL" != "$DEPLOYED" ]]; then
    log "Deploying newer local revision: $DEPLOYED -> $LOCAL"
else
    log "Revision $LOCAL is already deployed, but --restart requested."
fi

# 2. Host-side tests: every EJS view compiles, SEO head, error page, policy
#    smoke tests (~2 s, no DB). A failure here stops the deploy before build.
log "Running npm test..."
if ! npm test --silent; then
    err "npm test failed; not deploying."
    exit 1
fi

# Prepare compatible CSS before standby starts. Each app has an independent
# pointer: a failed app deploy does not change the old app's CSS selection.
node scripts/css-release-cli.js prepare "$LOCAL"

# 3. Runtime image and code release.
ensure_runtime_image
ensure_code_release

# 4. Start the new image as a standby and check it before it serves anyone.
run_container() {
    local name="$1" port="$2" restart="$3"
    # Only the primary publishes the internal CommuLingo admin MCP listener
    # (dev_docs/commulingo-admin-mcp.md); the standby has no MCP port, so MCP
    # calls fail for the few seconds the primary is being replaced.
    # The CommuLingo pipeline scheduler likewise runs on the primary alone.
    local mcp_publish=() pipeline_env=()
    [[ "$name" == "$CONTAINER_NAME" ]] && mcp_publish=(-p "127.0.0.1:${MCP_PORT}:${MCP_PORT}") && pipeline_env=(-e COMMULINGO_PIPELINE_TICK=1)
    docker run -d \
        --name "$name" \
        --user "$RUN_AS_UID_GID" \
        --label "$REVISION_LABEL=$LOCAL" \
        --add-host=host.docker.internal:host-gateway \
        -p "127.0.0.1:${port}:3000" \
        "${mcp_publish[@]}" \
        "${pipeline_env[@]}" \
        -e "MCP_PORT=${MCP_PORT}" \
        -e "GIT_SHA=$LOCAL" \
        -e CSS_RELEASE_DIR=/app/css-releases \
        --restart "$restart" \
        --env-file "$FRONTEND_DIR/.env" \
        -v "$APP_DIR:/app:ro" \
        -v "$FRONTEND_DATA_DIR:/app/data" \
        -v "$CSS_RELEASE_HOST_DIR:/app/css-releases:ro" \
        "$RUNTIME_IMAGE" > /dev/null || return 1
    # Connect to the leninbot network for Redis and Postgres (leninbot-pg)
    # access. Without it the container is alive but useless, so say so here
    # instead of letting the readiness wait time out.
    if ! docker network connect "$NETWORK" "$name"; then
        err "Could not connect $name to the $NETWORK network (Postgres/Redis unreachable)."
        return 1
    fi
}
remove_standby() {
    docker stop "$STANDBY_NAME" > /dev/null 2>&1 || true
    docker rm "$STANDBY_NAME" > /dev/null 2>&1 || true
}
# Any failure from here until the swap leaves the running version untouched.
fail_standby() {
    err "$*"
    err "The previous version keeps serving. Standby logs: docker logs $STANDBY_NAME"
    docker stop "$STANDBY_NAME" > /dev/null 2>&1 || true
    exit 1
}

if ! grep -q "127.0.0.1:${STANDBY_PORT} backup" "$NGINX_SITE" 2>/dev/null; then
    warn "nginx has no backup upstream on ${STANDBY_PORT}: requests fail while the primary restarts."
    warn "Install nginx/leninbot-frontend.conf (see dev_docs/frontend-operations.md)."
fi

swap_started=0
cleanup_deploy() {
    local code=$?
    if (( code != 0 )); then
        if (( swap_started == 0 )); then remove_standby;
        else err "Deployment interrupted during/after primary swap; standby retained. Recover with scripts/deploy --restart."; fi
    fi
}
trap cleanup_deploy EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
remove_standby
log "Starting standby on port ${STANDBY_PORT}..."
run_container "$STANDBY_NAME" "$STANDBY_PORT" no || fail_standby "Standby container could not start."
wait_ready "$STANDBY_PORT" || fail_standby "Standby readiness check failed."
log "Standby is ready."

# 5. Route sweep and data checks on the standby. A failure stops the deploy
#    before the primary is touched.
SWEEP_PATHS=(
    / /posts /reports /hub /ai-diary /chat
    /commulingo /commulingo/people /commulingo/people/stalin /commulingo/terms
    /commulingo/terms/nep /commulingo/events /commulingo/map /commulingo/countries/soviet
    /commulingo/people?citizenship=soviet /commulingo/docs /commulingo/politburo
    /commulingo/catalog.json /commulingo/book/capital-vol1 /commulingo/lesson/capital-v1-ch01-basic
    /commulingo/drill /commulingo/drill/event-scenes /sitemap.xml
)
sweep_failed=0
for path in "${SWEEP_PATHS[@]}"; do
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 30 -H 'Accept-Language: ko' "http://localhost:${STANDBY_PORT}${path}")"
    if [[ "$code" != "200" ]]; then
        err "Sweep: ${path} -> ${code}"
        sweep_failed=1
    fi
done
(( sweep_failed )) && fail_standby "Route sweep failed on the new image."
log "Route sweep: ${#SWEEP_PATHS[@]} paths returned 200."

docker exec "$STANDBY_NAME" node /app/scripts/check-commulingo-code-db-drift.js > /dev/null 2>&1 \
    || fail_standby "check-commulingo-code-db-drift.js failed — a code fallback/seed no longer matches its table."
log "CommuLingo code/DB drift check passed."

docker exec "$STANDBY_NAME" node /app/scripts/audit-person-card-fields.js \
    || fail_standby "Person card data audit failed — inspect life dates, fate and card metadata."

# 6. Swap. The standby answers (nginx backup) from the moment the old primary
#    stops until the new primary listens; then the primary is warmed before
#    the standby goes away.
swap_started=1
log "Replacing the primary container..."
docker stop "$CONTAINER_NAME" > /dev/null 2>&1 || true
docker rm "$CONTAINER_NAME" > /dev/null 2>&1 || true
log "Running container as host user ${RUN_AS_UID_GID}."
if ! run_container "$CONTAINER_NAME" 3000 unless-stopped || ! wait_ready 3000; then
    err "Primary is not ready — the standby keeps serving; check: docker logs $CONTAINER_NAME"
    exit 1
fi
log "Frontend is ready."
primary_up=$SECONDS
for path in / /commulingo /commulingo/events/nazi-soviet-pact /commulingo/people/stalin /commulingo/terms/nep /reports; do
    warm "$path"
done
# nginx marks the primary unavailable for fail_timeout (10 s default) after
# its last refused connection and sends everything to the standby meanwhile.
# Removing the standby inside that window produced 502s (16:09:39-44 on
# 2026-10-02), so wait it out from the moment the primary answers.
while (( SECONDS - primary_up < 12 )); do sleep 1; done
remove_standby
# The app is replaced; a failure after this point needs no standby recovery.
swap_started=0

# 7. Chat gateway, after the new app is up to serve as its nginx backup while
#    it drains. A failure is reported at the end; chat stays up meanwhile.
GATEWAY_OK=1
deploy_chat_gateway || GATEWAY_OK=0
GATEWAY_REV="$(docker inspect -f "{{ index .Config.Labels \"$REVISION_LABEL\" }}" "$GATEWAY_NAME" 2>/dev/null || true)"

# 8. Cleanup: keep the newest five code releases for quick restarts (the
#    running ones always, the gateway's included), and drop runtime images of superseded dependency
#    sets; an image a container still uses (e.g. dev-preview) refuses removal.
rm -rf "$APP_RELEASE_HOST_DIR"/.staging-*
kept=0
while read -r rev; do
    [[ "$rev" =~ ^[0-9a-f]+$ && ${#rev} -eq 40 ]] || continue
    kept=$((kept + 1))
    (( kept <= 5 )) || [[ "$rev" == "$LOCAL" || "$rev" == "$GATEWAY_REV" ]] || rm -rf "${APP_RELEASE_HOST_DIR:?}/$rev"
done < <(ls -1t "$APP_RELEASE_HOST_DIR")
docker images "$IMAGE_NAME" --format '{{.Tag}}' | { command grep '^deps-' || true; } \
    | while read -r tag; do
        [[ "$tag" == "deps-$DEPS_HASH" ]] || docker rmi "$IMAGE_NAME:$tag" > /dev/null 2>&1 || true
    done
docker image prune -f > /dev/null
# Cap BuildKit's cache (it reached 42 GB by 2026-10-03 when every deploy built).
docker builder prune -f --max-used-space 5GB > /dev/null || warn "Build cache prune failed."

if [[ -n "$DEPLOYED" && "$LOCAL" != "$DEPLOYED" ]]; then
    CHANGED_COMMULINGO_LESSONS="$(node scripts/changed-commulingo-lessons.js "$DEPLOYED" "$LOCAL" 2>/dev/null || true)"
    if [[ -n "$CHANGED_COMMULINGO_LESSONS" ]]; then
        log "Purging CommuLingo lesson cache for changed lessons..."
        PURGE_ARGS=(scripts/purge-commulingo.js)
        if [[ -n "$OLD_COMMULINGO_VERSION" ]]; then
            PURGE_ARGS+=(--old-version "$OLD_COMMULINGO_VERSION")
        fi
        if ! printf '%s\n' "$CHANGED_COMMULINGO_LESSONS" | node "${PURGE_ARGS[@]}" --stdin; then
            warn "CommuLingo cache purge failed; deploy will continue."
        fi
    fi
fi

log "Warming public pages..."
warm "/hub"
warm "/sitemap.xml"
warm "/css/site-core.css"
warm "/js/common.js"

if (( ! GATEWAY_OK )); then
    gateway_failed
    exit 1
fi
log "Deploy complete ($(git log --oneline -1))"
