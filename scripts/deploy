#!/usr/bin/env bash
# deploy — Frontend deploy script
#
# Usage:
#   deploy [--restart]
#       Pull latest code, rebuild Docker image, recreate container.
#       Skips if already up-to-date unless --restart is passed.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
FRONTEND_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
CONTAINER_NAME="leninbot-frontend"
IMAGE_NAME="leninbot-frontend"
NETWORK="leninbot_default"
IPV6_NETWORK="leninbot_ipv6"
REVISION_LABEL="com.cyber-lenin.frontend.git-revision"
RUN_AS_UID_GID="$(id -u):$(id -g)"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log()  { echo -e "${GREEN}[deploy]${NC} $*"; }
warn() { echo -e "${YELLOW}[deploy]${NC} $*"; }
err()  { echo -e "${RED}[deploy]${NC} $*" >&2; }
warm() {
    local path="$1"
    if curl -fsS --max-time 20 "http://localhost:3000${path}" > /dev/null 2>&1; then
        log "Warmed ${path}"
    else
        warn "Warm-up failed for ${path}"
    fi
}
commulingo_version() {
    curl -fsS --max-time 10 "http://localhost:3000/commulingo/catalog.json" 2>/dev/null \
        | node -e "let s=''; process.stdin.on('data', d => s += d); process.stdin.on('end', () => { try { process.stdout.write(JSON.parse(s).version || ''); } catch (err) {} });" \
        || true
}

FORCE_RESTART=0
for arg in "$@"; do
    case "$arg" in
        --restart|-r) FORCE_RESTART=1 ;;
        --help|-h)
            echo "Usage: deploy [--restart]"
            echo "  --restart, -r   Rebuild and restart even when no new commits."
            exit 0
            ;;
        *)
            err "Unknown option: $arg"
            exit 2
            ;;
    esac
done

cd "$FRONTEND_DIR"

# 1. Check source and deployed revisions
git fetch origin
LOCAL=$(git rev-parse HEAD)
REMOTE=$(git rev-parse origin/master)

if [[ "$LOCAL" != "$REMOTE" ]]; then
    log "Changes detected: $LOCAL -> $REMOTE"
    git log "$LOCAL..$REMOTE" --oneline
    git pull origin master
    LOCAL=$(git rev-parse HEAD)
else
    log "Local source is up-to-date with origin/master ($LOCAL)."
fi

if [[ -n "$(git status --porcelain)" ]]; then
    err "Working tree has uncommitted changes; refusing to deploy a dirty tree."
    err "Commit and push the changes first, then run deploy again."
    git status --short >&2
    exit 1
fi

DEPLOYED=$(docker inspect -f "{{ index .Config.Labels \"$REVISION_LABEL\" }}" "$CONTAINER_NAME" 2>/dev/null || true)
OLD_COMMULINGO_VERSION=""
if [[ -n "$DEPLOYED" ]]; then
    OLD_COMMULINGO_VERSION="$(commulingo_version)"
fi

if [[ "$FORCE_RESTART" -eq 0 && "$LOCAL" == "$DEPLOYED" ]]; then
    log "Already deployed ($LOCAL). Use --restart to force."
    exit 0
fi

if [[ -z "$DEPLOYED" ]]; then
    warn "No deployed revision label found; rebuilding ${LOCAL}."
elif [[ "$LOCAL" != "$DEPLOYED" ]]; then
    log "Deploying newer local revision: $DEPLOYED -> $LOCAL"
else
    log "Revision $LOCAL is already deployed, but --restart requested."
fi

# 2. Build image
log "Building Docker image..."
docker build \
    --label "$REVISION_LABEL=$LOCAL" \
    -t "$IMAGE_NAME" .

# 3. Recreate container
log "Recreating container..."
docker stop "$CONTAINER_NAME" 2>/dev/null || true
docker rm "$CONTAINER_NAME" 2>/dev/null || true

log "Running container as host user ${RUN_AS_UID_GID}."
docker run -d \
    --name "$CONTAINER_NAME" \
    --user "$RUN_AS_UID_GID" \
    --label "$REVISION_LABEL=$LOCAL" \
    --add-host=host.docker.internal:host-gateway \
    -p 127.0.0.1:3000:3000 \
    --restart unless-stopped \
    --env-file "$FRONTEND_DIR/.env" \
    -v "$FRONTEND_DIR/data:/app/data" \
    "$IMAGE_NAME"

# Connect to leninbot network for Redis access
docker network connect "$NETWORK" "$CONTAINER_NAME" 2>/dev/null || true

# Connect to IPv6-enabled network for Supabase direct DB access.
if ! docker network inspect "$IPV6_NETWORK" > /dev/null 2>&1; then
    docker network create --ipv6 --subnet fd00:dead:beef:2::/64 "$IPV6_NETWORK" > /dev/null
fi
docker network connect "$IPV6_NETWORK" "$CONTAINER_NAME" 2>/dev/null || true

# 4. Cleanup
docker image prune -f > /dev/null

# 5. Health check
log "Waiting for health check..."
elapsed=0
while (( elapsed < 15 )); do
    if curl -sf --max-time 20 http://localhost:3000 > /dev/null 2>&1; then
        log "Frontend is healthy."
        break
    fi
    sleep 2
    elapsed=$((elapsed + 2))
done

if (( elapsed >= 15 )); then
    warn "Health check timed out — check logs with: docker logs $CONTAINER_NAME"
fi

if [[ -n "$DEPLOYED" && "$LOCAL" != "$DEPLOYED" ]]; then
    CHANGED_COMMULINGO_LESSONS="$(node scripts/changed-commulingo-lessons.js "$DEPLOYED" "$LOCAL" 2>/dev/null || true)"
    if [[ -n "$CHANGED_COMMULINGO_LESSONS" ]]; then
        log "Purging CommuLingo lesson cache for changed lessons..."
        PURGE_ARGS=(scripts/purge-commulingo.js)
        if [[ -n "$OLD_COMMULINGO_VERSION" ]]; then
            PURGE_ARGS+=(--old-version "$OLD_COMMULINGO_VERSION")
        fi
        if ! printf '%s\n' "$CHANGED_COMMULINGO_LESSONS" | node "${PURGE_ARGS[@]}" --stdin; then
            warn "CommuLingo cache purge failed; deploy will continue."
        fi
    fi
fi

log "Warming public pages..."
warm "/"
warm "/reports"
warm "/hub"
warm "/sitemap.xml"
warm "/css/style.css"
warm "/js/common.js"

log "Deploy complete ($(git log --oneline -1))"
